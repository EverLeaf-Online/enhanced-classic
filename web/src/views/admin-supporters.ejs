<%- include("partials/header",{title:"Supporters"}) %><main class="adminShell"><aside class="sidebar"><div class="sideLogo">🍃 EverLeaf CMS</div><a class="sideLink" href="/admin"><span class="sideIcon">🏠</span>Overview</a><a class="sideLink" href="/admin/news"><span class="sideIcon">📰</span>News</a><a class="sideLink" href="/admin/announcements"><span class="sideIcon">📣</span>Announcements</a><a class="sideLink" href="/admin/downloads"><span class="sideIcon">⬇</span>Downloads</a><a class="sideLink" href="/admin/pages"><span class="sideIcon">📄</span>Pages</a><a class="sideLink" href="/admin/recoveries"><span class="sideIcon">🔑</span>Recovery</a><a class="sideLink active" href="/admin/supporters"><span class="sideIcon">💲</span>Supporters</a><a class="sideLink" href="/admin/settings-view"><span class="sideIcon">⚙</span>Settings</a><a class="sideLink" href="/admin/audit"><span class="sideIcon">🗒</span>Audit Log</a><form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>"><button class="btn small sideLogout">↩ Logout</button></form></aside><section class="adminMain"><div class="adminTop"><div><div class="pageEyebrow">Community</div><h1 style="margin:0">Supporter Management</h1><div class="muted">Payment visibility and Discord role recovery.</div></div><a class="btn small" href="/admin">Overview</a></div><% if(syncStatus){%><div class="<%=['assigned','linked'].includes(syncStatus)?'notice':'error'%>" style="margin-top:14px">Discord role synchronization: <%=syncStatus%>.</div><%}%><div class="stats"><div class="stat"><div class="statNum">$<%=(summary.confirmedCents/100).toFixed(2)%></div><div>Confirmed Net</div></div><div class="stat"><div class="statNum"><%=summary.paidCount%></div><div>Paid</div></div><div class="stat"><div class="statNum"><%=summary.pendingCount%></div><div>Pending</div></div><div class="stat"><div class="statNum"><%=summary.failedCount%></div><div>Failed</div></div></div><section class="adminCard"><div class="pageEyebrow">Filter</div><h3>Search Records</h3><form method="get" action="/admin/supporters" class="cmsFilters"><div><label>Account or order</label><input name="search" value="<%=filters.search%>" maxlength="80"></div><div><label>Provider</label><select name="provider"><option value="">All</option><option value="stripe" <%=filters.provider==='stripe'?'selected':''%>>Stripe</option><option value="paypal" <%=filters.provider==='paypal'?'selected':''%>>PayPal</option></select></div><div><label>Payment status</label><select name="status"><option value="">All</option><% ['created','pending','paid','failed','canceled','refunded'].forEach(value=>{ %><option value="<%=value%>" <%=filters.status===value?'selected':''%>><%=value%></option><% }) %></select></div><div><label>Discord status</label><select name="roleStatus"><option value="">All</option><% ['not_linked','linked','assigned','failed','not_member'].forEach(value=>{ %><option value="<%=value%>" <%=filters.roleStatus===value?'selected':''%>><%=value%></option><% }) %></select></div><button class="btn primary">Apply Filters</button></form></section><section class="adminCard" style="margin-top:18px"><div class="pageEyebrow">Payments</div><h3>Payment Records (<%=payments.total%>)</h3><div class="tableWrap"><table><thead><tr><th>Account</th><th>Provider</th><th>Status</th><th>Gross</th><th>Refunded</th><th>Net</th><th>Created</th></tr></thead><tbody><% payments.rows.forEach(order=>{ %><tr><td><strong><%=order.game_account_name%></strong><div class="muted"><%=order.id%></div></td><td><%=order.provider%></td><td><%=order.status%></td><td>$<%=(order.amount_cents/100).toFixed(2)%></td><td>$<%=(order.refunded_cents/100).toFixed(2)%></td><td>$<%=((order.amount_cents-order.refunded_cents)/100).toFixed(2)%></td><td><%=order.created_at%></td></tr><% }) %></tbody></table></div><% if(!payments.rows.length){%><p class="muted">No matching payments.</p><%}%><div style="display:flex;justify-content:space-between;margin-top:12px"><% if(payments.page>1){%><a class="btn small" href="?search=<%=encodeURIComponent(filters.search)%>&provider=<%=filters.provider%>&status=<%=filters.status%>&roleStatus=<%=filters.roleStatus%>&page=<%=payments.page-1%>">Previous</a><%}else{%><span></span><%}%><span class="muted">Page <%=payments.page%> of <%=payments.pages%></span><% if(payments.page<payments.pages){%><a class="btn small" href="?search=<%=encodeURIComponent(filters.search)%>&provider=<%=filters.provider%>&status=<%=filters.status%>&roleStatus=<%=filters.roleStatus%>&page=<%=payments.page+1%>">Next</a><%}%></div></section><section class="adminCard" style="margin-top:18px"><div class="pageEyebrow">Profiles</div><h3>Supporter Profiles</h3><div class="tableWrap"><table><thead><tr><th>Account</th><th>Lifetime Net</th><th>Discord Linked</th><th>Role Status</th><th>Action</th></tr></thead><tbody><% supporters.forEach(profile=>{ %><tr><td><strong><%=profile.game_account_name%></strong></td><td>$<%=(profile.lifetime_cents/100).toFixed(2)%></td><td><%=profile.discord_linked?'Yes':'No'%></td><td><%=profile.discord_role_status%></td><td><% if(profile.discord_linked&&((profile.lifetime_cents>0&&profile.discord_role_status!=='assigned')||(profile.lifetime_cents<=0&&profile.discord_role_status!=='linked'))){%><form method="post" action="/admin/supporters/<%=profile.game_account_id%>/sync-discord"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>"><button class="btn small">Retry Role</button></form><%}else{%><span class="muted">No action needed</span><%}%></td></tr><% }) %></tbody></table></div><% if(!supporters.length){%><p class="muted">No matching supporter profiles.</p><%}%></section></section></main><%- include("partials/footer") %>
