<%- include("partials/header",{title:"Supporters"}) %><main class="adminShell">
<aside class="sidebar"><div class="sideLogo">🍃 EverLeaf CMS</div><a class="sideLink" href="/admin">🏠 Dashboard</a><a class="sideLink active" href="/admin/supporters">💲 Supporters</a><form method="post" action="/admin/logout"><button class="btn small sideLogout">↩ Logout</button></form></aside>
<section class="adminMain"><div class="adminTop"><div><h1 style="margin:0">Supporter Management</h1><div class="muted">Read-only payment records and Discord role recovery</div></div><a class="btn small" href="/admin">Back to dashboard</a></div>
<% if(syncStatus){%><div class="<%=['assigned','linked'].includes(syncStatus)?'notice':'error'%>" style="margin-top:14px">Discord role synchronization: <%=syncStatus%>.</div><%}%>
<div class="stats"><div class="stat"><div class="statNum">$<%=(summary.confirmedCents/100).toFixed(2)%></div><div>Confirmed Net</div></div><div class="stat"><div class="statNum"><%=summary.paidCount%></div><div>Paid</div></div><div class="stat"><div class="statNum"><%=summary.pendingCount%></div><div>Pending</div></div><div class="stat"><div class="statNum"><%=summary.failedCount%></div><div>Failed</div></div></div>
<div class="adminCard"><h3>Filters</h3><form method="get" action="/admin/supporters"><label>Account or order</label><input name="search" value="<%=filters.search%>" maxlength="80"><label>Provider</label><select name="provider"><option value="">All</option><option value="stripe" <%=filters.provider==='stripe'?'selected':''%>>Stripe</option><option value="paypal" <%=filters.provider==='paypal'?'selected':''%>>PayPal</option></select><label>Payment status</label><select name="status"><option value="">All</option><% ['created','pending','paid','failed','canceled','refunded'].forEach(value=>{ %><option value="<%=value%>" <%=filters.status===value?'selected':''%>><%=value%></option><% }) %></select><label>Discord status</label><select name="roleStatus"><option value="">All</option><% ['not_linked','linked','assigned','failed','not_member'].forEach(value=>{ %><option value="<%=value%>" <%=filters.roleStatus===value?'selected':''%>><%=value%></option><% }) %></select><button class="btn primary">Apply filters</button></form></div>
<div class="adminCard" style="margin-top:14px"><h3>Payments (<%=payments.total%>)</h3><div style="overflow:auto"><table><thead><tr><th>Account</th><th>Provider</th><th>Status</th><th>Gross</th><th>Refunded</th><th>Net</th><th>Created</th></tr></thead><tbody><% payments.rows.forEach(order=>{ %><tr><td><strong><%=order.game_account_name%></strong><div class="muted"><%=order.id%></div></td><td><%=order.provider%></td><td><%=order.status%></td><td>$<%=(order.amount_cents/100).toFixed(2)%></td><td>$<%=(order.refunded_cents/100).toFixed(2)%></td><td>$<%=((order.amount_cents-order.refunded_cents)/100).toFixed(2)%></td><td><%=order.created_at%></td></tr><% }) %></tbody></table></div><% if(!payments.rows.length){%><p class="muted">No matching payments.</p><%}%><div style="display:flex;justify-content:space-between;margin-top:12px"><% if(payments.page>1){%><a class="btn small" href="?search=<%=encodeURIComponent(filters.search)%>&provider=<%=filters.provider%>&status=<%=filters.status%>&roleStatus=<%=filters.roleStatus%>&page=<%=payments.page-1%>">Previous</a><%}else{%><span></span><%}%><span class="muted">Page <%=payments.page%> of <%=payments.pages%></span><% if(payments.page<payments.pages){%><a class="btn small" href="?search=<%=encodeURIComponent(filters.search)%>&provider=<%=filters.provider%>&status=<%=filters.status%>&roleStatus=<%=filters.roleStatus%>&page=<%=payments.page+1%>">Next</a><%}%></div></div>
<div class="adminCard" style="margin-top:14px"><h3>Supporter Profiles</h3><div style="overflow:auto"><table><thead><tr><th>Account</th><th>Lifetime Net</th><th>Discord Linked</th><th>Role Status</th><th>Action</th></tr></thead><tbody><% supporters.forEach(profile=>{ %><tr><td><strong><%=profile.game_account_name%></strong></td><td>$<%=(profile.lifetime_cents/100).toFixed(2)%></td><td><%=profile.discord_linked?'Yes':'No'%></td><td><%=profile.discord_role_status%></td><td><% if(profile.discord_linked&&((profile.lifetime_cents>0&&profile.discord_role_status!=='assigned')||(profile.lifetime_cents<=0&&profile.discord_role_status!=='linked'))){%><form method="post" action="/admin/supporters/<%=profile.game_account_id%>/sync-discord"><button class="btn small">Retry Role</button></form><%}else{%><span class="muted">No action needed</span><%}%></td></tr><% }) %></tbody></table></div><% if(!supporters.length){%><p class="muted">No matching supporter profiles.</p><%}%></div>
</section></main><%- include("partials/footer") %>
