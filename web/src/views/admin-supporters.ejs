<%- include("partials/header",{title:"Supporters"}) %>
<main class="adminShell">
  <aside class="sidebar">
    <div class="sideLogo">STAFF://CMS<br>EVERLEAF OPERATIONS</div>
    <a class="sideLink" href="/admin"><span class="sideIcon">00</span>Overview</a><a class="sideLink" href="/admin/knowledge"><span class="sideIcon">01</span>Game Database</a><a class="sideLink" href="/admin/news"><span class="sideIcon">02</span>World Log</a><a class="sideLink" href="/admin/announcements"><span class="sideIcon">03</span>Announcements</a><a class="sideLink" href="/admin/downloads"><span class="sideIcon">04</span>Client Files</a><a class="sideLink" href="/admin/pages"><span class="sideIcon">05</span>Site Pages</a><a class="sideLink" href="/admin/recoveries"><span class="sideIcon">06</span>Recovery Queue</a><a class="sideLink active" href="/admin/supporters"><span class="sideIcon">07</span>Supporters</a><a class="sideLink" href="/admin/settings-view"><span class="sideIcon">08</span>Settings</a><a class="sideLink" href="/admin/audit"><span class="sideIcon">09</span>Audit Log</a>
    <form method="post" action="/admin/logout"><button class="btn small sideLogout">END STAFF SESSION</button></form>
  </aside>

  <section class="adminMain">
    <header class="adminTop"><div><div class="pageEyebrow">SUPPORT://PAYMENT OPERATIONS</div><h1>SUPPORTER<br>CONTROL.</h1><div class="muted">Provider-confirmed payments, refunds, and Discord role recovery.</div></div><a class="btn small" href="/admin">OVERVIEW</a></header>
    <% if(syncStatus){ %><div class="<%=['assigned','linked'].includes(syncStatus)?'notice':'error'%>" style="margin-top:14px">DISCORD ROLE SYNC // <%=syncStatus%></div><% } %>

    <section class="stats">
      <div class="stat"><div class="statNum">$<%=(summary.confirmedCents/100).toFixed(2)%></div><div>CONFIRMED NET</div></div><div class="stat"><div class="statNum"><%=summary.paidCount%></div><div>PAID</div></div><div class="stat"><div class="statNum"><%=summary.pendingCount%></div><div>PENDING</div></div><div class="stat"><div class="statNum"><%=summary.failedCount%></div><div>FAILED</div></div>
    </section>

    <section class="adminCard"><div class="pageEyebrow">QUERY://FILTER</div><h3>SEARCH RECORDS.</h3><form method="get" action="/admin/supporters" class="cmsFilters"><div><label>Account or order</label><input name="search" value="<%=filters.search%>" maxlength="80"></div><div><label>Provider</label><select name="provider"><option value="">All</option><option value="stripe" <%=filters.provider==='stripe'?'selected':''%>>Stripe</option><option value="paypal" <%=filters.provider==='paypal'?'selected':''%>>PayPal</option></select></div><div><label>Payment status</label><select name="status"><option value="">All</option><% ['created','pending','paid','failed','canceled','refunded'].forEach(value=>{ %><option value="<%=value%>" <%=filters.status===value?'selected':''%>><%=value%></option><% }) %></select></div><div><label>Discord status</label><select name="roleStatus"><option value="">All</option><% ['not_linked','linked','assigned','failed','not_member'].forEach(value=>{ %><option value="<%=value%>" <%=filters.roleStatus===value?'selected':''%>><%=value%></option><% }) %></select></div><button class="btn primary">EXECUTE FILTER</button></form></section>

    <section class="adminCard"><div class="pageEyebrow">PAYMENTS://LEDGER</div><h3>PAYMENT RECORDS (<%=payments.total%>).</h3><div class="tableWrap"><table><thead><tr><th>ACCOUNT</th><th>PROVIDER</th><th>STATUS</th><th>GROSS</th><th>REFUNDED</th><th>NET</th><th>CREATED</th></tr></thead><tbody><% payments.rows.forEach(order=>{ %><tr><td><strong><%=order.game_account_name%></strong><div class="muted"><%=order.id%></div></td><td><%=order.provider%></td><td><%=order.status%></td><td>$<%=(order.amount_cents/100).toFixed(2)%></td><td>$<%=(order.refunded_cents/100).toFixed(2)%></td><td>$<%=((order.amount_cents-order.refunded_cents)/100).toFixed(2)%></td><td><%=order.created_at%></td></tr><% }) %></tbody></table></div><% if(!payments.rows.length){ %><p class="muted">NO MATCHING PAYMENTS.</p><% } %><div class="pagination"><% if(payments.page>1){ %><a class="pageBtn" href="?search=<%=encodeURIComponent(filters.search)%>&provider=<%=filters.provider%>&status=<%=filters.status%>&roleStatus=<%=filters.roleStatus%>&page=<%=payments.page-1%>">← PREV</a><% } %><span class="muted">PAGE <%=payments.page%>/<%=payments.pages%></span><% if(payments.page<payments.pages){ %><a class="pageBtn" href="?search=<%=encodeURIComponent(filters.search)%>&provider=<%=filters.provider%>&status=<%=filters.status%>&roleStatus=<%=filters.roleStatus%>&page=<%=payments.page+1%>">NEXT →</a><% } %></div></section>

    <section class="adminCard"><div class="pageEyebrow">PROFILES://DISCORD</div><h3>SUPPORTER PROFILES.</h3><div class="tableWrap"><table><thead><tr><th>ACCOUNT</th><th>LIFETIME NET</th><th>DISCORD LINKED</th><th>ROLE STATE</th><th>ACTION</th></tr></thead><tbody><% supporters.forEach(profile=>{ %><tr><td><strong><%=profile.game_account_name%></strong></td><td>$<%=(profile.lifetime_cents/100).toFixed(2)%></td><td><%=profile.discord_linked?'YES':'NO'%></td><td><%=profile.discord_role_status%></td><td><% if(profile.discord_linked&&((profile.lifetime_cents>0&&profile.discord_role_status!=='assigned')||(profile.lifetime_cents<=0&&profile.discord_role_status!=='linked'))){ %><form method="post" action="/admin/supporters/<%=profile.game_account_id%>/sync-discord"><button class="btn small">RETRY ROLE</button></form><% }else{ %><span class="muted">NO ACTION</span><% } %></td></tr><% }) %></tbody></table></div><% if(!supporters.length){ %><p class="muted">NO MATCHING SUPPORTER PROFILES.</p><% } %></section>
  </section>
</main>
<%- include("partials/footer") %>
