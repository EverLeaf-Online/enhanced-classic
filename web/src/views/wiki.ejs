<%- include("partials/header",{title:"Wiki",description:"Search EverLeaf classes, progression, systems, rewards, launcher knowledge, and world guides."}) %>
<main class="lightPage wikiPage"><section class="wikiHero"><div class="wrap wikiHeroInner"><div><div class="pageEyebrow">EVERLEAF WIKI</div><h1>Know Maple World.<br><em>Know EverLeaf.</em></h1><p>A growing game database built from EverLeaf's preserved research library. Search classic v83 foundations, server-specific progression, quality-of-life systems, launcher guidance, rewards, and world knowledge.</p><form class="wikiSearch" action="/wiki" method="get"><input type="search" name="q" value="<%=q%>" placeholder="Search jobs, NX, level 250, Pet Vac, Free Market…" aria-label="Search EverLeaf Wiki"><% if(category&&category!=='all'){ %><input type="hidden" name="category" value="<%=category%>"><% } %><button class="btn primary" type="submit">SEARCH</button></form><div class="wikiHeroMeta"><span><strong><%=entries.length%></strong> verified starter articles</span><span>Library-backed</span><span>EverLeaf differences labeled</span></div></div><div class="wikiHeroArt"><img src="/assets/ui/journal.svg" alt=""><span>EVERLEAF<br>FIELD GUIDE</span></div></div></section>
<div class="wrap wikiLayout"><aside class="wikiSidebar"><div class="wikiSidebarTitle">Browse database</div><a class="wikiCat <%=category==='all'?'active':''%>" href="/wiki<%=q?'?q='+encodeURIComponent(q):''%>"><strong>All Articles</strong><small><%=entries.length%> entries</small></a><% categories.forEach(cat=>{ const count=entries.filter(x=>x.category===cat.key).length; %><a class="wikiCat <%=category===cat.key?'active':''%>" href="/wiki?category=<%=cat.key%><%=q?'&q='+encodeURIComponent(q):''%>"><strong><%=cat.label%></strong><small><%=count%> · <%=cat.description%></small></a><% }) %><div class="wikiSidebarNote"><strong>Coming next</strong><span>Monsters, bosses, NPCs, maps, items, equipment, skills, quests, drops, and shops will plug into this same database.</span></div></aside>
<section class="wikiResults"><div class="wikiResultsHead"><div><div class="pageEyebrow"><%=q?'SEARCH RESULTS':'KNOWLEDGE DATABASE'%></div><h2><%=q?`Results for “${q}”`:(categories.find(c=>c.key===category)?.label||'All EverLeaf Knowledge')%></h2></div><span><%=results.length%> article<%=results.length===1?'':'s'%></span></div>
<% if(results.length){ %><div class="wikiArticleGrid"><% results.forEach(entry=>{ %><a class="wikiArticleCard" href="/wiki/<%=entry.slug%>"><div class="wikiArticleTop"><span class="wikiStatus"><%=entry.status%></span><span class="wikiCategory"><%=categories.find(c=>c.key===entry.category)?.label||entry.category%></span></div><h3><%=entry.title%></h3><p><%=entry.summary%></p><div class="wikiTags"><% (entry.tags||[]).slice(0,4).forEach(tag=>{ %><span><%=tag%></span><% }) %></div><div class="wikiArticleFoot"><small><%=entry.source%></small><strong>OPEN GUIDE →</strong></div></a><% }) %></div><% } else { %><div class="wikiEmpty"><img src="/assets/ui/journal.svg" alt=""><h3>No matching entries yet.</h3><p>Try a broader search. The database is being expanded from the EverleafMS research library in batches.</p><a class="btn" href="/wiki">CLEAR SEARCH</a></div><% } %>
</section></div></main><%- include("partials/footer") %>
