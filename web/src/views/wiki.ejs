<%- include("partials/header",{title:"Wiki",description:"Search the staff-maintained EverLeaf Wiki for classes, progression, systems, rewards, launcher knowledge, and world guides."}) %>
<%
const fmtDate=value=>{
  if(!value)return 'Just now';
  const d=new Date(String(value).includes('T')?value:String(value).replace(' ','T')+'Z');
  return Number.isNaN(d.valueOf())?'Recently':d.toLocaleDateString(undefined,{year:'numeric',month:'short',day:'numeric'});
};
%>
<main class="lightPage wikiPage">
<section class="wikiHero"><div class="wrap wikiHeroInner"><div><div class="pageEyebrow">EVERLEAF WIKI</div><h1>Everything EverLeaf,<br><em>in one living guide.</em></h1><p>A real, staff-maintained knowledge base for EverLeaf. Search server-specific progression, classes, rewards, launcher help, quality-of-life systems, and world information as the server evolves.</p><form class="wikiSearch" action="/wiki" method="get"><input type="search" name="q" value="<%=q%>" placeholder="Search jobs, NX, level 250, Pet Vac, Free Market…" aria-label="Search EverLeaf Wiki"><% if(category&&category!=='all'){ %><input type="hidden" name="category" value="<%=category%>"><% } %><button class="btn primary" type="submit">SEARCH WIKI</button></form><div class="wikiHeroMeta"><span><strong><%=stats.published%></strong> published articles</span><span>CMS-backed</span><span>Updated <%=fmtDate(stats.lastUpdated)%></span></div></div><div class="wikiHeroArt"><img src="/assets/ui/journal.svg" alt=""><span>EVERLEAF<br>FIELD GUIDE</span></div></div></section>
<div class="wrap wikiLayout"><aside class="wikiSidebar"><div class="wikiSidebarTitle">Browse the Wiki</div><a class="wikiCat <%=category==='all'?'active':''%>" href="/wiki<%=q?'?q='+encodeURIComponent(q):''%>"><strong>All Articles</strong><small><%=entries.length%> published guides</small></a><% categories.forEach(cat=>{ const count=entries.filter(x=>x.category===cat.key).length; %><a class="wikiCat <%=category===cat.key?'active':''%>" href="/wiki?category=<%=cat.key%><%=q?'&q='+encodeURIComponent(q):''%>"><strong><%=cat.label%></strong><small><%=count%> · <%=cat.description%></small></a><% }) %><div class="wikiSidebarNote"><strong>Living knowledge base</strong><span>EverLeaf staff can draft, review, update, and publish guides from the site CMS. Player-facing articles no longer require a website code change.</span></div></aside>
<section class="wikiResults"><div class="wikiResultsHead"><div><div class="pageEyebrow"><%=q?'SEARCH RESULTS':'KNOWLEDGE BASE'%></div><h2><%=q?`Results for “${q}”`:(categories.find(c=>c.key===category)?.label||'All EverLeaf Knowledge')%></h2><% if(q){ %><p class="muted wikiSearchHint">Searching article titles, summaries, article text, tags, and source metadata.</p><% } %></div><span><%=results.length%> article<%=results.length===1?'':'s'%></span></div>
<% if(results.length){ %><div class="wikiArticleGrid"><% results.forEach(entry=>{ %><a class="wikiArticleCard" href="/wiki/<%=entry.slug%>"><div class="wikiArticleTop"><span class="wikiStatus"><%=entry.status%></span><span class="wikiCategory"><%=categories.find(c=>c.key===entry.category)?.label||entry.category%></span></div><h3><%=entry.title%></h3><p><%=entry.summary%></p><div class="wikiTags"><% (entry.tags||[]).slice(0,4).forEach(tag=>{ %><span><%=tag%></span><% }) %></div><div class="wikiArticleFoot"><small><span>Updated <%=fmtDate(entry.updatedAt)%></span><span><%=entry.sourceDoc||entry.source%></span></small><strong>OPEN GUIDE →</strong></div></a><% }) %></div><% } else { %><div class="wikiEmpty"><img src="/assets/ui/journal.svg" alt=""><h3>No matching articles.</h3><p>Try a broader search or another category. Staff can add missing EverLeaf knowledge directly from the CMS.</p><a class="btn" href="/wiki">CLEAR SEARCH</a></div><% } %>
</section></div></main><%- include("partials/footer") %>