<%- include("partials/header",{title:"Wiki",description:"Search the staff-maintained EverLeaf player Wiki for classes, progression, rewards, launcher help, quality-of-life systems, and world guides."}) %>
<%
const fmtDate=value=>{
  if(!value)return 'Just now';
  const d=new Date(String(value).includes('T')?value:String(value).replace(' ','T')+'Z');
  return Number.isNaN(d.valueOf())?'Recently':d.toLocaleDateString(undefined,{year:'numeric',month:'short',day:'numeric'});
};
const getGuide=slug=>entries.find(entry=>entry.slug===slug);
const quickGuides=[
  ['getting-started','START HERE','New to EverLeaf?'],
  ['adventurer-jobs','JOBS','Choose your path'],
  ['nx-reward-sources','REWARDS','Earn NX fairly'],
  ['everleaf-launcher','CLIENT HELP','Install & play']
].map(([slug,label,title])=>({entry:getGuide(slug),label,title})).filter(x=>x.entry);
%>
<main class="lightPage wikiPage wikiPlayerGuide">
<section class="wikiHero wikiPlayerHero"><div class="wrap wikiHeroInner"><div><div class="pageEyebrow">EVERLEAF PLAYER WIKI</div><h1>Answers for the server<br><em>you’re actually playing.</em></h1><p>EverLeaf-specific guides for getting started, jobs, progression, NX rewards, travel, launcher help, and custom content. This is the player guide—not a dump of internal development notes.</p><form class="wikiSearch" action="/wiki" method="get"><input type="search" name="q" value="<%=q%>" placeholder="Search jobs, NX, level 250, Pet Vac, Free Market…" aria-label="Search EverLeaf Wiki"><% if(category&&category!=='all'){ %><input type="hidden" name="category" value="<%=category%>"><% } %><button class="btn primary" type="submit">SEARCH WIKI</button></form><div class="wikiHeroMeta"><span><strong><%=stats.published%></strong> player guides</span><span>Staff maintained</span><span>Updated <%=fmtDate(stats.lastUpdated)%></span></div></div><div class="wikiHeroArt wikiFieldBook"><img src="/assets/ui/journal.svg" alt=""><span>EVERLEAF<br>PLAYER GUIDE</span><small>v83 · Enhanced Classic</small></div></div></section>

<% if(!q&&category==='all'&&quickGuides.length){ %><section class="wrap wikiQuickStart" aria-label="Popular EverLeaf guides"><div class="wikiQuickStartHead"><div><div class="pageEyebrow">QUICK START</div><h2>Find what you need fast.</h2></div><span>Player essentials</span></div><div class="wikiQuickGrid"><% quickGuides.forEach((item,index)=>{ %><a href="/wiki/<%=item.entry.slug%>" class="wikiQuickCard"><span class="wikiQuickNumber">0<%=index+1%></span><div><small><%=item.label%></small><strong><%=item.title%></strong><p><%=item.entry.summary%></p></div><b>→</b></a><% }) %></div></section><% } %>

<div class="wrap wikiLayout"><aside class="wikiSidebar"><div class="wikiSidebarTitle">Browse Player Guides</div><a class="wikiCat <%=category==='all'?'active':''%>" href="/wiki<%=q?'?q='+encodeURIComponent(q):''%>"><strong>All Guides</strong><small><%=entries.length%> published player guides</small></a><% categories.forEach(cat=>{ const count=entries.filter(x=>x.category===cat.key).length; %><a class="wikiCat <%=category===cat.key?'active':''%>" href="/wiki?category=<%=cat.key%><%=q?'&q='+encodeURIComponent(q):''%>"><strong><%=cat.label%></strong><small><%=count%> · <%=cat.description%></small></a><% }) %><div class="wikiSidebarNote"><strong>Living player guide</strong><span>EverLeaf staff can update these articles from the site CMS as features change. Planned mechanics are labeled instead of being presented as already live.</span></div></aside>
<section class="wikiResults"><div class="wikiResultsHead"><div><div class="pageEyebrow"><%=q?'SEARCH RESULTS':'PLAYER KNOWLEDGE BASE'%></div><h2><%=q?`Results for “${q}”`:(categories.find(c=>c.key===category)?.label||'All EverLeaf Guides')%></h2><% if(q){ %><p class="muted wikiSearchHint">Searching guide titles, summaries, article text, and tags.</p><% } %></div><span><%=results.length%> guide<%=results.length===1?'':'s'%></span></div>
<% if(results.length){ %><div class="wikiArticleGrid"><% results.forEach(entry=>{ const cat=categories.find(c=>c.key===entry.category); %><a class="wikiArticleCard wikiPlayerCard" href="/wiki/<%=entry.slug%>"><div class="wikiArticleTop"><span class="wikiStatus"><%=entry.status%></span><span class="wikiCategory"><%=cat?.label||entry.category%></span></div><h3><%=entry.title%></h3><p><%=entry.summary%></p><div class="wikiTags"><% (entry.tags||[]).slice(0,4).forEach(tag=>{ %><span><%=tag%></span><% }) %></div><div class="wikiArticleFoot"><small><span>Updated <%=fmtDate(entry.updatedAt)%></span><span>Staff-maintained EverLeaf guide</span></small><strong>READ GUIDE →</strong></div></a><% }) %></div><% } else { %><div class="wikiEmpty"><img src="/assets/ui/journal.svg" alt=""><h3>No matching player guide yet.</h3><p>Try a broader search or another category. Staff can add missing EverLeaf knowledge directly from the CMS.</p><a class="btn" href="/wiki">CLEAR SEARCH</a></div><% } %>
</section></div></main><%- include("partials/footer") %>