<%- include("partials/header",{title:"Wiki",description:"Search EverLeaf's live server-data Wiki for items, monsters, maps, skills, NPCs and quests."}) %>
<%
const fmt=n=>Number(n||0).toLocaleString();
const typeHref=type=>`/wiki/${type}`;
const detailHref=e=>`/wiki/${e.type}/${e.id}`;
const builtTime=status.builtAt?new Date(status.builtAt).toLocaleTimeString(undefined,{hour:'numeric',minute:'2-digit'}):'—';
const mapleAsset=(type,id)=>Number(id||0)>0?`/wiki/art/${encodeURIComponent(type)}/${Number(id)}`:'';
const categoryAsset={items:2000000,monsters:100100,maps:100000000,skills:1001004,npcs:1012000,quests:1000};
const categoryFallback={items:'IT',monsters:'MB',maps:'MP',skills:'SK',npcs:'NP',quests:'QU'};
%>
<main class="lightPage wikiDataPage wikiAppPage">
<section class="wikiDataHero">
  <div class="wrap wikiDataHeroInner">
    <div class="wikiDataHeroCopy">
      <div class="pageEyebrow">EVERLEAF DATA WIKI</div>
      <h1>Everything in Maple World,<br><em>from the server itself.</em></h1>
      <p>Search the actual EverLeaf game data: equipment, consumables, chairs, monsters, maps, skills, NPCs, quests, drop sources, shops and world connections. EverLeaf data stays authoritative; MapleStory.io is used only as a visual asset source.</p>
      <form class="wikiDataSearch" action="/wiki" method="get">
        <select name="type" aria-label="Wiki category">
          <option value="all" <%=activeType==='all'?'selected':''%>>Everything</option>
          <% Object.entries(types).forEach(([key,meta])=>{ %><option value="<%=key%>" <%=activeType===key?'selected':''%>><%=meta.label%></option><% }) %>
        </select>
        <input type="search" name="q" value="<%=q%>" placeholder="Search item name, monster, map, skill, NPC, quest or ID…" aria-label="Search server data">
        <button class="btn primary" type="submit">SEARCH</button>
      </form>
      <div class="wikiDataTrust">
        <span><b class="wikiDataDot <%=status.available?'online':'offline'%>"></b><%=status.available?'Server data loaded':'Server data unavailable'%></span>
        <span>WZ + MySQL</span>
        <span>Catalog refreshed <%=builtTime%></span>
      </div>
    </div>

    <aside class="wikiExplorerPanel" aria-label="Explore EverLeaf Wiki">
      <div class="wikiExplorerHead">
        <div><span class="pageEyebrow">QUICK EXPLORE</span><strong>Jump into the live catalog.</strong></div>
        <span class="wikiExplorerStatus"><b class="wikiDataDot <%=status.available?'online':'offline'%>"></b><%=status.available?'LIVE':'OFFLINE'%></span>
      </div>
      <div class="wikiExplorerGrid">
        <% Object.entries(types).forEach(([key,meta])=>{ const icon=mapleAsset(key,categoryAsset[key]); %>
          <a class="wikiExplorerTile" href="<%=typeHref(key)%>">
            <span class="wikiExplorerIcon wikiMapleAsset" data-fallback="<%=categoryFallback[key]%>"><% if(icon){ %><img src="<%=icon%>" alt="" loading="lazy" decoding="async" data-wiki-art><% } %></span>
            <span><small><%=meta.label%></small><strong><%=fmt(status.counts[key])%></strong></span>
            <b>↗</b>
          </a>
        <% }) %>
      </div>
      <div class="wikiExplorerFoot">
        <span><b><%=fmt(Object.values(status.counts||{}).reduce((sum,n)=>sum+Number(n||0),0))%></b> indexed records</span>
        <a href="/wiki/guides">Staff guides →</a>
      </div>
    </aside>
  </div>
</section>

<% if(!status.available){ %><section class="wrap wikiDataWarning"><strong>Wiki data index is not available on this web host yet.</strong><span><%=status.errors&&status.errors[0]?status.errors[0]:'The server WZ directory could not be read.'%></span><a href="/wiki/guides">Open staff guides →</a></section><% } %>

<% if(!q){ %><section class="wrap wikiCatalogSection"><div class="wikiCatalogHeading"><div><div class="pageEyebrow">BROWSE CATALOG</div><h2>Items, monsters, maps and more.</h2><p>Browse the player-useful EverLeaf catalog. Duplicate and obvious internal/test records are consolidated or hidden automatically.</p></div><a href="/wiki/guides">STAFF GUIDES →</a></div><div class="wikiCatalogGrid"><% Object.entries(types).forEach(([key,meta])=>{ const icon=mapleAsset(key,categoryAsset[key]); %><a class="wikiCatalogCard wikiCatalog-<%=key%>" href="<%=typeHref(key)%>"><span class="wikiCatalogIcon wikiMapleAsset" data-fallback="<%=categoryFallback[key]%>"><% if(icon){ %><img src="<%=icon%>" alt="" loading="lazy" decoding="async" data-wiki-art><% } %></span><div class="wikiCatalogCopy"><small><%=meta.singular.toUpperCase()%> DATABASE</small><h3><%=meta.label%></h3><p><%=meta.description%></p></div><strong><%=fmt(status.counts[key])%><small> indexed</small></strong><b>Browse →</b></a><% }) %></div></section><% } %>

<% if(q){ %><section class="wrap wikiSearchResults"><div class="wikiSearchResultsHead"><div><div class="pageEyebrow">SEARCH RESULTS</div><h2>Results for “<%=q%>”</h2><p><%=activeType==='all'?'Searching the cleaned EverLeaf catalog.':`Filtered to ${types[activeType]?.label||activeType}.`%></p></div><span><%=results.length%> result<%=results.length===1?'':'s'%></span></div><% if(results.length){ %><div class="wikiDataResultGrid"><% results.forEach(entity=>{ const icon=mapleAsset(entity.type,entity.id); %><a class="wikiDataResult" href="<%=detailHref(entity)%>"><span class="wikiDataResultIcon wikiMapleAsset" data-fallback="<%=categoryFallback[entity.type]||'EL'%>"><% if(icon){ %><img src="<%=icon%>" alt="" loading="lazy" decoding="async" data-wiki-art><% } %></span><div><small><%=types[entity.type].singular%> · ID <%=entity.id%></small><strong><%=entity.name%></strong><p><%=entity.description||entity.subtype||types[entity.type].description%></p></div><b>→</b></a><% }) %></div><% } else { %><div class="wikiDataEmpty"><span>?</span><h3>No server-data match found.</h3><p>Try a shorter name, an exact MapleStory ID, or search all categories.</p><a class="btn" href="/wiki">CLEAR SEARCH</a></div><% } %></section><% } %>
</main><%- include("partials/footer") %>