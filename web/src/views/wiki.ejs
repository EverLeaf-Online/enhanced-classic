<%- include("partials/header",{title:"Wiki",description:"Search EverLeaf's live server-data Wiki for items, monsters, maps, skills, NPCs and quests."}) %>
<%
const typeIcon={items:'◆',monsters:'♜',maps:'◇',skills:'✦',npcs:'♟',quests:'☷'};
const fmt=n=>Number(n||0).toLocaleString();
const typeHref=type=>`/wiki/${type}`;
const detailHref=e=>`/wiki/${e.type}/${e.id}`;
const builtTime=status.builtAt?new Date(status.builtAt).toLocaleTimeString(undefined,{hour:'numeric',minute:'2-digit'}):'—';
%>
<main class="lightPage wikiDataPage">
  <section class="wikiDataHero">
    <div class="wikiDataHeroInner">
      <div class="wikiDataHeroCopy">
        <div class="pageEyebrow">EVERLEAF DATA WIKI // QUERY TERMINAL</div>
        <h1>WORLD<br>DATA.</h1>
        <p>Search the actual EverLeaf game data: equipment, consumables, chairs, monsters, maps, skills, NPCs, quests, drop sources, shops, and world connections.</p>
        <form class="wikiDataSearch" action="/wiki" method="get">
          <select name="type" aria-label="Wiki category"><option value="all" <%=activeType==='all'?'selected':''%>>ALL NAMESPACES</option><% Object.entries(types).forEach(([key,meta])=>{ %><option value="<%=key%>" <%=activeType===key?'selected':''%>><%=meta.label.toUpperCase()%></option><% }) %></select>
          <input type="search" name="q" value="<%=q%>" placeholder="Name or MapleStory ID…" aria-label="Search server data">
          <button class="btn primary" type="submit">EXECUTE</button>
        </form>
        <div class="wikiDataTrust"><span><b class="wikiDataDot <%=status.available?'online':'offline'%>"></b><%=status.available?'SERVER DATA LOADED':'SERVER DATA UNAVAILABLE'%></span><span>WZ + MySQL</span><span>REFRESHED <%=builtTime%></span></div>
      </div>
      <aside class="wikiDataHeroPanel">
        <span class="wikiDataHeroRune">EL</span><strong>DATA INDEX</strong><small>ENHANCED CLASSIC V83</small>
        <div><span>ITEMS</span><b><%=fmt(status.counts.items)%></b></div>
        <div><span>MONSTERS</span><b><%=fmt(status.counts.monsters)%></b></div>
        <div><span>MAPS</span><b><%=fmt(status.counts.maps)%></b></div>
      </aside>
    </div>
  </section>

  <% if(!status.available){ %><section class="wrap wikiDataWarning"><strong>SERVER DATA UNAVAILABLE</strong><span><%=status.errors&&status.errors[0]?status.errors[0]:'The server WZ directory could not be read.'%></span><a href="/wiki/guides">OPEN STAFF GUIDES →</a></section><% } %>

  <% if(!q){ %>
    <section class="wikiCatalogSection">
      <div class="wikiCatalogHeading"><div><div class="pageEyebrow">NAMESPACE://INDEX</div><h2>BROWSE THE DATABASE.</h2><p class="muted">Player-useful records only. Obvious internal/test records and duplicate listings are consolidated.</p></div><a class="btn" href="/wiki/guides">STAFF GUIDES</a></div>
      <div class="wikiCatalogGrid">
        <% Object.entries(types).forEach(([key,meta])=>{ %><a class="wikiCatalogCard wikiCatalog-<%=key%>" href="<%=typeHref(key)%>"><span class="wikiCatalogIcon"><%=typeIcon[key]%></span><div><small><%=meta.singular.toUpperCase()%> DATABASE</small><h3><%=meta.label%></h3><p><%=meta.description%></p></div><strong><%=fmt(status.counts[key])%><small> RECORDS</small></strong><b>QUERY →</b></a><% }) %>
      </div>
    </section>
  <% } %>

  <% if(q){ %>
    <section class="wikiSearchResults">
      <div class="wikiSearchResultsHead"><div><div class="pageEyebrow">QUERY://RESULT</div><h2>“<%=q%>”</h2><p><%=activeType==='all'?'Searching all cleaned namespaces.':`Namespace: ${types[activeType]?.label||activeType}.`%></p></div><span><%=results.length%> RESULT<%=results.length===1?'':'S'%></span></div>
      <% if(results.length){ %><div class="wikiDataResultGrid"><% results.forEach(entity=>{ %><a class="wikiDataResult" href="<%=detailHref(entity)%>"><span class="wikiDataResultIcon"><%=typeIcon[entity.type]%></span><div><small><%=types[entity.type].singular.toUpperCase()%> // ID <%=entity.id%></small><strong><%=entity.name%></strong><p><%=entity.description||entity.subtype||types[entity.type].description%></p></div><b>→</b></a><% }) %></div><% } else { %><div class="wikiDataEmpty"><h3>NO MATCH.</h3><p>Try a shorter name, exact MapleStory ID, or query all namespaces.</p><a class="btn" href="/wiki">CLEAR QUERY</a></div><% } %>
    </section>
  <% } %>
</main>
<%- include("partials/footer") %>
