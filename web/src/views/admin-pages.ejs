<%- include("partials/header",{title:"CMS Pages"}) %>
<main class="lightPage">
  <section class="lightTitle"><div class="wrap"><div class="pageEyebrow">CMS://PUBLIC ROUTES</div><h1>SITE PAGES.</h1><p>Create and manage About, Rules, Terms, and custom public information routes.</p></div></section>
  <%- include("partials/admin-manager-nav") %>
  <div class="cmsWorkspace">
    <section class="cmsPanel">
      <div class="cmsManagerTitle"><h2>ROUTE LEDGER</h2><p><%=pages.length%> managed route<%=pages.length===1?'':'s'%>.</p></div>
      <% pages.forEach(page=>{ const publicUrl=['about','rules','terms'].includes(page.slug)?`/${page.slug}`:`/pages/${page.slug}`; %><div class="cmsItem"><div><span class="pageEyebrow"><%=page.published?'PUBLISHED':'DRAFT'%> // <%=publicUrl%></span><strong><%=page.title%></strong><div class="cmsMeta">UPDATED <%=page.updated_at%></div></div><div class="cmsItemActions"><a class="btn small" href="/admin/pages/<%=page.id%>/edit">EDIT</a><a class="btn small" href="<%=publicUrl%>" target="_blank" rel="noopener noreferrer">VIEW</a><% if(!['about','rules','terms'].includes(page.slug)){ %><form method="post" action="/admin/pages/<%=page.id%>/delete" onsubmit="return confirm('Delete this page?')"><button class="btn small">DELETE</button></form><% } %></div></div><% }) %>
      <% if(!pages.length){ %><p class="muted">NO CMS ROUTES.</p><% } %>
    </section>
    <aside class="cmsPanel"><div class="cmsManagerTitle"><h2>CREATE ROUTE</h2><p>Add a new public information page.</p></div><form class="cmsFormSection" method="post" action="/admin/pages"><label>Title</label><input name="title" required><label>Slug</label><input name="slug" placeholder="example-page"><label>Body</label><textarea name="body" style="min-height:360px"></textarea><label><input style="width:auto;min-height:auto;margin-right:8px" type="checkbox" name="published" checked> Published</label><button class="btn primary">CREATE PAGE</button></form></aside>
  </div>
</main>
<%- include("partials/footer") %>
