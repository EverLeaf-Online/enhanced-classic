<%- include("partials/header",{title:"CMS Pages"}) %><main class="lightPage"><section class="lightTitle"><div class="wrap"><div class="pageEyebrow">CMS Workspace</div><h1>Website Pages</h1><p>Create and manage About, Rules, Terms, and custom public content.</p></div></section><%- include("partials/admin-manager-nav") %><div class="cmsWorkspace"><section class="cmsPanel"><div class="cmsManagerTitle"><h2>Page Library</h2><p><%=pages.length%> managed page<%=pages.length===1?'':'s'%>.</p></div><% pages.forEach(page=>{ const publicUrl=['about','rules','terms'].includes(page.slug)?`/${page.slug}`:`/pages/${page.slug}`; %><div class="cmsItem"><div><strong><%=page.title%></strong><div class="cmsMeta"><%=publicUrl%> · <%=page.published?'Published':'Draft'%> · updated <%=page.updated_at%></div></div><div class="cmsItemActions"><a class="btn small" href="/admin/pages/<%=page.id%>/edit">Edit</a><a class="btn small" href="<%=publicUrl%>" target="_blank" rel="noopener noreferrer">View</a><% if(!['about','rules','terms'].includes(page.slug)){ %><form method="post" action="/admin/pages/<%=page.id%>/delete" onsubmit="return confirm('Delete this page?')"><button class="btn small">Delete</button></form><% } %></div></div><% }) %><% if(!pages.length){ %><p class="muted">No CMS pages exist yet.</p><% } %></section><aside class="cmsPanel"><div class="cmsManagerTitle"><h2>Create Page</h2><p>Add a new public information page.</p></div><form class="cmsFormSection" method="post" action="/admin/pages"><label>Title</label><input name="title" required><label>Slug</label><input name="slug" placeholder="example-page"><label>Body</label><textarea name="body" style="min-height:250px"></textarea><label style="display:flex;gap:8px;align-items:center"><input style="width:auto" type="checkbox" name="published" checked> Published</label><button class="btn primary">CREATE PAGE</button></form></aside></div></main><%- include("partials/footer") %>
