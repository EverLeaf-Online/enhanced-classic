<%- include("partials/header",{title:"Community"}) %>
<main class="lightPage"><div class="lightTitle"><div class="wrap"><h1>Community</h1><p>Connect with other EverLeaf players.</p></div></div><div class="wrap">
<div class="communityGrid">
  <div class="paperCard communityCard">
    <div class="communityIcon">💬</div>
    <h3>Discord</h3>
    <p class="muted">Chat with the community, get help, and hear about events first.</p>
    <% if(brand.discordUrl){ %><a class="btn primary" href="<%=brand.discordUrl%>">JOIN DISCORD</a><% } else { %><p class="muted">The Discord invite has not been configured yet.</p><% } %>
  </div>
  <div class="paperCard communityCard">
    <div class="communityIcon">📰</div>
    <h3>News &amp; Patch Notes</h3>
    <p class="muted">Follow every update, event, and maintenance notice.</p>
    <a class="btn" href="/news">VIEW NEWS</a>
  </div>
  <div class="paperCard communityCard">
    <div class="communityIcon">🏆</div>
    <h3>Rankings</h3>
    <p class="muted">See who's leading EverLeaf across every job class.</p>
    <a class="btn" href="/rankings">VIEW RANKINGS</a>
  </div>
</div>
</div></main><%- include("partials/footer") %>
