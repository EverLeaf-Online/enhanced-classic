<%- include("partials/header",{title:"Edit Page"}) %>
<% const previewUrl=['about','rules','terms'].includes(page.slug)?`/${page.slug}`:`/pages/${page.slug}`; %>
<main class="lightPage">
  <section class="lightTitle"><div class="wrap"><div class="pageEyebrow">CMS://ROUTE EDITOR</div><h1>EDIT PAGE.</h1><p><%=page.title%> // <%=previewUrl%></p></div></section>
  <%- include("partials/admin-manager-nav") %>
  <div class="cmsWorkspaceSingle">
    <section class="cmsPanel" style="max-width:1080px">
      <div class="cmsManagerTitle"><h2>PUBLIC DOCUMENT</h2><p>Update route metadata, body, and publication state.</p></div>
      <form method="post" action="/admin/pages/<%=page.id%>/edit">
        <div class="editGrid2"><div><label>Title</label><input name="title" value="<%=page.title%>" required></div><div><label>Slug</label><input name="slug" value="<%=page.slug%>" required></div></div>
        <label>Body</label><textarea name="body" style="min-height:540px"><%=page.body%></textarea>
        <label><input style="width:auto;min-height:auto;margin-right:8px" type="checkbox" name="published" value="1" <%=page.published?'checked':''%>> Published</label>
        <div class="editActions"><a class="btn" href="/admin/pages">CANCEL</a><a class="btn" href="<%=previewUrl%>" target="_blank" rel="noopener noreferrer">PUBLIC PREVIEW ↗</a><button class="btn primary">SAVE PAGE</button></div>
      </form>
    </section>
  </div>
</main>
<%- include("partials/footer") %>
