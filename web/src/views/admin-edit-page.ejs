<%- include("partials/header",{title:"Edit Page"}) %><% const previewUrl=['about','rules','terms'].includes(page.slug)?`/${page.slug}`:`/pages/${page.slug}`; %><main class="lightPage"><section class="lightTitle"><div class="wrap"><div class="pageEyebrow">CMS Editor</div><h1>Edit Page</h1><p><%=page.title%></p></div></section><%- include("partials/admin-manager-nav") %><div class="cmsWorkspaceSingle"><section class="cmsPanel" style="max-width:940px;margin:auto"><div class="cmsManagerTitle"><h2>Page Content</h2><p>Update the title, public URL, body, and publication state.</p></div><form method="post" action="/admin/pages/<%=page.id%>/edit"><label>Title</label><input name="title" value="<%=page.title%>" required><label>Slug</label><input name="slug" value="<%=page.slug%>" required><label>Body</label><textarea name="body" style="min-height:380px"><%=page.body%></textarea><label style="display:flex;gap:8px;align-items:center"><input style="width:auto" type="checkbox" name="published" value="1" <%=page.published?'checked':''%>> Published</label><div class="editActions"><a class="btn" href="/admin/pages">Cancel</a><a class="btn" href="<%=previewUrl%>" target="_blank" rel="noopener noreferrer">Preview</a><button class="btn primary">Save Page</button></div></form></section></div></main><%- include("partials/footer") %>
