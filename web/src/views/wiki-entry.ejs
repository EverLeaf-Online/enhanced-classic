<%- include("partials/header",{title:entry.title,description:entry.summary}) %>
<main class="lightPage wikiEntryPage"><div class="wrap wikiEntryLayout"><aside class="wikiEntryNav"><a class="wikiBack" href="/wiki">← Back to Wiki</a><div class="wikiEntryNavBox"><span class="pageEyebrow">ARTICLE</span><strong><%=entry.title%></strong><small><%=entry.status%></small></div><div class="wikiEntryNavBox"><span class="pageEyebrow">LIBRARY SOURCE</span><p><%=entry.sourceDoc||entry.source%></p><small><%=entry.verification||'Curated from the EverLeaf research library.'%></small></div></aside><article class="wikiEntry"><header><div class="pageEyebrow"><%=entry.eyebrow%></div><h1><%=entry.title%></h1><p class="wikiLead"><%=entry.summary%></p><div class="wikiEntryMeta"><span class="wikiStatus"><%=entry.status%></span><span><%=categories.find(c=>c.key===entry.category)?.label||entry.category%></span><span class="wikiVerified">✓ <%=entry.verification||'Library curated'%></span></div></header><% if(entry.facts&&entry.facts.length){ %><section class="wikiFacts"><% entry.facts.forEach(([label,value])=>{ %><div><small><%=label%></small><strong><%=value%></strong></div><% }) %></section><% } %><div class="wikiEntrySections"><% (entry.sections||[]).forEach(([title,body])=>{ %><section><h2><%=title%></h2><p><%=body%></p></section><% }) %></div><section class="wikiProvenance"><div><span class="pageEyebrow">PROVENANCE</span><h2>Where this information comes from</h2><p>This public article is a curated snapshot of preserved EverLeaf research. The website does not read the private research repository at request time, so Wiki availability is not coupled to GitHub or private credentials.</p></div><dl><div><dt>Source document</dt><dd><%=entry.sourceDoc||entry.source%></dd></div><div><dt>Verification</dt><dd><%=entry.verification||'Library curated'%></dd></div><div><dt>Gameplay status</dt><dd><%=entry.status%></dd></div></dl></section><% if(entry.tags&&entry.tags.length){ %><footer class="wikiEntryTags"><strong>Topics</strong><div class="wikiTags"><% entry.tags.forEach(tag=>{ %><a href="/wiki?q=<%=encodeURIComponent(tag)%>"><%=tag%></a><% }) %></div></footer><% } %></article></div><% if(related.length){ %><section class="wikiRelated"><div class="wrap"><div class="sectionHead"><div><div class="pageEyebrow">KEEP READING</div><h2>Related guides</h2></div><a href="/wiki?category=<%=entry.category%>">VIEW CATEGORY →</a></div><div class="wikiRelatedGrid"><% related.forEach(item=>{ %><a href="/wiki/<%=item.slug%>"><span><%=item.status%></span><strong><%=item.title%></strong><p><%=item.summary%></p></a><% }) %></div></div></section><% } %></main><%- include("partials/footer") %>
