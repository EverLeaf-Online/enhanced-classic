<%- include("partials/header",{title:entry.title,description:entry.summary}) %>
<%
const categoryLabel=categories.find(c=>c.key===entry.category)?.label||entry.category;
const base=typeof guideBase==='string'?guideBase:'/wiki/guides';
const fmtDate=value=>{
  if(!value)return 'Recently';
  const d=new Date(String(value).includes('T')?value:String(value).replace(' ','T')+'Z');
  return Number.isNaN(d.valueOf())?'Recently':d.toLocaleDateString(undefined,{year:'numeric',month:'long',day:'numeric'});
};
%>
<main class="lightPage wikiEntryPage">
<div class="wrap wikiBreadcrumb"><a href="/wiki">Data Wiki</a><span>›</span><a href="<%=base%>">Guides</a><span>›</span><a href="<%=base%>?category=<%=entry.category%>"><%=categoryLabel%></a><span>›</span><strong><%=entry.title%></strong></div>
<div class="wrap wikiEntryLayout">
<aside class="wikiEntryNav"><a class="wikiBack" href="<%=base%>">← Back to Guides</a><div class="wikiEntryNavBox"><span class="pageEyebrow">GUIDE</span><strong><%=entry.title%></strong><small><%=entry.status%></small></div><% if(entry.sections&&entry.sections.length){ %><nav class="wikiToc" aria-label="Article contents"><span class="pageEyebrow">CONTENTS</span><% entry.sections.forEach(section=>{ %><a href="#<%=section.id%>"><%=section.title%></a><% }) %></nav><% } %><div class="wikiEntryNavBox"><span class="pageEyebrow">ARTICLE SOURCE</span><p><%=entry.sourceDoc||entry.source%></p><small><%=entry.verification||'Curated by EverLeaf staff.'%></small></div></aside>
<article class="wikiEntry"><header><div class="pageEyebrow"><%=entry.eyebrow%></div><h1><%=entry.title%></h1><p class="wikiLead"><%=entry.summary%></p><div class="wikiEntryMeta"><span class="wikiStatus"><%=entry.status%></span><span><%=categoryLabel%></span><span class="wikiVerified">✓ <%=entry.verification||'Staff curated'%></span><span>Updated <%=fmtDate(entry.updatedAt)%></span></div></header>
<% if(entry.facts&&entry.facts.length){ %><section class="wikiFacts"><% entry.facts.forEach(([label,value])=>{ %><div><small><%=label%></small><strong><%=value%></strong></div><% }) %></section><% } %>
<div class="wikiEntrySections"><% (entry.sections||[]).forEach(section=>{ %><section id="<%=section.id%>"><h2><%=section.title%></h2><p><%=section.body%></p></section><% }) %><% if(!entry.sections||!entry.sections.length){ %><section><h2>Article in progress</h2><p>This guide has been published but does not have article sections yet. EverLeaf staff can expand it from the Wiki CMS.</p></section><% } %></div>
<section class="wikiProvenance"><div><span class="pageEyebrow">PROVENANCE</span><h2>Maintained by EverLeaf</h2><p>This guide is served from EverLeaf's persistent website CMS database. The searchable game-data catalog lives in the main Wiki and is generated from the server itself.</p></div><dl><div><dt>Source</dt><dd><%=entry.sourceDoc||entry.source%></dd></div><div><dt>Verification</dt><dd><%=entry.verification||'Staff curated'%></dd></div><div><dt>Gameplay status</dt><dd><%=entry.status%></dd></div><div><dt>Last updated</dt><dd><%=fmtDate(entry.updatedAt)%></dd></div></dl></section>
<% if(entry.tags&&entry.tags.length){ %><footer class="wikiEntryTags"><strong>Topics</strong><div class="wikiTags"><% entry.tags.forEach(tag=>{ %><a href="<%=base%>?q=<%=encodeURIComponent(tag)%>"><%=tag%></a><% }) %></div></footer><% } %></article></div>
<% if(related.length){ %><section class="wikiRelated"><div class="wrap"><div class="sectionHead"><div><div class="pageEyebrow">KEEP READING</div><h2>Related guides</h2></div><a href="<%=base%>?category=<%=entry.category%>">VIEW CATEGORY →</a></div><div class="wikiRelatedGrid"><% related.forEach(item=>{ %><a href="<%=base%>/<%=item.slug%>"><span><%=item.status%></span><strong><%=item.title%></strong><p><%=item.summary%></p></a><% }) %></div></div></section><% } %>
</main><%- include("partials/footer") %>