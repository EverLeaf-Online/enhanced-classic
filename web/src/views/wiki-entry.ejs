<%- include("partials/header",{title:entry.title,description:entry.summary}) %>
<main class="lightPage wikiEntryPage"><div class="wrap wikiEntryLayout"><aside class="wikiEntryNav"><a class="wikiBack" href="/wiki">← Back to Wiki</a><div class="wikiEntryNavBox"><span class="pageEyebrow">ARTICLE</span><strong><%=entry.title%></strong><small><%=entry.status%></small></div><div class="wikiEntryNavBox"><span class="pageEyebrow">SOURCE</span><p><%=entry.source%></p><small>Curated into the website from EverLeaf's durable research library.</small></div></aside><article class="wikiEntry"><header><div class="pageEyebrow"><%=entry.eyebrow%></div><h1><%=entry.title%></h1><p class="wikiLead"><%=entry.summary%></p><div class="wikiEntryMeta"><span class="wikiStatus"><%=entry.status%></span><span><%=categories.find(c=>c.key===entry.category)?.label||entry.category%></span></div></header><% if(entry.facts&&entry.facts.length){ %><section class="wikiFacts"><% entry.facts.forEach(([label,value])=>{ %><div><small><%=label%></small><strong><%=value%></strong></div><% }) %></section><% } %><div class="wikiEntrySections"><% (entry.sections||[]).forEach(([title,body])=>{ %><section><h2><%=title%></h2><p><%=body%></p></section><% }) %></div><% if(entry.tags&&entry.tags.length){ %><footer class="wikiEntryTags"><strong>Topics</strong><div class="wikiTags"><% entry.tags.forEach(tag=>{ %><a href="/wiki?q=<%=encodeURIComponent(tag)%>"><%=tag%></a><% }) %></div></footer><% } %></article></div><% if(related.length){ %><section class="wikiRelated"><div class="wrap"><div class="sectionHead"><div><div class="pageEyebrow">KEEP READING</div><h2>Related guides</h2></div><a href="/wiki?category=<%=entry.category%>">VIEW CATEGORY →</a></div><div class="wikiRelatedGrid"><% related.forEach(item=>{ %><a href="/wiki/<%=item.slug%>"><span><%=item.status%></span><strong><%=item.title%></strong><p><%=item.summary%></p></a><% }) %></div></div></section><% } %></main><%- include("partials/footer") %>
