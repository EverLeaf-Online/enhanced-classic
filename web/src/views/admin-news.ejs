<%- include("partials/header",{title:"CMS News"}) %><main class="lightPage"><section class="lightTitle"><div class="wrap"><div class="pageEyebrow">CMS Workspace</div><h1>News & Patch Notes</h1><p>Publish, review, and edit EverLeaf updates from one editorial workspace.</p></div></section><%- include("partials/admin-manager-nav") %><div class="cmsWorkspace"><section class="cmsPanel"><div class="cmsManagerTitle"><h2>Published & Draft Posts</h2><p><%=posts.length%> total post<%=posts.length===1?'':'s'%>.</p></div><% posts.forEach(p=>{ %><div class="cmsItem"><div><strong><%=p.title%></strong><div class="cmsMeta"><%=p.type%> · <%=p.published?'Published':'Draft'%> · <%=p.created_at%></div></div><div class="cmsItemActions"><a class="btn small" href="/admin/posts/<%=p.id%>/edit">Edit</a></div></div><% }) %><% if(!posts.length){ %><p class="muted">No posts yet.</p><% } %></section><aside class="cmsPanel"><div class="cmsManagerTitle"><h2>Publish Update</h2><p>Create a news post, patch note, or event announcement.</p></div><form class="cmsFormSection" method="post" action="/admin/posts"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>"><label>Title</label><input name="title" required><label>Slug</label><input name="slug"><label>Excerpt</label><textarea name="excerpt"></textarea><label>Body</label><textarea name="body" style="min-height:230px"></textarea><label>Type</label><select name="type"><option>news</option><option>patch</option><option>event</option></select><label style="display:flex;gap:8px;align-items:center"><input style="width:auto" type="checkbox" name="published" checked> Published immediately</label><button class="btn primary">PUBLISH UPDATE</button></form></aside></div></main><%- include("partials/footer") %>
