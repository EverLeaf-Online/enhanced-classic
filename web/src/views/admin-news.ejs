<%- include("partials/header",{title:"CMS News"}) %><main class="lightPage"><div class="lightTitle"><div class="wrap"><h1>News & Patch Notes</h1><p>Publish and manage EverLeaf updates from one place.</p></div></div><div class="wrap" style="max-width:1100px;display:grid;grid-template-columns:minmax(0,1.4fr) minmax(300px,.8fr);gap:18px;align-items:start"><div class="paperCard"><div style="display:flex;justify-content:space-between;align-items:center"><h2 style="margin:0">Posts</h2><a class="btn small" href="/admin">Dashboard</a></div><% posts.forEach(p=>{ %><div class="adminRow" style="display:flex;justify-content:space-between;gap:12px;align-items:center"><div><strong><%=p.title%></strong><div class="muted"><%=p.type%> · <%=p.published?'Published':'Draft'%> · <%=p.created_at%></div></div><a class="btn small" href="/admin/posts/<%=p.id%>/edit">Edit</a></div><% }) %><% if(!posts.length){ %><p class="muted">No posts yet.</p><% } %></div><div class="paperCard"><h2>Publish</h2><form method="post" action="/admin/posts"><label>Title</label><input name="title" required><label>Slug</label><input name="slug"><label>Excerpt</label><textarea name="excerpt"></textarea><label>Body</label><textarea name="body"></textarea><label>Type</label><select name="type"><option>news</option><option>patch</option><option>event</option></select><label style="display:flex;gap:8px"><input style="width:auto" type="checkbox" name="published" checked> Published</label><button class="btn primary">Publish</button></form></div></div></main><%- include("partials/footer") %>
