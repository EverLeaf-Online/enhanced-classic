<%- include("partials/header",{title:"CMS Settings"}) %><main class="lightPage"><section class="lightTitle"><div class="wrap"><div class="pageEyebrow">CMS Workspace</div><h1>Site Settings</h1><p>Manage global website copy, fallback notices, maintenance messaging, and footer content.</p></div></section><%- include("partials/admin-manager-nav") %><div class="cmsWorkspaceSingle"><section class="cmsPanel" style="max-width:900px;margin:auto"><div class="cmsManagerTitle"><h2>Public Site Settings</h2><p>Changes here affect shared content across the EverLeaf website.</p></div><form class="cmsFormSection" method="post" action="/admin/settings"><label>Hero title</label><input name="hero_title" value="<%=site.hero_title%>"><label>Hero subtitle</label><textarea name="hero_subtitle"><%=site.hero_subtitle%></textarea><label>Fallback announcement</label><textarea name="announcement"><%=site.announcement%></textarea><label>Maintenance message</label><textarea name="maintenance_message"><%=site.maintenance_message%></textarea><label>Footer note</label><textarea name="footer_note"><%=site.footer_note%></textarea><button class="btn primary">SAVE SITE SETTINGS</button></form></section></div></main><%- include("partials/footer") %>
