<%- include("partials/header",{title:"CMS Settings"}) %>
<main class="lightPage">
  <section class="lightTitle"><div class="wrap"><div class="pageEyebrow">CMS://GLOBAL CONFIG</div><h1>SITE<br>SETTINGS.</h1><p>Manage shared public copy, fallback notices, maintenance state, and footer content.</p></div></section>
  <%- include("partials/admin-manager-nav") %>
  <div class="cmsWorkspaceSingle">
    <section class="cmsPanel" style="max-width:980px">
      <div class="cmsManagerTitle"><h2>PUBLIC CONFIGURATION</h2><p>Changes apply to shared website state without a code deployment.</p></div>
      <form class="cmsFormSection" method="post" action="/admin/settings">
        <label>Hero title</label><input name="hero_title" value="<%=site.hero_title%>">
        <label>Hero subtitle</label><textarea name="hero_subtitle"><%=site.hero_subtitle%></textarea>
        <label>Fallback announcement</label><textarea name="announcement"><%=site.announcement%></textarea>
        <label>Maintenance message</label><textarea name="maintenance_message"><%=site.maintenance_message%></textarea>
        <label>Footer note</label><textarea name="footer_note"><%=site.footer_note%></textarea>
        <button class="btn primary">SAVE CONFIGURATION</button>
      </form>
    </section>
  </div>
</main>
<%- include("partials/footer") %>
