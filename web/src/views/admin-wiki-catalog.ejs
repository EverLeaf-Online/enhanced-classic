<%- include("partials/header",{title:"Wiki Data Curation"}) %>
<main class="lightPage adminKnowledgePage">
<section class="lightTitle"><div class="wrap"><div class="pageEyebrow">CMS Workspace</div><h1>Wiki Data Curation</h1><p>Control which WZ-backed items, monsters, maps, skills, NPCs, and quests are player-visible. Nothing here deletes or changes game data.</p></div></section>
<%- include("partials/admin-manager-nav") %>
<div class="wrap wikiCurationWrap">
  <div class="wikiCurationTop"><a class="btn small" href="/admin/knowledge">← Knowledge Library</a><a class="btn small" href="/wiki" target="_blank" rel="noopener">Open Public Wiki ↗</a></div>
  <% if(saved){ %><div class="success knowledgeSaved">Wiki visibility updated.</div><% } %>
  <section class="cmsPanel wikiCurationSummary">
    <div class="cmsManagerTitle"><div><h2>Player Visibility</h2><p>Automatic rules handle obvious junk; staff overrides are permanent until reset to Automatic.</p></div></div>
    <div class="knowledgeSummary wikiCurationStats"><div><small>Catalog records</small><strong><%=curationStats.total%></strong></div><div><small>Public</small><strong><%=curationStats.visible%></strong></div><div><small>Hidden</small><strong><%=curationStats.hidden%></strong></div><div><small>Automatic hidden</small><strong><%=curationStats.automaticHidden%></strong></div><div><small>Manual hidden</small><strong><%=curationStats.manualHidden%></strong></div><div><small>Manual visible</small><strong><%=curationStats.manualVisible%></strong></div></div>
  </section>
  <section class="cmsPanel wikiCurationPanel">
    <div class="wikiTypeTabs"><% Object.entries(types).forEach(([key,meta])=>{ const s=curationStats.byType[key]||{}; %><a class="<%=type===key?'active':''%>" href="/admin/knowledge/catalog?type=<%=key%>"><span><%=meta.label%></span><small><%=s.visible||0%> public · <%=s.hidden||0%> hidden</small></a><% }) %></div>
    <form class="knowledgeFilters wikiCurationFilters" method="get" action="/admin/knowledge/catalog"><input type="hidden" name="type" value="<%=type%>"><input type="search" name="q" value="<%=q%>" placeholder="Search by name, description, subtype, or exact ID"><select name="filter"><option value="all" <%=filter==='all'?'selected':''%>>All records</option><option value="visible" <%=filter==='visible'?'selected':''%>>Public only</option><option value="hidden" <%=filter==='hidden'?'selected':''%>>Hidden only</option><option value="automatic-hidden" <%=filter==='automatic-hidden'?'selected':''%>>Automatic hidden</option><option value="manual-hidden" <%=filter==='manual-hidden'?'selected':''%>>Manual hidden</option><option value="manual-visible" <%=filter==='manual-visible'?'selected':''%>>Manual visible</option></select><button class="btn primary">FILTER</button><% if(q||filter!=='all'){ %><a class="btn" href="/admin/knowledge/catalog?type=<%=type%>">CLEAR</a><% } %></form>
    <div class="wikiCurationCount"><strong><%=result.total%></strong> matching <%=types[type].label.toLowerCase()%> · page <%=result.page%> of <%=result.pages%></div>
    <div class="knowledgeTableWrap"><table class="knowledgeTable wikiCurationTable"><thead><tr><th>Record</th><th>Current public state</th><th>Automatic rule</th><th>Staff override</th></tr></thead><tbody>
      <% result.rows.forEach(row=>{ const override=row.visibilityOverride; const selected=override?.visibility||'auto'; %>
      <tr>
        <td><strong><%=row.name%></strong><small>#<%=row.id%><%=row.subtype?` · ${row.subtype}`:''%></small><% if(row.description){ %><small><%=row.description%></small><% } %></td>
        <td><span class="wikiVisibilityBadge <%=row.publicVisible?'visible':'hidden'%>"><%=row.publicVisible?'PUBLIC':'HIDDEN'%></span><small><%=row.visibilitySource.replaceAll('-',' ')%></small><% if(row.visibilityReason){ %><small><%=row.visibilityReason%></small><% } %><% if(row.publicVisible){ %><a class="wikiCurationPublicLink" href="/wiki/<%=type%>/<%=row.id%>" target="_blank" rel="noopener">View public entry ↗</a><% } %></td>
        <td><span class="wikiAutoState <%=row.automaticHidden?'flagged':'clear'%>"><%=row.automaticHidden?'FLAGGED':'CLEAR'%></span><small><%=row.automaticHidden?row.automaticReason:'No obvious junk marker'%></small></td>
        <td><form class="wikiVisibilityForm" method="post" action="/admin/knowledge/catalog/<%=type%>/<%=row.id%>/visibility"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>"><input type="hidden" name="returnQ" value="<%=q%>"><input type="hidden" name="returnFilter" value="<%=filter%>"><input type="hidden" name="returnPage" value="<%=result.page%>"><select name="visibility"><option value="auto" <%=selected==='auto'?'selected':''%>>Automatic</option><option value="visible" <%=selected==='visible'?'selected':''%>>Force public</option><option value="hidden" <%=selected==='hidden'?'selected':''%>>Force hidden</option></select><input name="reason" maxlength="300" value="<%=override?.reason||''%>" placeholder="Reason / staff note"><button class="btn small primary" type="submit">SAVE</button><% if(override){ %><small>Last set by <%=override.updated_by||'staff'%> · <%=override.updated_at%></small><% }else{ %><small>No manual override.</small><% } %></form></td>
      </tr><% }) %>
    </tbody></table><% if(!result.rows.length){ %><div class="knowledgeEmpty">No catalog records match these filters.</div><% } %></div>
    <% const common=`type=${encodeURIComponent(type)}${q?`&q=${encodeURIComponent(q)}`:''}${filter!=='all'?`&filter=${encodeURIComponent(filter)}`:''}`; %>
    <div class="wikiCurationPager"><% if(result.page>1){ %><a class="btn small" href="/admin/knowledge/catalog?<%=common%>&page=<%=result.page-1%>">← Previous</a><% }else{ %><span></span><% } %><span>Page <%=result.page%> of <%=result.pages%></span><% if(result.page<result.pages){ %><a class="btn small" href="/admin/knowledge/catalog?<%=common%>&page=<%=result.page+1%>">Next →</a><% } %></div>
  </section>
</div>
</main>
<%- include("partials/footer") %>
