<%- include("partials/header",{title:"Rankings",description:"Live EverLeaf character rankings powered by the game database."}) %>
<%
const jobArt=(name='')=>{
  const n=String(name).toLowerCase();
  if(/beginner|legend/.test(n)) return '/assets/jobs/beginner/beginner-clean.png';
  if(/aran/.test(n)) return '/assets/jobs/special/aran.png';
  if(/evan/.test(n)) return '/assets/jobs/special/evan.png';
  if(/dawn warrior/.test(n)) return '/assets/jobs/cygnus/dawn-warrior.png';
  if(/blaze wizard/.test(n)) return '/assets/jobs/cygnus/blaze-wizard.png';
  if(/wind archer/.test(n)) return '/assets/jobs/cygnus/wind-archer.png';
  if(/night walker/.test(n)) return '/assets/jobs/cygnus/night-walker.png';
  if(/thunder breaker/.test(n)) return '/assets/jobs/cygnus/thunder-breaker.png';
  if(/cygnus|noblesse/.test(n)) return '/assets/jobs/special/cygnus-clean.png';
  if(/warrior|fighter|crusader|hero|page|white knight|paladin|spearman|dragon knight|dark knight/.test(n)) return '/assets/jobs/instructors/warrior.png';
  if(/magician|wizard|mage|cleric|priest|bishop/.test(n)) return '/assets/jobs/instructors/magician.png';
  if(/bowman|archer|hunter|ranger|bowmaster|crossbow|sniper|marksman/.test(n)) return '/assets/jobs/instructors/bowman.png';
  if(/thief|rogue|assassin|hermit|night lord|bandit|chief bandit|shadower/.test(n)) return '/assets/jobs/instructors/thief.png';
  if(/pirate|brawler|marauder|buccaneer|gunslinger|outlaw|corsair/.test(n)) return '/assets/jobs/instructors/pirate.png';
  return '/assets/everleaf-mark-2026.svg';
};
const avatar=(r)=>`/character-avatar/${Number(r.id)}.png?job=${Number(r.job||0)}`;
const fmt=n=>Number(n||0).toLocaleString();
const topThree=(currentPage===1&&!q?rows.slice(0,3):[]);
const linkFor=(page=1,cls=activeClass)=>`/rankings?class=${encodeURIComponent(cls)}${q?`&q=${encodeURIComponent(q)}`:''}${page>1?`&page=${page}`:''}`;
const loadedTime=generatedAt.toLocaleTimeString(undefined,{hour:'numeric',minute:'2-digit'});
%>
<main class="lightPage rankingsShell">
  <section class="rankingsHero">
    <div class="wrap rankingsHeroInner">
      <div class="rankingsHeroMain">
        <div class="pageEyebrow">LIVE LEADERBOARD</div>
        <h1>Rankings</h1>
        <p>See who is leading EverLeaf right now. Search any character or filter the ladder by job family.</p>
        <form class="rankingSearchBar" method="get" action="/rankings">
          <input type="hidden" name="class" value="<%=activeClass%>">
          <input type="search" name="q" value="<%=q%>" maxlength="20" placeholder="Search character name" aria-label="Search rankings by character name">
          <button class="btn primary" type="submit">Search</button>
          <% if(q){ %><a class="rankingSearchClear" href="/rankings?class=<%=activeClass%>">Clear</a><% } %>
        </form>
      </div>
      <div class="rankingsHeroStats" aria-label="Ranking summary">
        <div><small>Ranked</small><strong><%=fmt(totalRanked)%></strong></div>
        <div><small>Top level</small><strong><%=fmt(maxLevel)%></strong></div>
        <div><small>Online</small><strong><%=onlinePlayers==null?'—':fmt(onlinePlayers)%></strong></div>
        <div><small>Updated</small><strong><%=loadedTime%></strong></div>
      </div>
    </div>
  </section>

  <div class="wrap rankingsLayout">
    <section class="rankingFilters" aria-label="Ranking filters">
      <div class="rankingFiltersHeader">
        <div>
          <span class="rankingFiltersLabel">Leaderboard</span>
          <strong><%=q?`Search results for “${q}”`:(classes[activeClass]&&classes[activeClass].label||'Overall')%></strong>
        </div>
        <span><%=fmt(totalRanked)%> character<%=totalRanked===1?'':'s'%></span>
      </div>
      <nav class="rankingTabs" aria-label="Ranking class filters">
        <% Object.entries(classes).forEach(([key,c])=>{ %>
          <a class="rankingTab <%=activeClass===key?'active':''%>" href="<%=linkFor(1,key)%>"><%=c.label%></a>
        <% }) %>
      </nav>
    </section>

    <% if(error){ %>
      <div class="error rankingError"><strong>Rankings unavailable</strong><span><%=error%></span></div>
    <% } %>

    <% if(!error&&topThree.length){ %>
      <section class="rankingLeaders" aria-label="Top ranked adventurers">
        <div class="rankingSectionHead">
          <div><span>Top adventurers</span><strong>Current leaders</strong></div>
          <small>Live saved character appearances</small>
        </div>
        <div class="rankingLeaderGrid">
          <% topThree.forEach((r,i)=>{ const rank=i+1; %>
            <article class="rankingLeaderCard rank<%=rank%>">
              <span class="rankingLeaderRank">#<%=rank%></span>
              <div class="rankingLeaderAvatar rankingCharacterAvatar"><img src="<%=jobArt(r.jobName)%>" data-live-avatar="<%=avatar(r)%>" alt="<%=r.name%>'s EverLeaf character portrait"></div>
              <div class="rankingLeaderInfo">
                <strong><%=r.name%></strong>
                <span><%=r.jobName||'Adventurer'%></span>
                <div><b>Lv. <%=fmt(r.level)%></b><small><%=fmt(r.fame)%> fame</small></div>
              </div>
            </article>
          <% }) %>
        </div>
      </section>
    <% } %>

    <section id="ranking-board" class="rankingBoardClean">
      <div class="rankingBoardCleanHead">
        <div>
          <span><%=q?'Player search':'World ranking'%></span>
          <strong><%=q?`Results for “${q}”`:(classes[activeClass]&&classes[activeClass].label||'All Adventurers')%></strong>
        </div>
        <div class="rankingBoardMeta"><span>Page <%=currentPage%> of <%=totalPages||1%></span><span>Updated <%=loadedTime%></span></div>
      </div>

      <% if(rows.length){ %>
        <div class="tableWrap rankingTableWrap">
          <table class="rankingTableClean">
            <thead><tr><th>Rank</th><th>Character</th><th>Job</th><th>Level</th><th>Fame</th><th>EXP</th></tr></thead>
            <tbody>
              <% rows.forEach((r,i)=>{ const rank=startRank+i+1; %>
                <tr>
                  <td><span class="rankingPlace <%=rank<=3?'top'+rank:''%>"><%=rank%></span></td>
                  <td>
                    <div class="rankingPlayerCell">
                      <span class="rankingPlayerAvatar rankingCharacterAvatar"><img src="<%=jobArt(r.jobName)%>" data-live-avatar="<%=avatar(r)%>" loading="lazy" alt="<%=r.name%>'s EverLeaf character portrait"></span>
                      <strong><%=r.name%></strong>
                    </div>
                  </td>
                  <td><span class="rankingJob"><%=r.jobName||'Adventurer'%></span></td>
                  <td class="rankingLevel">Lv. <%=fmt(r.level)%></td>
                  <td><%=fmt(r.fame)%></td>
                  <td><%=fmt(r.exp)%></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div class="rankingFooterClean">
          <div class="pagination">
            <% let prev=0; pageNumbers.forEach(p=>{ if(prev&&p-prev>1){ %><span class="pageGap">…</span><% } %><a class="pageBtn <%=p===currentPage?'active':''%>" href="<%=linkFor(p)%>"><%=p%></a><% prev=p; }); %>
            <% if(currentPage<totalPages){ %><a class="pageBtn pageNext" href="<%=linkFor(currentPage+1)%>">Next ›</a><% } %>
          </div>
          <span><%=fmt(totalRanked)%> total ranked</span>
        </div>
      <% } else if(!error){ %>
        <div class="rankingEmptyClean">
          <h3><%=q?'No matching character.':'No ranked characters here yet.'%></h3>
          <p><%=q?'Try another character name or clear the search.':'No characters are currently ranked in this job family.'%></p>
          <% if(q){ %><a class="btn" href="/rankings?class=<%=activeClass%>">Clear search</a><% } %>
        </div>
      <% } %>
    </section>
  </div>
</main>
<%- include("partials/footer") %>