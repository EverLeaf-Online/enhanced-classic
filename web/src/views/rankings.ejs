<%- include("partials/header",{title:"Rankings"}) %>
<main class="lightPage"><section class="lightTitle"><div class="wrap pageHeroGrid"><div><div class="pageEyebrow">Hall of Legends</div><h1>EverLeaf Rankings</h1><p>Follow the adventurers leading each class family across EverLeaf.</p></div><div class="pageHeroAside"><strong>Progression snapshot</strong><span>Rankings refresh every 30 minutes, so recent in-game levels can briefly appear behind.</span></div></div></section><div class="wrap contentStack" style="padding-top:34px;padding-bottom:65px">
<nav class="tabs" aria-label="Ranking class filters"><% Object.entries(classes).forEach(([key,c])=>{ %><a class="tab <%=activeClass===key?'active':''%>" href="/rankings?class=<%=key%>"><%=c.label%></a><% }) %></nav>
<% if(error){ %><div class="error"><%=error%></div><% } %>
<section class="featurePanel"><div style="display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:16px"><div><div class="pageEyebrow">Leaderboard</div><h2 style="margin:0"><%=classes[activeClass]&&classes[activeClass].label||'All Adventurers'%></h2></div><span class="kicker">Page <%=currentPage%> of <%=totalPages||1%></span></div><div class="tableWrap"><table><thead><tr><th>Rank</th><th>Adventurer</th><th>Job</th><th>Level</th></tr></thead><tbody><% rows.forEach((r,i)=>{ %><tr><td><strong>#<%=startRank+i+1%></strong></td><td class="rankNameCell"><span class="rankAvatar"><%=r.name.charAt(0).toUpperCase()%></span><strong><%=r.name%></strong></td><td><%=r.jobName%></td><td><strong class="rankLvCell"><%=r.level%></strong></td></tr><% }) %></tbody></table></div><% if(!rows.length&&!error){ %><p class="muted">No ranked adventurers are available in this class family yet.</p><% } %><% if(rows.length){ %><div class="pagination"><% for(let p=1;p<=totalPages;p++){ %><a class="pageBtn <%=p===currentPage?'active':''%>" href="/rankings?class=<%=activeClass%>&page=<%=p%>"><%=p%></a><% } %><% if(currentPage<totalPages){ %><a class="pageBtn pageNext" href="/rankings?class=<%=activeClass%>&page=<%=currentPage+1%>">Next ›</a><% } %></div><p class="muted" style="text-align:center;margin:14px 0 0;font-size:10px">Leaderboard data refreshes automatically every 30 minutes.</p><% } %></section>
</div></main><%- include("partials/footer") %>
