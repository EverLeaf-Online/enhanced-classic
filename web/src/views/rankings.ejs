<%- include("partials/header",{title:"Rankings"}) %>
<% const jobIcon=(name='')=>{const n=String(name).toLowerCase();if(/aran/.test(n))return'/assets/jobs/aran.svg';if(/evan/.test(n))return'/assets/jobs/evan.svg';if(/dawn warrior|blaze wizard|wind archer|night walker|thunder breaker|cygnus/.test(n))return'/assets/jobs/cygnus.svg';if(/warrior|fighter|crusader|hero|page|white knight|paladin|spearman|dragon knight|dark knight/.test(n))return'/assets/jobs/warrior.svg';if(/magician|wizard|mage|cleric|priest|bishop/.test(n))return'/assets/jobs/magician.svg';if(/bowman|archer|hunter|ranger|bowmaster|crossbow|sniper|marksman/.test(n))return'/assets/jobs/bowman.svg';if(/thief|rogue|assassin|hermit|night lord|bandit|chief bandit|shadower/.test(n))return'/assets/jobs/thief.svg';if(/pirate|brawler|marauder|buccaneer|gunslinger|outlaw|corsair/.test(n))return'/assets/jobs/pirate.svg';return'/assets/everleaf-remaster.svg'}; %>
<main class="lightPage"><section class="lightTitle"><div class="wrap pageHeroGrid"><div><div class="pageEyebrow">Hall of Legends</div><h1>EverLeaf Rankings</h1><p>Follow the adventurers leading each class family across EverLeaf.</p></div><div class="pageHeroAside"><strong>Progression snapshot</strong><span>Rankings refresh every 30 minutes, so recent in-game levels can briefly appear behind.</span></div></div></section><div class="wrap contentStack rankingsPage" style="padding-top:34px;padding-bottom:65px">
<nav class="tabs" aria-label="Ranking class filters"><% Object.entries(classes).forEach(([key,c])=>{ %><a class="tab <%=activeClass===key?'active':''%>" href="/rankings?class=<%=key%>"><%=c.label%></a><% }) %></nav>
<% if(error){ %><div class="error"><%=error%></div><% } %>
<section class="featurePanel rankingBoard"><div class="rankingBoardHead"><div><div class="pageEyebrow">Leaderboard</div><h2><%=classes[activeClass]&&classes[activeClass].label||'All Adventurers'%></h2></div><span class="kicker">Page <%=currentPage%> of <%=totalPages||1%></span></div><div class="tableWrap"><table class="rankingTable"><thead><tr><th>Rank</th><th>Adventurer</th><th>Job</th><th>Level</th></tr></thead><tbody><% rows.forEach((r,i)=>{ %><tr class="<%=startRank+i<3?'podiumRow':''%>"><td><span class="rankMedal rankMedal<%=startRank+i+1%>">#<%=startRank+i+1%></span></td><td class="rankNameCell"><span class="rankAvatar"><%=r.name.charAt(0).toUpperCase()%></span><strong><%=r.name%></strong></td><td><span class="jobCell"><img src="<%=jobIcon(r.jobName)%>" alt=""><span><%=r.jobName%></span></span></td><td><strong class="rankLvCell">Lv. <%=r.level%></strong></td></tr><% }) %></tbody></table></div><% if(!rows.length&&!error){ %><p class="muted">No ranked adventurers are available in this class family yet.</p><% } %><% if(rows.length){ %><div class="pagination"><% for(let p=1;p<=totalPages;p++){ %><a class="pageBtn <%=p===currentPage?'active':''%>" href="/rankings?class=<%=activeClass%>&page=<%=p%>"><%=p%></a><% } %><% if(currentPage<totalPages){ %><a class="pageBtn pageNext" href="/rankings?class=<%=activeClass%>&page=<%=currentPage+1%>">Next ›</a><% } %></div><p class="muted rankingRefresh">Leaderboard data refreshes automatically every 30 minutes.</p><% } %></section>
</div></main><%- include("partials/footer") %>
