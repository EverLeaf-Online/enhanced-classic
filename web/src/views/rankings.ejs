<%- include("partials/header",{title:"Rankings",description:"Live EverLeaf character rankings powered by the game database."}) %>
<%
const jobArt=(name='')=>{
  const n=String(name).toLowerCase();
  if(/beginner|legend/.test(n)) return '/assets/jobs/beginner/beginner-clean.png';
  if(/aran/.test(n)) return '/assets/jobs/special/aran.png';
  if(/evan/.test(n)) return '/assets/jobs/special/evan.png';
  if(/dawn warrior/.test(n)) return '/assets/jobs/cygnus/dawn-warrior.png';
  if(/blaze wizard/.test(n)) return '/assets/jobs/cygnus/blaze-wizard.png';
  if(/wind archer/.test(n)) return '/assets/jobs/cygnus/wind-archer.png';
  if(/night walker/.test(n)) return '/assets/jobs/cygnus/night-walker.png';
  if(/thunder breaker/.test(n)) return '/assets/jobs/cygnus/thunder-breaker.png';
  if(/cygnus|noblesse/.test(n)) return '/assets/jobs/special/cygnus-clean.png';
  if(/warrior|fighter|crusader|hero|page|white knight|paladin|spearman|dragon knight|dark knight/.test(n)) return '/assets/jobs/instructors/warrior.png';
  if(/magician|wizard|mage|cleric|priest|bishop/.test(n)) return '/assets/jobs/instructors/magician.png';
  if(/bowman|archer|hunter|ranger|bowmaster|crossbow|sniper|marksman/.test(n)) return '/assets/jobs/instructors/bowman.png';
  if(/thief|rogue|assassin|hermit|night lord|bandit|chief bandit|shadower/.test(n)) return '/assets/jobs/instructors/thief.png';
  if(/pirate|brawler|marauder|buccaneer|gunslinger|outlaw|corsair/.test(n)) return '/assets/jobs/instructors/pirate.png';
  return '/assets/everleaf-remaster.svg';
};
const avatar=(r)=>`/character-avatar/${Number(r.id)}.png?job=${Number(r.job||0)}`;
const fmt=n=>Number(n||0).toLocaleString();
const topThree=(currentPage===1&&!q?rows.slice(0,3):[]);
const podiumOrder=topThree.length>=3?[topThree[1],topThree[0],topThree[2]]:topThree;
const podiumRank=(r)=>startRank+rows.indexOf(r)+1;
const linkFor=(page=1,cls=activeClass)=>`/rankings?class=${encodeURIComponent(cls)}${q?`&q=${encodeURIComponent(q)}`:''}${page>1?`&page=${page}`:''}`;
const loadedTime=generatedAt.toLocaleTimeString(undefined,{hour:'numeric',minute:'2-digit'});
%>
<main class="lightPage">
  <section class="lightTitle rankingsHero">
    <div class="wrap pageHeroGrid">
      <div><div class="pageEyebrow">HALL://LIVE MYSQL + CHARACTER.WZ</div><h1>EVERLEAF RANKINGS.</h1><p>Real saved characters from the live game database. Levels, jobs, fame, EXP, and visible appearance are queried from the current EverLeaf world state.</p></div>
      <aside class="pageHeroAside rankingLiveAside"><strong><span class="rankingDbDot"></span> LIVE PROCESS</strong><span><%=fmt(totalRanked)%> matching characters // loaded <%=loadedTime%> // GM and banned accounts excluded.</span></aside>
    </div>
  </section>

  <div class="wrap rankingsPageV2">
    <section class="rankingStats" aria-label="Ranking summary">
      <div><small>RANKED CHARACTERS</small><strong><%=fmt(totalRanked)%></strong><span><%=classes[activeClass]?.label||'Overall'%></span></div>
      <div><small>HIGHEST LEVEL</small><strong><%=fmt(maxLevel)%></strong><span>CURRENT FILTER</span></div>
      <div><small>AVERAGE LEVEL</small><strong><%=totalRanked?Math.round(avgLevel):0%></strong><span>CURRENT FILTER</span></div>
      <div><small>PLAYERS ONLINE</small><strong><%=onlinePlayers==null?'—':fmt(onlinePlayers)%></strong><span>LIVE ACCOUNT STATE</span></div>
    </section>

    <div class="rankingsIntro"><div><div class="pageEyebrow">QUERY://LEADERBOARD</div><h2><%=classes[activeClass]?.label||'All Adventurers'%></h2><p class="muted">Sorted by level, then EXP, fame, and character name. Portraits use each player's saved Character.wz appearance.</p></div><aside class="rankingSeasonCard"><small>WORLD INSTANCE</small><strong>HALL OF LEGENDS</strong><span><%=fmt(totalRanked)%> record<%=totalRanked===1?'':'s'%> in this query.</span></aside></div>

    <form class="rankingSearch" method="get" action="/rankings">
      <input type="hidden" name="class" value="<%=activeClass%>">
      <div><span class="pageEyebrow">FIND CHARACTER</span><input type="search" name="q" value="<%=q%>" maxlength="20" placeholder="Character name…" aria-label="Search rankings by character name"></div>
      <button class="btn primary" type="submit">EXECUTE QUERY</button>
      <% if(q){ %><a class="btn" href="/rankings?class=<%=activeClass%>">CLEAR</a><% } %>
    </form>

    <nav class="tabs rankingTabs" aria-label="Ranking class filters"><% Object.entries(classes).forEach(([key,c])=>{ %><a class="tab <%=activeClass===key?'active':''%>" href="<%=linkFor(1,key)%>"><%=c.label%></a><% }) %></nav>
    <% if(error){ %><div class="error rankingError"><strong>RANKINGS UNAVAILABLE</strong><span><%=error%></span></div><% } %>

    <% if(!error&&topThree.length){ %>
      <section class="rankingPodium" aria-label="Top ranked adventurers">
        <% podiumOrder.forEach(r=>{ const rank=podiumRank(r); %>
          <article class="rankingPodiumCard">
            <span class="rankingPodiumRank">#<%=rank%></span>
            <div class="rankingPodiumArt rankingCharacterAvatar"><img src="<%=jobArt(r.jobName)%>" data-live-avatar="<%=avatar(r)%>" alt="<%=r.name%>'s EverLeaf character portrait"></div>
            <div><strong class="rankingPodiumName"><%=r.name%></strong><span class="rankingPodiumJob"><%=r.jobName||'Adventurer'%></span><span class="rankingPodiumLevel">LV. <%=fmt(r.level)%></span><span class="rankingLiveLook">LIVE SAVED APPEARANCE</span></div>
          </article>
        <% }) %>
      </section>
    <% } %>

    <section class="featurePanel rankingBoard rankingBoardV2">
      <div class="rankingBoardHead"><div><div class="pageEyebrow"><%=q?'SEARCH RESULT':'WORLD LEDGER'%></div><h2><%=q?`“${q}”`:(classes[activeClass]?.label||'All Adventurers')%></h2></div><div class="rankingLegend"><span>PAGE <%=currentPage%>/<%=totalPages||1%></span><span><%=fmt(totalRanked)%> TOTAL</span><span>LIVE MYSQL</span></div></div>
      <% if(rows.length){ %>
        <div class="tableWrap"><table class="rankingTable rankingTableV2"><thead><tr><th>RANK</th><th>ADVENTURER</th><th>JOB</th><th>LEVEL</th><th>FAME</th><th>EXP</th></tr></thead><tbody>
          <% rows.forEach((r,i)=>{ const rank=startRank+i+1; %><tr>
            <td class="rankPosition"><span class="rankPositionBadge">#<%=rank%></span></td>
            <td><div class="rankPlayer"><span class="rankPlayerIcon rankingCharacterAvatar"><img src="<%=jobArt(r.jobName)%>" data-live-avatar="<%=avatar(r)%>" loading="lazy" alt="<%=r.name%>'s EverLeaf character portrait"></span><span class="rankPlayerText"><strong><%=r.name%></strong><small>LIVE SAVED APPEARANCE</small></span></div></td>
            <td><span class="rankingJobBadge"><%=r.jobName||'Adventurer'%></span></td>
            <td><span class="rankLevelBlock"><strong>LV. <%=fmt(r.level)%></strong><small>LEVEL</small></span></td>
            <td class="rankingFame"><strong><%=fmt(r.fame)%></strong><small>FAME</small></td>
            <td class="rankingExp"><strong><%=fmt(r.exp)%></strong><small>EXP</small></td>
          </tr><% }) %>
        </tbody></table></div>
        <div class="rankingFooter"><div class="pagination"><% let prev=0; pageNumbers.forEach(p=>{ if(prev&&p-prev>1){ %><span class="pageGap">…</span><% } %><a class="pageBtn <%=p===currentPage?'active':''%>" href="<%=linkFor(p)%>"><%=p%></a><% prev=p; }); %><% if(currentPage<totalPages){ %><a class="pageBtn pageNext" href="<%=linkFor(currentPage+1)%>">NEXT →</a><% } %></div><p class="muted rankingRefresh">QUERY TIME // <%=loadedTime%></p></div>
      <% } else if(!error){ %><div class="rankingEmpty"><h3><%=q?'NO MATCHING CHARACTER.':'NO RECORDS.'%></h3><p><%=q?'Try another name or clear the search.':'No ranked adventurers are available in this class family yet.'%></p><% if(q){ %><a class="btn" href="/rankings?class=<%=activeClass%>">CLEAR SEARCH</a><% } %></div><% } %>
    </section>
  </div>
</main>
<%- include("partials/footer") %>
