<%- include("partials/header",{title:"Rankings"}) %>
<main class="lightPage"><section class="lightTitle"><div class="wrap pageHeroGrid"><div><div class="pageEyebrow">Hall of Legends</div><h1>Character Rankings</h1><p>See who is leading EverLeaf across every class family.</p></div><div class="pageHeroAside"><strong>Live progression</strong><span>Rankings refresh every 30 minutes so character levels may briefly trail in-game progress.</span></div></div></section><div class="wrap contentStack">
<div class="tabs"><% Object.entries(classes).forEach(([key,c])=>{ %><a class="tab <%=activeClass===key?'active':''%>" href="/rankings?class=<%=key%>"><%=c.label%></a><% }) %></div>
<% if(error){ %><div class="error"><%=error%></div><% } %>
<section class="featurePanel"><div style="display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:16px"><div><div class="pageEyebrow">Leaderboard</div><h2 style="margin:0"><%=classes[activeClass]&&classes[activeClass].label||'All Characters'%></h2></div><span class="kicker">Page <%=currentPage%> / <%=totalPages||1%></span></div><div class="tableWrap"><table><thead><tr><th>Rank</th><th>Character</th><th>Job</th><th>Level</th></tr></thead><tbody><% rows.forEach((r,i)=>{ %><tr><td><strong>#<%=startRank+i+1%></strong></td><td class="rankNameCell"><span class="rankAvatar"><%=r.name.charAt(0).toUpperCase()%></span><strong><%=r.name%></strong></td><td><%=r.jobName%></td><td><strong class="rankLvCell"><%=r.level%></strong></td></tr><% }) %></tbody></table></div><% if(!rows.length&&!error){ %><p class="muted">No ranked characters yet.</p><% } %><% if(rows.length){ %><div class="pagination"><% for(let p=1;p<=totalPages;p++){ %><a class="pageBtn <%=p===currentPage?'active':''%>" href="/rankings?class=<%=activeClass%>&page=<%=p%>"><%=p%></a><% } %><% if(currentPage<totalPages){ %><a class="pageBtn pageNext" href="/rankings?class=<%=activeClass%>&page=<%=currentPage+1%>">Next &rsaquo;</a><% } %></div><p class="muted" style="text-align:center;margin:14px 0 0;font-size:12px">Updated automatically every 30 minutes.</p><% } %></section>
</div></main><%- include("partials/footer") %>
