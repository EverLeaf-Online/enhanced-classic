<%- include("partials/header",{title:"Rankings"}) %>
<%
const jobArt=(name='')=>{
  const n=String(name).toLowerCase();
  if(/aran/.test(n)) return '/assets/jobs/special/aran.png';
  if(/evan/.test(n)) return '/assets/jobs/special/evan.png';
  if(/dawn warrior/.test(n)) return '/assets/jobs/cygnus/dawn-warrior.png';
  if(/blaze wizard/.test(n)) return '/assets/jobs/cygnus/blaze-wizard.png';
  if(/wind archer/.test(n)) return '/assets/jobs/cygnus/wind-archer.png';
  if(/night walker/.test(n)) return '/assets/jobs/cygnus/night-walker.png';
  if(/thunder breaker/.test(n)) return '/assets/jobs/cygnus/thunder-breaker.png';
  if(/cygnus|noblesse/.test(n)) return '/assets/jobs/special/cygnus.png';
  if(/warrior|fighter|crusader|hero|page|white knight|paladin|spearman|dragon knight|dark knight/.test(n)) return '/assets/jobs/instructors/warrior.png';
  if(/magician|wizard|mage|cleric|priest|bishop/.test(n)) return '/assets/jobs/instructors/magician.png';
  if(/bowman|archer|hunter|ranger|bowmaster|crossbow|sniper|marksman/.test(n)) return '/assets/jobs/instructors/bowman.png';
  if(/thief|rogue|assassin|hermit|night lord|bandit|chief bandit|shadower/.test(n)) return '/assets/jobs/instructors/thief.png';
  if(/pirate|brawler|marauder|buccaneer|gunslinger|outlaw|corsair/.test(n)) return '/assets/jobs/instructors/pirate.png';
  return '/assets/everleaf-remaster.svg';
};
const topThree=(currentPage===1?rows.slice(0,3):[]);
const podiumOrder=topThree.length>=3?[topThree[1],topThree[0],topThree[2]]:topThree;
const podiumRank=(r)=>rows.indexOf(r)+1;
const podiumClass=(rank)=>rank===1?'first':rank===2?'second':'third';
%>
<main class="lightPage">
<section class="lightTitle"><div class="wrap pageHeroGrid"><div><div class="pageEyebrow">Hall of Legends</div><h1>EverLeaf Rankings</h1><p>See who is leading Maple World and explore the strongest adventurers across every class family.</p></div><div class="pageHeroAside"><strong>Live progression board</strong><span>Rankings refresh every 30 minutes. Newly earned levels may take a short time to appear.</span></div></div></section>
<div class="wrap contentStack rankingsPageV2" style="padding-bottom:65px">
<div class="rankingsIntro"><div><div class="sectionHead"><div><div class="pageEyebrow">CLASS LEADERBOARDS</div><h2><%=classes[activeClass]&&classes[activeClass].label||'All Adventurers'%></h2></div></div><p class="muted">Compare levels across EverLeaf's classic Adventurers, Cygnus Knights, Aran, Evan, and every supported advancement path.</p></div><aside class="rankingSeasonCard"><small>EverLeaf World</small><strong>Hall of Legends</strong><span>Twenty channels. One leaderboard. Keep climbing and claim your place among Maple World's strongest adventurers.</span></aside></div>
<nav class="tabs rankingTabs" aria-label="Ranking class filters"><% Object.entries(classes).forEach(([key,c])=>{ %><a class="tab <%=activeClass===key?'active':''%>" href="/rankings?class=<%=key%>"><%=c.label%></a><% }) %></nav>
<% if(error){ %><div class="error rankingError"><strong>Rankings unavailable</strong><span><%=error%></span></div><% } %>
<% if(!error&&currentPage===1&&topThree.length){ %><section class="rankingPodium" aria-label="Top ranked adventurers"><% podiumOrder.forEach(r=>{ const rank=podiumRank(r); %><article class="rankingPodiumCard <%=podiumClass(rank)%>"><span class="rankingPodiumRank">#<%=rank%></span><div class="rankingPodiumArt"><img src="<%=jobArt(r.jobName)%>" alt="<%=r.jobName||'EverLeaf'%> class artwork"></div><div><strong class="rankingPodiumName"><%=r.name%></strong><span class="rankingPodiumJob"><%=r.jobName||'Adventurer'%></span><span class="rankingPodiumLevel">Level <%=r.level%></span></div></article><% }) %></section><% } %>
<section class="featurePanel rankingBoard rankingBoardV2"><div class="rankingBoardHead"><div><div class="pageEyebrow">WORLD RANKING</div><h2><%=classes[activeClass]&&classes[activeClass].label||'All Adventurers'%></h2></div><div class="rankingLegend"><span>Page <%=currentPage%> / <%=totalPages||1%></span><span>30 min refresh</span></div></div>
<% if(rows.length){ %><div class="tableWrap"><table class="rankingTable rankingTableV2"><thead><tr><th>Rank</th><th>Adventurer</th><th>Job</th><th>Level</th></tr></thead><tbody><% rows.forEach((r,i)=>{ const rank=startRank+i+1; %><tr><td class="rankPosition"><span class="rankPositionBadge <%=rank<=3?'top'+rank:''%>">#<%=rank%></span></td><td><div class="rankPlayer"><span class="rankPlayerIcon"><img src="<%=jobArt(r.jobName)%>" alt=""></span><span class="rankPlayerText"><strong><%=r.name%></strong><small>EverLeaf adventurer</small></span></div></td><td><span class="rankingJobBadge"><%=r.jobName||'Adventurer'%></span></td><td><span class="rankLevelBlock"><strong>Lv. <%=r.level%></strong><small>Character level</small></span></td></tr><% }) %></tbody></table></div><div class="rankingFooter"><div class="pagination"><% for(let p=1;p<=totalPages;p++){ %><a class="pageBtn <%=p===currentPage?'active':''%>" href="/rankings?class=<%=activeClass%>&page=<%=p%>"><%=p%></a><% } %><% if(currentPage<totalPages){ %><a class="pageBtn pageNext" href="/rankings?class=<%=activeClass%>&page=<%=currentPage+1%>">Next ›</a><% } %></div><p class="muted rankingRefresh">Leaderboard data refreshes automatically every 30 minutes.</p></div><% } else if(!error){ %><div class="rankingEmpty"><img src="/assets/ui/trophy.svg" alt=""><h3>No legends here yet.</h3><p>No ranked adventurers are available in this class family yet. Be the first to claim the board.</p></div><% } %>
</section>
</div></main><%- include("partials/footer") %>
