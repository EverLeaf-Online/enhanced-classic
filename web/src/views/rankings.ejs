<%- include("partials/header",{title:"Rankings",description:"Live EverLeaf character rankings powered by the game database."}) %>
<%
const jobArt=(name='')=>{
  const n=String(name).toLowerCase();
  if(/beginner|legend/.test(n)) return '/assets/jobs/beginner/beginner-clean.png';
  if(/aran/.test(n)) return '/assets/jobs/special/aran.png';
  if(/evan/.test(n)) return '/assets/jobs/special/evan.png';
  if(/dawn warrior/.test(n)) return '/assets/jobs/cygnus/dawn-warrior.png';
  if(/blaze wizard/.test(n)) return '/assets/jobs/cygnus/blaze-wizard.png';
  if(/wind archer/.test(n)) return '/assets/jobs/cygnus/wind-archer.png';
  if(/night walker/.test(n)) return '/assets/jobs/cygnus/night-walker.png';
  if(/thunder breaker/.test(n)) return '/assets/jobs/cygnus/thunder-breaker.png';
  if(/cygnus|noblesse/.test(n)) return '/assets/jobs/special/cygnus-clean.png';
  if(/warrior|fighter|crusader|hero|page|white knight|paladin|spearman|dragon knight|dark knight/.test(n)) return '/assets/jobs/instructors/warrior.png';
  if(/magician|wizard|mage|cleric|priest|bishop/.test(n)) return '/assets/jobs/instructors/magician.png';
  if(/bowman|archer|hunter|ranger|bowmaster|crossbow|sniper|marksman/.test(n)) return '/assets/jobs/instructors/bowman.png';
  if(/thief|rogue|assassin|hermit|night lord|bandit|chief bandit|shadower/.test(n)) return '/assets/jobs/instructors/thief.png';
  if(/pirate|brawler|marauder|buccaneer|gunslinger|outlaw|corsair/.test(n)) return '/assets/jobs/instructors/pirate.png';
  return '/assets/everleaf-mark-2026.svg';
};
const avatar=(r)=>`/character-avatar/${Number(r.id)}.png?job=${Number(r.job||0)}`;
const fmt=n=>Number(n||0).toLocaleString();
const topThree=(currentPage===1&&!q?rows.slice(0,3):[]);
const linkFor=(page=1,cls=activeClass)=>`/rankings?class=${encodeURIComponent(cls)}${q?`&q=${encodeURIComponent(q)}`:''}${page>1?`&page=${page}`:''}`;
const loadedTime=generatedAt.toLocaleTimeString(undefined,{hour:'numeric',minute:'2-digit'});
%>
<main class="lightPage rankingsPage">
  <section class="lightTitle visualPageTitle rankingsTitle">
    <div class="wrap pageHeroGrid">
      <div>
        <div class="pageEyebrow">EverLeaf Leaderboard</div>
        <h1>Rankings</h1>
        <p>Track the strongest adventurers across EverLeaf. Search any character or filter the live ladder by job family.</p>
      </div>
    </div>
  </section>

  <div class="wrap rankingsViewport">
    <div class="rankingsToolbar">
      <form class="rankingsSearchInline" method="get" action="/rankings">
        <input type="hidden" name="class" value="<%=activeClass%>">
        <input type="search" name="q" value="<%=q%>" maxlength="20" placeholder="Search character name" aria-label="Search rankings by character name">
        <button class="btn primary" type="submit">SEARCH</button>
        <% if(q){ %><a class="btn" href="/rankings?class=<%=activeClass%>">CLEAR</a><% } %>
      </form>

      <div class="rankingsInlineStats" aria-label="Ranking summary">
        <div><span>Ranked</span><strong><%=fmt(totalRanked)%></strong></div>
        <div><span>Top level</span><strong><%=fmt(maxLevel)%></strong></div>
        <div><span>Online</span><strong><%=onlinePlayers==null?'—':fmt(onlinePlayers)%></strong></div>
        <div class="rankingsUpdated"><span>Updated</span><strong><%=loadedTime%></strong></div>
      </div>
    </div>

    <nav class="tabs rankingsClassTabs" aria-label="Ranking class filters">
      <% Object.entries(classes).forEach(([key,c])=>{ %>
        <a class="tab <%=activeClass===key?'active':''%>" href="<%=linkFor(1,key)%>"><%=c.label%></a>
      <% }) %>
    </nav>

    <% if(error){ %>
      <div class="error rankingsError"><strong>Rankings unavailable.</strong> <span><%=error%></span></div>
    <% } %>

    <div class="contentGrid rankingsWorkspace <%=topThree.length?'hasLeaders':'boardOnly'%>">
      <section class="featurePanel rankingsBoardPanel" id="ranking-board">
        <div class="rankingsBoardHead">
          <div>
            <div class="pageEyebrow"><%=q?'Search Results':'World Ranking'%></div>
            <h2><%=q?`Characters matching “${q}”`:(classes[activeClass]&&classes[activeClass].label||'All Adventurers')%></h2>
          </div>
          <span>Page <%=currentPage%> of <%=totalPages||1%></span>
        </div>

        <% if(rows.length){ %>
          <div class="tableWrap rankingsTableWrap">
            <table class="rankingsTable">
              <thead>
                <tr><th>Rank</th><th>Character</th><th>Job</th><th>Level</th><th>Fame</th><th>EXP</th></tr>
              </thead>
              <tbody>
                <% rows.forEach((r,i)=>{ const rank=startRank+i+1; %>
                  <tr>
                    <td><span class="rankingsPlace <%=rank<=3?'top'+rank:''%>"><%=rank%></span></td>
                    <td>
                      <div class="rankingsCharacter">
                        <span class="rankingsCharacterAvatar rankingCharacterAvatar"><img src="<%=jobArt(r.jobName)%>" data-live-avatar="<%=avatar(r)%>" loading="lazy" alt="<%=r.name%>'s EverLeaf character portrait"></span>
                        <strong><%=r.name%></strong>
                      </div>
                    </td>
                    <td><span class="rankingsJob"><%=r.jobName||'Adventurer'%></span></td>
                    <td class="rankingsLevel">Lv. <%=fmt(r.level)%></td>
                    <td><%=fmt(r.fame)%></td>
                    <td><%=fmt(r.exp)%></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <div class="rankingsPagination">
            <div class="pagination">
              <% let prev=0; pageNumbers.forEach(p=>{ if(prev&&p-prev>1){ %><span class="pageGap">…</span><% } %><a class="pageBtn <%=p===currentPage?'active':''%>" href="<%=linkFor(p)%>"><%=p%></a><% prev=p; }); %>
              <% if(currentPage<totalPages){ %><a class="pageBtn pageNext" href="<%=linkFor(currentPage+1)%>">Next ›</a><% } %>
            </div>
            <span><%=fmt(totalRanked)%> ranked characters</span>
          </div>
        <% } else if(!error){ %>
          <div class="rankingsEmpty">
            <h3><%=q?'No matching character':'No ranked characters yet'%></h3>
            <p><%=q?'Try another name or clear the search.':'There are no characters in this leaderboard yet.'%></p>
            <% if(q){ %><a class="btn" href="/rankings?class=<%=activeClass%>">CLEAR SEARCH</a><% } %>
          </div>
        <% } %>
      </section>

      <% if(topThree.length){ %>
        <aside class="contentStack rankingsAside">
          <section class="paperCard rankingsLeadersPanel">
            <div class="rankingsLeadersHead">
              <div>
                <div class="pageEyebrow">Top 3</div>
                <h2>Leading Adventurers</h2>
              </div>
              <span>Live character appearances</span>
            </div>

            <div class="rankingsLeaderList">
              <% topThree.forEach((r,i)=>{ const rank=i+1; %>
                <article class="rankingsLeaderRow rank<%=rank%>">
                  <div class="rankingsLeaderNumber">#<%=rank%></div>
                  <span class="rankingsLeaderAvatar rankingCharacterAvatar"><img src="<%=jobArt(r.jobName)%>" data-live-avatar="<%=avatar(r)%>" alt="<%=r.name%>'s EverLeaf character portrait"></span>
                  <div class="rankingsLeaderCopy">
                    <strong><%=r.name%></strong>
                    <span><%=r.jobName||'Adventurer'%></span>
                    <div><b>Lv. <%=fmt(r.level)%></b><small><%=fmt(r.fame)%> Fame</small></div>
                  </div>
                </article>
              <% }) %>
            </div>
          </section>
        </aside>
      <% } %>
    </div>
  </div>
</main>
<%- include("partials/footer") %>
