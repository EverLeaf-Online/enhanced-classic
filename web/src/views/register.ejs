<%- include("partials/header",{title:"Register"}) %><main class="authWrap"><div class="authGrid">
<div class="authCard"><h2>Login</h2><p class="muted">Already have an account? Sign in here.</p>
<form method="post" action="/login"><label>Username</label><input name="username" autocomplete="username" required><label>Password</label><input type="password" name="password" autocomplete="current-password" required><button class="btn primary">LOGIN</button></form>
</div>
<div class="authCard"><h2>Create Account</h2><% if(!enabled){%><div class="notice">Registration is disabled by server configuration.</div><%}%><% if(error){%><div class="error"><%=error%></div><%}%>
<form method="post"><label>Username</label><input name="username" minlength="4" maxlength="13" pattern="[A-Za-z0-9_]+" autocomplete="username" required><label>Email</label><input type="email" name="email" autocomplete="email" required><label>Password</label><input type="password" name="password" minlength="8" maxlength="12" autocomplete="new-password" required><p class="muted">Use 8-12 characters so the password works in the v83 game client.</p><label>Confirm Password</label><input type="password" name="confirmPassword" minlength="8" maxlength="12" autocomplete="new-password" required><label style="display:flex;gap:8px;align-items:flex-start;font-size:12px"><input type="checkbox" name="agree" value="yes" style="width:auto;margin-top:2px" required><span>I agree to the <a href="/terms" style="color:#2f9b43">Terms of Service</a>.</span></label><button class="btn primary" <%=enabled?"":"disabled"%>>REGISTER</button></form>
</div>
</div></main><%- include("partials/footer") %>
