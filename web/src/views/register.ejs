<%- include("partials/header",{title:"Register"}) %><main class="authWrap"><div class="authGrid"><section class="authIntro"><img src="/assets/everleaf-logo.webp" alt="EverLeaf"><div class="pageEyebrow">Create Your Account</div><h1>Start your EverLeaf story.</h1><p>Create one account for both the website and game client, then download the launcher and enter Maple World.</p><div class="miniGrid" style="margin-top:18px"><div class="miniCard"><strong>v83</strong><span>Enhanced Classic</span></div><div class="miniCard"><strong>20</strong><span>Live channels</span></div><div class="miniCard"><strong>Free</strong><span>No pay-to-win</span></div></div></section><div class="authCard"><h2>Create Account</h2><% if(!enabled){%><div class="notice">Registration is disabled by server configuration.</div><%}%><% if(error){%><div class="error"><%=error%></div><%}%><form method="post"><label>Username</label><input name="username" minlength="4" maxlength="13" pattern="[A-Za-z0-9_]+" autocomplete="username" required><label>Email</label><input type="email" name="email" autocomplete="email" required><label>Password</label><input type="password" name="password" minlength="8" maxlength="12" autocomplete="new-password" aria-describedby="register-password-help" required><p id="register-password-help" class="muted">Use 8-12 characters so your password works in the v83 game client.</p><label>Confirm Password</label><input type="password" name="confirmPassword" minlength="8" maxlength="12" autocomplete="new-password" required><label style="display:flex;gap:8px;align-items:flex-start;font-size:12px"><input type="checkbox" name="agree" value="yes" style="width:auto;margin-top:2px" required><span>I agree to the <a href="/terms" style="color:#2f9b43;font-weight:800">Terms of Service</a>.</span></label><button class="btn primary" <%=enabled?"":"disabled"%>>CREATE ACCOUNT</button></form><p class="muted" style="margin-top:18px">Already registered? <a href="/login" style="color:#2f9b43;font-weight:800">Sign in instead.</a></p></div></div></main><%- include("partials/footer") %>
