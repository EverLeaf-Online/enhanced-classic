<%- include("partials/header",{title:"CMS Account Recovery"}) %>
<main class="lightPage">
  <section class="lightTitle"><div class="wrap"><div class="pageEyebrow">CMS://RECOVERY INCIDENTS</div><h1>RECOVERY<br>QUEUE.</h1><p>Review private player recovery requests and track staff resolution state.</p></div></section>
  <%- include("partials/admin-manager-nav") %>
  <div class="cmsWorkspaceSingle">
    <section class="cmsPanel">
      <div class="cmsPanelHeader"><div class="tabs" style="margin:0"><a class="tab <%=status==='pending'?'active':''%>" href="/admin/recoveries?status=pending">PENDING (<%=counts.pending||0%>)</a><a class="tab <%=status==='resolved'?'active':''%>" href="/admin/recoveries?status=resolved">RESOLVED (<%=counts.resolved||0%>)</a><a class="tab <%=status==='rejected'?'active':''%>" href="/admin/recoveries?status=rejected">REJECTED (<%=counts.rejected||0%>)</a></div></div>
      <p class="muted">Verify ownership through trusted account information or Discord before making any account change.</p>
      <% rows.forEach(item=>{ %><div class="cmsItem"><div><span class="pageEyebrow">REQUEST #<%=item.id%> // <%=item.created_at%></span><strong><%=item.username||'USERNAME NOT PROVIDED'%></strong><div class="cmsMeta">EMAIL // <%=item.email||'NOT PROVIDED'%></div></div><form method="post" action="/admin/recoveries/<%=item.id%>/status" style="min-width:210px"><label>Resolution state</label><select name="status"><option value="pending" <%=item.status==='pending'?'selected':''%>>Pending</option><option value="resolved" <%=item.status==='resolved'?'selected':''%>>Resolved</option><option value="rejected" <%=item.status==='rejected'?'selected':''%>>Rejected</option></select><button class="btn small">UPDATE STATE</button></form></div><% }) %>
      <% if(!rows.length){ %><p class="muted">NO <%=String(status).toUpperCase()%> RECOVERY REQUESTS.</p><% } %>
    </section>
  </div>
</main>
<%- include("partials/footer") %>
