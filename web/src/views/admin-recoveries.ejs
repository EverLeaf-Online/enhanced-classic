<%- include("partials/header",{title:"CMS Account Recovery"}) %><main class="lightPage"><div class="lightTitle"><div class="wrap"><h1>Account Recovery Queue</h1><p>Review player recovery requests without exposing account existence publicly.</p></div></div><div class="wrap" style="max-width:1050px"><div class="paperCard"><div style="display:flex;justify-content:space-between;align-items:center;gap:12px"><div class="tabs" style="margin:0"><a class="tab <%=status==='pending'?'active':''%>" href="/admin/recoveries?status=pending">Pending (<%=counts.pending||0%>)</a><a class="tab <%=status==='resolved'?'active':''%>" href="/admin/recoveries?status=resolved">Resolved (<%=counts.resolved||0%>)</a><a class="tab <%=status==='rejected'?'active':''%>" href="/admin/recoveries?status=rejected">Rejected (<%=counts.rejected||0%>)</a></div><a class="btn small" href="/admin">Dashboard</a></div><p class="muted">Verify ownership through trusted account information or Discord before making any credential change. Never ask players to send their current password.</p><% rows.forEach(item=>{ %><div class="adminRow"><div style="display:flex;justify-content:space-between;gap:12px;align-items:flex-start"><div><strong>Request #<%=item.id%></strong><div class="muted">Username: <%=item.username||'Not provided'%></div><div class="muted">Email: <%=item.email||'Not provided'%></div><div class="muted">Submitted: <%=item.created_at%></div></div><form method="post" action="/admin/recoveries/<%=item.id%>/status" style="min-width:180px"><select name="status"><option value="pending" <%=item.status==='pending'?'selected':''%>>Pending</option><option value="resolved" <%=item.status==='resolved'?'selected':''%>>Resolved</option><option value="rejected" <%=item.status==='rejected'?'selected':''%>>Rejected</option></select><button class="btn small">Update</button></form></div></div><% }) %><% if(!rows.length){ %><p class="muted">No <%=status%> recovery requests.</p><% } %></div></div></main><%- include("partials/footer") %>
