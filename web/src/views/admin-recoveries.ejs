<%- include("partials/header",{title:"CMS Account Recovery"}) %><main class="lightPage"><section class="lightTitle"><div class="wrap"><div class="pageEyebrow">CMS Workspace</div><h1>Account Recovery Queue</h1><p>Review private player recovery requests and track their resolution state.</p></div></section><%- include("partials/admin-manager-nav") %><div class="cmsWorkspaceSingle"><section class="cmsPanel"><div class="cmsPanelHeader"><div class="tabs" style="margin:0"><a class="tab <%=status==='pending'?'active':''%>" href="/admin/recoveries?status=pending">Pending (<%=counts.pending||0%>)</a><a class="tab <%=status==='resolved'?'active':''%>" href="/admin/recoveries?status=resolved">Resolved (<%=counts.resolved||0%>)</a><a class="tab <%=status==='rejected'?'active':''%>" href="/admin/recoveries?status=rejected">Rejected (<%=counts.rejected||0%>)</a></div></div><p class="muted">Verify ownership through trusted account information or Discord before making any account change.</p><% rows.forEach(item=>{ %><div class="cmsItem"><div><strong>Request #<%=item.id%></strong><div class="cmsMeta">Username: <%=item.username||'Not provided'%></div><div class="cmsMeta">Email: <%=item.email||'Not provided'%></div><div class="cmsMeta">Submitted: <%=item.created_at%></div></div><form method="post" action="/admin/recoveries/<%=item.id%>/status" style="min-width:190px"><select name="status"><option value="pending" <%=item.status==='pending'?'selected':''%>>Pending</option><option value="resolved" <%=item.status==='resolved'?'selected':''%>>Resolved</option><option value="rejected" <%=item.status==='rejected'?'selected':''%>>Rejected</option></select><button class="btn small">UPDATE STATUS</button></form></div><% }) %><% if(!rows.length){ %><p class="muted">No <%=status%> recovery requests.</p><% } %></section></div></main><%- include("partials/footer") %>
