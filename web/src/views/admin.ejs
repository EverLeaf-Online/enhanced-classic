<%- include("partials/header",{title:"CMS"}) %><main class="adminShell">
<aside class="sidebar"><div class="sideLogo">🍃 EverLeaf CMS</div><a class="sideLink active" href="/admin"><span class="sideIcon">🏠</span>Dashboard</a><a class="sideLink" href="#news"><span class="sideIcon">📰</span>News</a><a class="sideLink" href="#announcements"><span class="sideIcon">📣</span>Announcements</a><a class="sideLink" href="#downloads"><span class="sideIcon">⬇</span>Downloads</a><a class="sideLink" href="/admin/pages"><span class="sideIcon">📄</span>Pages</a><a class="sideLink" href="#users"><span class="sideIcon">👤</span>Users</a><a class="sideLink" href="#donations"><span class="sideIcon">💲</span>Donations</a><a class="sideLink" href="#settings"><span class="sideIcon">⚙</span>Settings</a><a class="sideLink" href="#logs"><span class="sideIcon">🗒</span>Logs</a><form method="post" action="/admin/logout"><button class="btn small sideLogout"><span class="sideIcon">↩</span>Logout</button></form></aside>
<section class="adminMain"><div class="adminTop"><div><h1 style="margin:0">Dashboard</h1><div class="muted">EverLeaf website and server overview</div></div><span class="kicker"><%=status.online?'Server Online':'Server Offline'%></span></div>
<div class="stats"><div class="stat"><div class="statNum"><%=players%></div><div>Players Online</div></div><div class="stat"><div class="statNum"><%=accounts%></div><div>Accounts</div></div><div class="stat"><div class="statNum"><%=posts.length%></div><div>News Posts</div></div><div class="stat"><div class="statNum">$<%=(donationTotal/100).toFixed(2)%></div><div>Total Donations</div></div></div>
<div class="adminGrid">
<div class="adminCard"><h3>Supporter Management</h3><p class="muted">Search payment records, review refunds, and retry Discord role synchronization.</p><a class="btn small" href="/admin/supporters">Open Supporter Management</a></div>
<div class="adminCard" id="news"><div style="display:flex;justify-content:space-between;align-items:center"><h3>Recent News</h3><span class="muted"><%=posts.length%> total</span></div><% posts.slice(0,8).forEach(p=>{ %><div class="adminRow" style="display:flex;justify-content:space-between;gap:10px"><div><strong><%=p.title%></strong><div class="muted"><%=p.type%> · <%=p.published?'Published':'Draft'%></div></div><div><a class="btn small" href="/admin/posts/<%=p.id%>/edit">Edit</a></div></div><% }) %><% if(!posts.length){%><p class="muted">No posts yet.</p><%}%></div>
<div class="adminCard"><h3>Server Status</h3><div class="adminRow">Login Server <strong style="float:right"><%=status.online?'Online':'Offline'%></strong></div><div class="adminRow">Channels <strong style="float:right"><%=status.channels%>/<%=status.totalChannels%></strong></div><div class="adminRow">Players Online <strong style="float:right"><%=players%></strong></div><div class="adminRow">Launcher Manifest <strong style="float:right">Ready</strong></div></div>
<div class="adminCard"><h3>Publish News / Patch Note</h3><form method="post" action="/admin/posts"><label>Title</label><input name="title" required><label>Slug</label><input name="slug"><label>Excerpt</label><textarea name="excerpt"></textarea><label>Body</label><textarea name="body"></textarea><label>Type</label><select name="type"><option>news</option><option>patch</option><option>event</option></select><label style="display:flex;gap:8px"><input style="width:auto" type="checkbox" name="published" checked> Published</label><button class="btn primary">Publish</button></form></div>
<div class="adminCard" id="users"><h3>Newest Accounts</h3><% recentAccounts.forEach(a=>{ %><div class="adminRow"><strong><%=a.name%></strong><span class="muted" style="float:right"><%=a.banned?'Banned':'Active'%></span><div class="muted"><%=a.createdat||''%></div></div><% }) %><% if(!recentAccounts.length){%><p class="muted">Game database unavailable or no accounts yet.</p><%}%></div>
<div class="adminCard" id="announcements"><h3>Announcements</h3><form method="post" action="/admin/announcements"><input name="title" placeholder="Title" required><textarea name="body" placeholder="Announcement"></textarea><label style="display:flex;gap:8px"><input style="width:auto" type="checkbox" name="active" checked> Active</label><button class="btn primary">Add Announcement</button></form><% announcements.forEach(a=>{ %><div class="adminRow"><strong><%=a.title%></strong><form method="post" action="/admin/announcements/<%=a.id%>/delete" style="float:right"><button class="btn small">Delete</button></form></div><% }) %></div>
<div class="adminCard" id="downloads"><h3>Downloads & Launcher</h3><form method="post" action="/admin/downloads"><input name="name" placeholder="Name" required><textarea name="description" placeholder="Description"></textarea><input name="url" placeholder="Download URL" required><select name="kind"><option>launcher</option><option>client</option><option>patch</option><option>tool</option></select><input name="version" placeholder="Version"><label style="display:flex;gap:8px"><input style="width:auto" type="checkbox" name="published" checked> Published</label><button class="btn primary">Add Download</button></form><% downloads.slice(0,5).forEach(d=>{ %><div class="adminRow"><strong><%=d.name%></strong><span class="muted"> · <%=d.version%></span></div><% }) %></div>
<div class="adminCard" id="donations"><h3>Supporter Payments</h3><% if(syncStatus){%><div class="<%=['assigned','linked'].includes(syncStatus)?'notice':'error'%>">Discord role synchronization: <%=syncStatus%>.</div><%}%><div class="adminRow"><strong>Confirmed net support</strong><span style="float:right">$<%=(supporterSummary.confirmedCents/100).toFixed(2)%></span><div class="muted"><%=supporterSummary.paidCount%> paid · <%=supporterSummary.refundedCount%> refunded/partially refunded · <%=supporterSummary.pendingCount%> pending · <%=supporterSummary.failedCount%> failed</div></div><% paymentOrders.forEach(d=>{ %><div class="adminRow"><strong><%=d.game_account_name%></strong><span style="float:right">$<%=((d.amount_cents-d.refunded_cents)/100).toFixed(2)%> net</span><div class="muted"><%=d.provider%> · <%=d.status%><% if(d.refunded_cents){%> · $<%=(d.refunded_cents/100).toFixed(2)%> refunded<%}%> · <%=d.created_at%></div></div><% }) %><% if(!paymentOrders.length){%><p class="muted">No payment orders yet.</p><%}%><h3 style="margin-top:18px">Supporter Profiles</h3><% supporterProfiles.forEach(s=>{ %><div class="adminRow"><strong><%=s.game_account_name%></strong><span style="float:right">$<%=(s.lifetime_cents/100).toFixed(2)%></span><div class="muted">Discord: <%=s.discord_role_status%></div><% if(s.discord_user_id&&((s.lifetime_cents>0&&s.discord_role_status!=='assigned')||(s.lifetime_cents<=0&&s.discord_role_status!=='linked'))){%><form method="post" action="/admin/supporters/<%=s.game_account_id%>/sync-discord" style="margin-top:8px"><button class="btn small">Retry Discord Role</button></form><%}%></div><%})%><% if(!supporterProfiles.length){%><p class="muted">No confirmed supporters yet.</p><%}%></div>
<div class="adminCard" id="settings"><h3>Site Settings</h3><form method="post" action="/admin/settings"><label>Hero title</label><input name="hero_title" value="<%=site.hero_title%>"><label>Hero subtitle</label><textarea name="hero_subtitle"><%=site.hero_subtitle%></textarea><label>Announcement</label><textarea name="announcement"><%=site.announcement%></textarea><label>Maintenance message</label><textarea name="maintenance_message"><%=site.maintenance_message%></textarea><label>Footer note</label><textarea name="footer_note"><%=site.footer_note%></textarea><button class="btn primary">Save Settings</button></form></div>
<div class="adminCard" id="pages"><h3>Pages</h3><p class="muted"><%=pages.length%> CMS-managed page<%=pages.length===1?'':'s'%>. About, Rules, Terms, and custom public pages can now be edited without touching templates.</p><a class="btn small" href="/admin/pages">Manage Pages</a></div>
<div class="adminCard" id="logs"><h3>Admin Activity</h3><% auditLog.forEach(entry=>{ %><div class="adminRow"><strong><%=entry.action%></strong><div class="muted"><%=entry.details||''%><%=entry.details?' · ':''%><%=entry.created_at%></div></div><%})%><% if(!auditLog.length){%><p class="muted">No recorded admin actions yet.</p><%}%></div>
</div></section></main><%- include("partials/footer") %>
