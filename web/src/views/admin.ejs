<%- include("partials/header",{title:"CMS"}) %><main class="adminShell">
<aside class="sidebar"><div class="sideLogo">🍃 EverLeaf CMS</div><a class="sideLink active" href="/admin"><span class="sideIcon">🏠</span>Overview</a><a class="sideLink" href="/admin/news"><span class="sideIcon">📰</span>News</a><a class="sideLink" href="/admin/announcements"><span class="sideIcon">📣</span>Announcements</a><a class="sideLink" href="/admin/downloads"><span class="sideIcon">⬇</span>Downloads</a><a class="sideLink" href="/admin/pages"><span class="sideIcon">📄</span>Pages</a><a class="sideLink" href="/admin/recoveries"><span class="sideIcon">🔑</span>Recovery</a><a class="sideLink" href="/admin/supporters"><span class="sideIcon">💲</span>Supporters</a><a class="sideLink" href="/admin/settings-view"><span class="sideIcon">⚙</span>Settings</a><a class="sideLink" href="/admin/audit"><span class="sideIcon">🗒</span>Audit Log</a><a class="sideLink" href="/" target="_blank" rel="noopener"><span class="sideIcon">↗</span>View Site</a><form method="post" action="/admin/logout"><button class="btn small sideLogout"><span class="sideIcon">↩</span>Logout</button></form></aside>
<section class="adminMain"><div class="adminTop"><div><div class="pageEyebrow">Control Center</div><h1 style="margin:0">EverLeaf CMS</h1><div class="muted">Content, community, account support, and server visibility.</div></div><span class="kicker"><%=status.online?'Server Online':'Server Offline'%></span></div>
<div class="adminQuickActions"><a class="btn small primary" href="/admin/news">+ New Post</a><a class="btn small" href="/admin/announcements">Announcement</a><a class="btn small" href="/admin/downloads">Downloads</a><a class="btn small" href="/admin/pages">Pages</a><a class="btn small" href="/admin/recoveries">Recovery Queue</a><a class="btn small" href="/admin/settings-view">Site Settings</a></div>
<div class="stats"><div class="stat"><div class="statNum"><%=players%></div><div>Players Online</div></div><div class="stat"><div class="statNum"><%=accounts%></div><div>Total Accounts</div></div><div class="stat"><div class="statNum"><%=posts.filter(p=>p.published).length%></div><div>Published Posts</div></div><div class="stat"><div class="statNum">$<%=(donationTotal/100).toFixed(2)%></div><div>Confirmed Support</div></div></div>
<div class="adminGrid">
<section class="adminCard"><div class="pageEyebrow">Publishing</div><h3>Content Library</h3><div class="adminRow">News <strong style="float:right"><%=posts.filter(p=>p.published).length%>/<%=posts.length%> live</strong></div><div class="adminRow">Downloads <strong style="float:right"><%=downloads.filter(d=>d.published).length%>/<%=downloads.length%> live</strong></div><div class="adminRow">Pages <strong style="float:right"><%=pages.filter(p=>p.published).length%>/<%=pages.length%> live</strong></div><div class="adminRow">Announcements <strong style="float:right"><%=announcements.filter(a=>a.active).length%> active</strong></div><div class="adminQuickActions"><a class="btn small" href="/admin/news">Manage News</a><a class="btn small" href="/admin/pages">Manage Pages</a></div></section>
<section class="adminCard"><div class="pageEyebrow">Runtime</div><h3>Server Health</h3><div class="adminRow">Login Server <strong style="float:right"><%=status.online?'Online':'Offline'%></strong></div><div class="adminRow">Channels <strong style="float:right"><%=status.channels%>/<%=status.totalChannels%></strong></div><div class="adminRow">Players Online <strong style="float:right"><%=players%></strong></div><div class="adminRow">Launcher Manifest <strong style="float:right">Ready</strong></div><div class="adminRow">Website <strong style="float:right">Online</strong></div></section>
<section class="adminCard"><div style="display:flex;justify-content:space-between;gap:12px;align-items:center"><div><div class="pageEyebrow">Editorial</div><h3>Recent News</h3></div><a class="btn small" href="/admin/news">All Posts</a></div><% posts.slice(0,6).forEach(p=>{ %><div class="adminRow" style="display:flex;justify-content:space-between;gap:10px"><div><strong><%=p.title%></strong><div class="muted"><%=p.type%> · <%=p.published?'Published':'Draft'%></div></div><a class="btn small" href="/admin/posts/<%=p.id%>/edit">Edit</a></div><% }) %><% if(!posts.length){%><p class="muted">No posts yet.</p><%}%></section>
<section class="adminCard"><div class="pageEyebrow">Players</div><h3>Newest Accounts</h3><% recentAccounts.slice(0,6).forEach(a=>{ %><div class="adminRow"><strong><%=a.name%></strong><span class="muted" style="float:right"><%=a.banned?'Banned':'Active'%></span><div class="muted"><%=a.createdat||''%></div></div><% }) %><% if(!recentAccounts.length){%><p class="muted">Game database unavailable or no accounts yet.</p><%}%></section>
<section class="adminCard"><div class="pageEyebrow">Community</div><h3>Supporter Operations</h3><div class="miniGrid"><div class="miniCard"><strong><%=supporterSummary.paidCount%></strong><span>Paid</span></div><div class="miniCard"><strong><%=supporterSummary.pendingCount%></strong><span>Pending</span></div><div class="miniCard"><strong><%=supporterSummary.failedCount%></strong><span>Failed</span></div></div><p class="muted">Review payment records, refunds, and Discord role synchronization.</p><a class="btn small" href="/admin/supporters">Open Supporter Management</a></section>
<section class="adminCard"><div class="pageEyebrow">Account Help</div><h3>Recovery Queue</h3><p class="muted">Review privacy-safe requests from players who cannot sign in.</p><a class="btn small" href="/admin/recoveries">Open Recovery Queue</a></section>
<section class="adminCard"><div class="pageEyebrow">Site</div><h3>Announcements & Settings</h3><% announcements.slice(0,3).forEach(a=>{ %><div class="adminRow"><strong><%=a.title%></strong><span class="muted" style="float:right"><%=a.active?'Active':'Inactive'%></span></div><% }) %><div class="adminQuickActions"><a class="btn small" href="/admin/announcements">Announcements</a><a class="btn small" href="/admin/settings-view">Settings</a></div></section>
<section class="adminCard"><div class="pageEyebrow">History</div><h3>Recent Admin Activity</h3><% auditLog.slice(0,6).forEach(entry=>{ %><div class="adminRow"><strong><%=entry.action%></strong><div class="muted"><%=entry.details||''%><%=entry.details?' · ':''%><%=entry.created_at%></div></div><%})%><% if(!auditLog.length){%><p class="muted">No recorded admin actions yet.</p><%}%><a class="btn small" href="/admin/audit">View Full Audit Log</a></section>
</div></section></main><%- include("partials/footer") %>
