<%- include("partials/header",{title:"CMS"}) %>
<main class="adminShell">
  <aside class="sidebar" aria-label="Staff CMS navigation">
    <div class="sideLogo">STAFF://CMS<br>EVERLEAF OPERATIONS</div>
    <a class="sideLink active" href="/admin"><span class="sideIcon">00</span>Overview</a>
    <a class="sideLink" href="/admin/knowledge"><span class="sideIcon">01</span>Game Database</a>
    <a class="sideLink" href="/admin/news"><span class="sideIcon">02</span>World Log</a>
    <a class="sideLink" href="/admin/announcements"><span class="sideIcon">03</span>Announcements</a>
    <a class="sideLink" href="/admin/downloads"><span class="sideIcon">04</span>Client Files</a>
    <a class="sideLink" href="/admin/pages"><span class="sideIcon">05</span>Site Pages</a>
    <a class="sideLink" href="/admin/recoveries"><span class="sideIcon">06</span>Recovery Queue</a>
    <a class="sideLink" href="/admin/supporters"><span class="sideIcon">07</span>Supporters</a>
    <a class="sideLink" href="/admin/settings-view"><span class="sideIcon">08</span>Settings</a>
    <a class="sideLink" href="/admin/audit"><span class="sideIcon">09</span>Audit Log</a>
    <a class="sideLink" href="/" target="_blank" rel="noopener"><span class="sideIcon">↗</span>Public World</a>
    <form method="post" action="/admin/logout"><button class="btn small sideLogout"><span class="sideIcon">×</span>End Staff Session</button></form>
  </aside>

  <section class="adminMain">
    <header class="adminTop">
      <div><div class="pageEyebrow">STAFF://OPERATIONS OVERVIEW</div><h1>EVERLEAF<br>CMS.</h1><div class="muted">Publishing, player support, world runtime visibility, and community operations.</div></div>
      <span class="kicker"><%=status.online?'WORLD ONLINE':'WORLD OFFLINE'%> // <%=status.channels%>/<%=status.totalChannels%> CHANNELS</span>
    </header>

    <nav class="adminQuickActions" aria-label="CMS quick actions">
      <a class="btn small primary" href="/admin/news">NEW WORLD LOG</a><a class="btn small" href="/admin/announcements">ANNOUNCEMENT</a><a class="btn small" href="/admin/downloads">CLIENT FILES</a><a class="btn small" href="/admin/pages">SITE PAGES</a><a class="btn small" href="/admin/recoveries">RECOVERY QUEUE</a><a class="btn small" href="/admin/settings-view">SETTINGS</a>
    </nav>

    <section class="stats" aria-label="Live CMS metrics">
      <div class="stat"><div class="statNum"><%=players%></div><div>PLAYERS ONLINE</div></div>
      <div class="stat"><div class="statNum"><%=accounts%></div><div>TOTAL ACCOUNTS</div></div>
      <div class="stat"><div class="statNum"><%=posts.filter(p=>p.published).length%></div><div>PUBLISHED POSTS</div></div>
      <div class="stat"><div class="statNum">$<%=(donationTotal/100).toFixed(2)%></div><div>CONFIRMED SUPPORT</div></div>
    </section>

    <div class="adminGrid">
      <section class="adminCard"><div class="pageEyebrow">PUBLISH://CONTENT STATE</div><h3>CONTENT LIBRARY.</h3><div class="adminRow">WORLD LOG <strong style="float:right"><%=posts.filter(p=>p.published).length%>/<%=posts.length%> LIVE</strong></div><div class="adminRow">DOWNLOADS <strong style="float:right"><%=downloads.filter(d=>d.published).length%>/<%=downloads.length%> LIVE</strong></div><div class="adminRow">CUSTOM PAGES <strong style="float:right"><%=pages.filter(p=>p.published).length%>/<%=pages.length%> LIVE</strong></div><div class="adminRow">ANNOUNCEMENTS <strong style="float:right"><%=announcements.filter(a=>a.active).length%> ACTIVE</strong></div><div class="adminQuickActions"><a class="btn small" href="/admin/news">MANAGE LOG</a><a class="btn small" href="/admin/pages">MANAGE PAGES</a></div></section>

      <section class="adminCard"><div class="pageEyebrow">WORLD://RUNTIME</div><h3>SERVER HEALTH.</h3><div class="adminRow">LOGIN SERVER <strong style="float:right"><%=status.online?'ONLINE':'OFFLINE'%></strong></div><div class="adminRow">CHANNELS <strong style="float:right"><%=status.channels%>/<%=status.totalChannels%></strong></div><div class="adminRow">PLAYERS <strong style="float:right"><%=players%></strong></div><div class="adminRow">LAUNCHER MANIFEST <strong style="float:right">READY</strong></div><div class="adminRow">WEBSITE <strong style="float:right">ONLINE</strong></div></section>

      <section class="adminCard"><div class="pageEyebrow">EDITORIAL://RECENT</div><h3>WORLD LOG QUEUE.</h3><% posts.slice(0,6).forEach(p=>{ %><div class="adminRow" style="display:grid;grid-template-columns:1fr auto;gap:10px"><div><strong><%=p.title%></strong><div class="muted"><%=String(p.type||'news').toUpperCase()%> // <%=p.published?'PUBLISHED':'DRAFT'%></div></div><a class="btn small" href="/admin/posts/<%=p.id%>/edit">EDIT</a></div><% }) %><% if(!posts.length){ %><p class="muted">NO POSTS IN QUEUE.</p><% } %></section>

      <section class="adminCard"><div class="pageEyebrow">ACCOUNTS://RECENT</div><h3>NEWEST ACCOUNTS.</h3><% recentAccounts.slice(0,6).forEach(a=>{ %><div class="adminRow"><strong><%=a.name%></strong><span class="muted" style="float:right"><%=a.banned?'BANNED':'ACTIVE'%></span><div class="muted"><%=a.createdat||''%></div></div><% }) %><% if(!recentAccounts.length){ %><p class="muted">GAME DATABASE UNAVAILABLE OR EMPTY.</p><% } %></section>

      <section class="adminCard"><div class="pageEyebrow">SUPPORT://PAYMENTS</div><h3>SUPPORTER OPS.</h3><div class="miniGrid"><div class="miniCard"><strong><%=supporterSummary.paidCount%></strong><span>PAID</span></div><div class="miniCard"><strong><%=supporterSummary.pendingCount%></strong><span>PENDING</span></div><div class="miniCard"><strong><%=supporterSummary.failedCount%></strong><span>FAILED</span></div></div><p class="muted">Provider-confirmed payments, refunds, and Discord role synchronization.</p><a class="btn small" href="/admin/supporters">OPEN SUPPORTERS</a></section>

      <section class="adminCard"><div class="pageEyebrow">SUPPORT://RECOVERY</div><h3>RECOVERY QUEUE.</h3><p class="muted">Review privacy-safe requests from players who cannot sign in.</p><a class="btn small" href="/admin/recoveries">OPEN QUEUE</a></section>

      <section class="adminCard"><div class="pageEyebrow">SITE://STATE</div><h3>ANNOUNCEMENTS.</h3><% announcements.slice(0,4).forEach(a=>{ %><div class="adminRow"><strong><%=a.title%></strong><span class="muted" style="float:right"><%=a.active?'ACTIVE':'INACTIVE'%></span></div><% }) %><div class="adminQuickActions"><a class="btn small" href="/admin/announcements">MANAGE</a><a class="btn small" href="/admin/settings-view">SETTINGS</a></div></section>

      <section class="adminCard"><div class="pageEyebrow">AUDIT://LATEST</div><h3>STAFF ACTIVITY.</h3><% auditLog.slice(0,7).forEach(entry=>{ %><div class="adminRow"><strong><%=entry.action%></strong><div class="muted"><%=entry.details||''%><%=entry.details?' // ':''%><%=entry.created_at%></div></div><% }) %><% if(!auditLog.length){ %><p class="muted">NO RECORDED ADMIN ACTIONS.</p><% } %><a class="btn small" href="/admin/audit">FULL AUDIT LOG</a></section>
    </div>
  </section>
</main>
<%- include("partials/footer") %>
