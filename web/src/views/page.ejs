<%- include("partials/header",{title:page.title}) %>
<main class="lightPage terminalArticlePage">
  <header class="terminalPageLead"><div><div class="pageEyebrow">DOCUMENT://EVERLEAF</div><h1><%=page.title%>.</h1></div><aside class="terminalPageLeadAside"><span>CMS-MANAGED PUBLIC ROUTE</span><b>OFFICIAL EVERLEAF INFORMATION</b><span>Content may be updated by staff without a code deployment.</span></aside></header>
  <article class="featurePanel termsCard terminalArticle"><% String(page.body||"").split(/\r?\n\r?\n/).filter(Boolean).forEach(paragraph=>{ %><p><%=paragraph%></p><% }) %><% if(!String(page.body||"").trim()){ %><p class="muted">THIS DOCUMENT IS BEING PREPARED.</p><% } %></article>
</main>
<%- include("partials/footer") %>
