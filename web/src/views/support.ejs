<%- include("partials/header",{title:"Support EverLeaf",player}) %>
<main class="lightPage"><section class="lightTitle"><div class="wrap pageHeroGrid"><div><div class="pageEyebrow">Keep Maple World Growing</div><h1>Support EverLeaf</h1><p>Help cover hosting, security, development tools, events, and community operations without selling competitive power.</p></div><div class="pageHeroAside"><strong>Fair by design</strong><span>Supporter recognition stays cosmetic and community-focused. Gameplay power and progression are not for sale.</span></div></div></section><div class="wrap contentStack" style="padding-bottom:65px"><div class="supportHero">
<section class="featurePanel"><div class="pageEyebrow">EverLeaf Promise</div><h2>No Pay-to-Win.</h2><p class="muted">Contributions help maintain EverLeaf while the adventure itself remains earned through play.</p><div class="supportPromiseGrid"><div class="supportPromise">✓ No exclusive combat power</div><div class="supportPromise">✓ No progression shortcuts</div><div class="supportPromise">✓ Provider-confirmed fulfillment</div><div class="supportPromise">✓ Transparent account history</div></div></section>
<section class="paperCard"><div class="pageEyebrow">Community Contribution</div><h2>Choose an amount</h2><% if(!player){%><p class="muted">Sign in first so supporter recognition is attached to the correct EverLeaf account.</p><a class="btn primary" href="/login">SIGN IN TO CONTINUE</a><%}else{%><p class="muted">Signed in as <strong><%=player.name%></strong></p><form method="post" action="/donate/checkout"><div class="amountGrid"><% amounts.forEach(amount=>{ %><label class="amountChoice"><input type="radio" name="amountCents" value="<%=amount%>" <%=amount===1000?'checked':''%>><span>$<%=(amount/100).toFixed(0)%></span></label><%})%></div><div class="providerGrid"><button class="btn providerBtn" name="provider" value="stripe" <%=providers.stripe?'':'disabled'%>>CARD <small><%=providers.stripe?providers.stripeLabel:'Coming soon'%></small></button><button class="btn providerBtn" name="provider" value="paypal" <%=providers.paypal?'':'disabled'%>>PAYPAL <small><%=providers.paypal?providers.paypalLabel:'Coming soon'%></small></button></div></form><% if(!providers.stripe&&!providers.paypal){%><p class="muted">Payments are not active yet.</p><%}%><%}%></section></div>
<% if(error){%><div class="error"><%=error%></div><%}%><% if(typeof notice!=="undefined"&&notice){%><div class="notice"><%=notice%></div><%}%><% if(player){%><section class="featurePanel"><div class="pageEyebrow">Supporter Ledger</div><h2>Your Status</h2><% if(summary.profile){%><div class="miniGrid"><div class="miniCard"><strong>$<%=(summary.profile.lifetime_cents/100).toFixed(2)%></strong><span>Lifetime confirmed support</span></div><div class="miniCard"><strong><%=summary.profile.discord_role_status%></strong><span>Discord role status</span></div><div class="miniCard"><strong><%=summary.orders.length%></strong><span>Recorded contribution orders</span></div></div><%}else{%><p class="muted">No confirmed supporter profile yet.</p><%}%><% if(summary.orders.length){%><div class="tableWrap" style="margin-top:18px"><table><thead><tr><th>Date</th><th>Provider</th><th>Amount</th><th>Status</th></tr></thead><tbody><% summary.orders.forEach(order=>{%><tr><td><%=order.created_at%></td><td><%=order.provider%></td><td>$<%=(order.amount_cents/100).toFixed(2)%><% if(order.refunded_cents){%><br><small>$<%=(order.refunded_cents/100).toFixed(2)%> refunded</small><%}%></td><td><%=order.status%></td></tr><%})%></tbody></table></div><%}%></section><%}%></div></main><%- include("partials/footer") %>
