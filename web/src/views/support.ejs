<%- include("partials/header",{title:"Support EverLeaf",player}) %>
<main class="lightPage"><div class="lightTitle"><div class="wrap"><h1>Support EverLeaf</h1><p>Help fund reliable hosting and community development—never competitive power.</p></div></div>
<div class="wrap donateWrap"><% if(error){%><div class="error"><%=error%></div><%}%><% if(typeof notice!=="undefined"&&notice){%><div class="notice"><%=notice%></div><%}%><div class="donateGrid">
<section class="paperCard"><span class="kicker">COMMUNITY SUPPORTED</span><h2>No Pay-to-Win. Ever.</h2><p>Contributions help cover hosting, security, development tools, events, and community operations. Supporter recognition is cosmetic and community-focused; it does not sell stats, equipment, currency, progression, or gameplay advantages.</p><div class="supportPromises"><div>✓ No exclusive combat power</div><div>✓ No progression shortcuts</div><div>✓ Transparent payment records</div><div>✓ Provider-confirmed fulfillment only</div></div></section>
<section class="paperCard"><h2>Choose a contribution</h2><% if(!player){%><p>Sign in with your EverLeaf account before contributing so supporter recognition can be attached safely.</p><a class="btn primary" href="/login">SIGN IN TO CONTINUE</a><%}else{%><p class="muted">Signed in as <strong><%=player.name%></strong></p><form method="post" action="/donate/checkout"><div class="amountGrid"><% amounts.forEach(amount=>{ %><label class="amountChoice"><input type="radio" name="amountCents" value="<%=amount%>" <%=amount===1000?'checked':''%>><span>$<%=(amount/100).toFixed(0)%></span></label><%})%></div><div class="providerGrid"><button class="btn providerBtn" name="provider" value="stripe" <%=providers.stripe?'':'disabled'%>>CARD <small><%=providers.stripe?providers.stripeLabel:'Coming soon'%></small></button><button class="btn providerBtn" name="provider" value="paypal" <%=providers.paypal?'':'disabled'%>>PAYPAL <small><%=providers.paypal?providers.paypalLabel:'Coming soon'%></small></button></div></form><% if(!providers.stripe&&!providers.paypal){%><p class="muted">Payments are not active yet. No payment information is being collected.</p><%}%><%}%></section>
</div><% if(player){%><section class="paperCard supporterStatus"><h2>Your supporter status</h2><% if(summary.profile){%><p>Lifetime confirmed support: <strong>$<%=(summary.profile.lifetime_cents/100).toFixed(2)%></strong></p><p>Discord role: <%=summary.profile.discord_role_status%></p><%}else{%><p class="muted">No confirmed supporter profile yet.</p><%}%><% if(summary.orders.length){%><table><thead><tr><th>Date</th><th>Provider</th><th>Amount</th><th>Status</th></tr></thead><tbody><% summary.orders.forEach(order=>{%><tr><td><%=order.created_at%></td><td><%=order.provider%></td><td>$<%=(order.amount_cents/100).toFixed(2)%><% if(order.refunded_cents){%><br><small>$<%=(order.refunded_cents/100).toFixed(2)%> refunded</small><%}%></td><td><%=order.status%></td></tr><%})%></tbody></table><%}%></section><%}%></div></main><%- include("partials/footer") %>
