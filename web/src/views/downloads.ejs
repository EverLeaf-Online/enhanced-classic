<%- include("partials/header",{title:"Downloads"}) %>
<main class="terminalDeployPage">
  <header class="terminalDeployHero">
    <div>
      <div class="pageEyebrow">CLIENT://DEPLOY</div>
      <h1>LAUNCHER<br>& DOWNLOADS.</h1>
      <p class="muted">The EverLeaf launcher is the supported entry point. It installs, verifies, repairs, updates, and starts the client from one controlled path.</p>
    </div>
    <div class="terminalDeployVersion"><%=brand.version%><small>ACTIVE CLIENT // V83</small></div>
  </header>

  <div class="terminalDeployGrid">
    <section class="terminalDeployMain">
      <div class="terminalCommand downloadCard">
        <div>
          <div class="pageEyebrow">PRIMARY COMMAND / REQUIRED</div>
          <h2>EVERLEAF LAUNCHER</h2>
          <p>Installs all required files, verifies integrity, repairs damaged or missing files, applies updates, and starts <strong>EverLeaf.exe</strong>. Always launch through this path.</p>
        </div>
        <a class="btn primary" href="<%=brand.launcherUrl%>">DOWNLOAD LAUNCHER</a>
      </div>

      <div class="terminalManifest" aria-label="Available EverLeaf downloads">
        <div class="pageEyebrow" style="padding:12px 0">MANIFEST // PUBLISHED FILES</div>
        <% rows.forEach(r=>{ %>
          <div class="terminalManifestRow downloadCard">
            <span><%=String(r.kind||'file').toUpperCase()%></span>
            <strong><%=r.name%></strong>
            <span class="muted"><%=r.description%><% if(r.version){ %> // VERSION <%=r.version%><% } %></span>
            <a class="btn" href="<%=r.url%>">GET FILE</a>
          </div>
        <% }) %>
        <% if(!rows.length){ %><div class="terminalManifestRow"><span>EMPTY</span><strong>No secondary files published.</strong><span class="muted">Use the launcher above.</span><span>—</span></div><% } %>
      </div>
    </section>

    <aside class="terminalDeployRail">
      <section class="terminalDiagnostic">
        <div class="pageEyebrow">BOOT SEQUENCE</div>
        <h3>INSTALL</h3>
        <ol>
          <li>Create an empty folder such as <strong>Documents\EverLeaf</strong>.</li>
          <li>Extract the launcher ZIP into that folder.</li>
          <li>Run <strong>EverLeafLauncher.exe</strong>.</li>
          <li>Choose <strong>Install EverLeaf</strong> and let verification finish.</li>
        </ol>
      </section>
      <section class="terminalDiagnostic">
        <div class="pageEyebrow">DIAGNOSTIC</div>
        <h3>REPAIR</h3>
        <p>Use <strong>Install / Repair Files</strong>. The launcher checks your installation and downloads only what is missing or damaged.</p>
        <a class="btn" href="/help">OPEN HELP</a>
      </section>
      <section class="terminalDiagnostic">
        <div class="pageEyebrow">GUARDRAIL</div>
        <h3>DO NOT BYPASS</h3>
        <p>Do not start the game executable directly. Launcher verification keeps the local client synchronized with EverLeaf updates.</p>
      </section>
    </aside>
  </div>
</main>
<%- include("partials/footer") %>
