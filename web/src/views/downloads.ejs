<%- include("partials/header",{title:"Downloads"}) %>
<main class="lightPage"><section class="lightTitle visualPageTitle"><div class="wrap pageHeroGrid"><div><div class="pageEyebrow">EverLeaf Client</div><h1>Launcher & Downloads</h1><p>The launcher installs, verifies, repairs, updates, and starts EverLeaf from one supported entry point.</p></div><div class="pageHeroVisual"><img src="/assets/visuals/downloads-workshop.svg" alt="EverLeaf fantasy launcher workshop with a glowing crystal, maps, and forest mascot" decoding="async"><div class="pageHeroVisualCopy"><strong>Launcher required</strong><span>Always start EverLeaf through the launcher so your client stays verified and up to date.</span></div></div></div></section><div class="wrap contentGrid"><div class="contentStack">
<section class="featurePanel"><div class="pageEyebrow">Recommended Download</div><div style="display:flex;justify-content:space-between;gap:18px;align-items:center;flex-wrap:wrap"><div style="display:flex;gap:16px;align-items:center"><div class="downloadIcon"><img src="/assets/ui/launcher.svg" alt="" aria-hidden="true"></div><div><h2 style="margin:0 0 6px">EverLeaf Launcher</h2><p class="muted" style="margin:0;max-width:640px">Installs all 36 required files, verifies integrity, repairs damaged or missing files, applies updates, and keeps the client ready before starting <strong>EverLeaf.exe</strong>.</p></div></div><a class="btn primary" href="<%=brand.launcherUrl%>">DOWNLOAD LAUNCHER</a></div></section>
<% const groups=[["launcher","Launcher Builds","/assets/ui/launcher.svg"],["patch","Patches","/assets/ui/patch.svg"],["tool","Client Tools","/assets/ui/tool.svg"]]; %><% groups.forEach(([kind,label,icon])=>{ const items=rows.filter(r=>r.kind===kind); if(!items.length) return; %><h3 class="downloadGroupTitle"><%=label%></h3><% items.forEach(r=>{ %><div class="downloadCard"><div style="display:flex;gap:14px;align-items:center"><div class="downloadIcon"><img src="<%=icon%>" alt="" aria-hidden="true"></div><div><strong><%=r.name%></strong><div class="muted"><%=r.description%></div><small><%=r.version?('Version '+r.version):''%></small></div></div><a class="btn primary" href="<%=r.url%>">DOWNLOAD</a></div><% }) %><% }) %>
</div><aside class="contentStack"><section class="paperCard"><div class="pageEyebrow">Beginner Setup</div><h3>Four steps to Maple World</h3><ol style="padding-left:20px;line-height:1.9"><li>Create an empty folder such as <strong>Documents\EverLeaf</strong>.</li><li>Extract the launcher ZIP into that folder.</li><li>Run <strong>EverLeafLauncher.exe</strong>.</li><li>Choose <strong>Install EverLeaf</strong>. Let verification finish before pressing Play.</li></ol></section><section class="paperCard"><div class="pageEyebrow">Repair</div><h3>Missing or damaged files?</h3><p class="muted">Run <strong>Install / Repair Files</strong>. The launcher checks your installation and downloads only files that need replacement.</p><a class="btn" href="/help">OPEN PLAYER HELP</a></section><section class="paperCard"><div class="pageEyebrow">Important</div><h3>Do not run the EXE directly</h3><p class="muted">The launcher is the supported entry point and keeps your client synchronized with EverLeaf updates.</p></section></aside></div></main><%- include("partials/footer") %>
