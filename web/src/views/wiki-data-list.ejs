<%- include("partials/header",{title:`${meta.label} Wiki`,description:`Browse EverLeaf ${meta.label.toLowerCase()} from the live server data catalog.`}) %>
<%
const fmt=n=>Number(n||0).toLocaleString();
const base=`/wiki/${type}`;
const pageHref=p=>`${base}?${q?`q=${encodeURIComponent(q)}&`:''}${type==='items'&&result.itemCategory!=='all'?`itemCategory=${encodeURIComponent(result.itemCategory)}&`:''}${p>1?`page=${p}`:''}`.replace(/[?&]$/,'');
const mapleAsset=(entityType,id)=>Number(id||0)>0?`/wiki/art/${encodeURIComponent(entityType)}/${Number(id)}`:'';
const typeFallback={items:'IT',monsters:'MB',maps:'MP',skills:'SK',npcs:'NP',quests:'QU'};
const selectedItemCategory=type==='items'?(result.itemCategory||'all'):'all';
const itemParent=selectedItemCategory==='all'?'all':selectedItemCategory==='pets'?'pets':selectedItemCategory.startsWith('equipment')?'equipment':selectedItemCategory.startsWith('consumable')?'consumables':selectedItemCategory.startsWith('install')?'install':selectedItemCategory.startsWith('etc')?'etc':selectedItemCategory.startsWith('cash')?'cash':'all';
const itemParentFilters=[['all','All Items'],['equipment','Equipment'],['consumables','Consumables'],['install','Chairs / Install'],['etc','ETC'],['cash','Cash'],['pets','Pets']];
const itemHref=(category,includeQuery=true)=>{
  const parts=[];
  if(includeQuery&&q)parts.push(`q=${encodeURIComponent(q)}`);
  if(category&&category!=='all')parts.push(`itemCategory=${encodeURIComponent(category)}`);
  return parts.length?`${base}?${parts.join('&')}`:base;
};
const itemChildMatches=(key,parent)=>parent==='equipment'?key.startsWith('equipment-'):parent==='consumables'?key.startsWith('consumable-'):parent==='install'?key.startsWith('install-'):parent==='etc'?key.startsWith('etc-'):parent==='cash'?key.startsWith('cash-'):false;
const itemSubfilters=type==='items'&&itemParent!=='all'&&itemParent!=='pets'?result.itemCategoryGroups.flatMap(group=>group.options).filter(([key])=>itemChildMatches(key,itemParent)):[];
%>
<main class="lightPage wikiDataPage wikiCatalogListPage wikiAppPage">
<section class="wikiListHero">
  <div class="wrap">
    <div class="wikiBreadcrumb"><a href="/wiki">Wiki</a><span>›</span><strong><%=meta.label%></strong></div>
    <div class="wikiListHeroGrid"><div><div class="pageEyebrow">EVERLEAF <%=meta.singular.toUpperCase()%> DATABASE</div><h1><%=meta.label%></h1><p><%=meta.description%></p></div><div class="wikiListCount"><strong><%=fmt(result.total)%></strong><span><%=q||result.itemCategory!=='all'?'matching records':'player-useful records'%></span><small>Cleaned live catalog</small></div></div>
    <form class="wikiDataSearch wikiListSearch" action="<%=base%>" method="get">
      <% if(type==='items'&&selectedItemCategory!=='all'){ %><input type="hidden" name="itemCategory" value="<%=selectedItemCategory%>"><% } %>
      <input type="search" name="q" value="<%=q%>" placeholder="Search <%=meta.label.toLowerCase()%> by name or ID…" aria-label="Search <%=meta.label%>">
      <button class="btn primary" type="submit">SEARCH</button>
      <% if(q){ %><a class="btn" href="<%=itemHref(selectedItemCategory,false)%>">CLEAR SEARCH</a><% } %>
    </form>
    <nav class="wikiTypeTabs" aria-label="Wiki categories"><a href="/wiki">All</a><% Object.entries(types).forEach(([key,item])=>{ %><a class="<%=key===type?'active':''%>" href="/wiki/<%=key%>"><%=item.label%></a><% }) %></nav>
    <% if(type==='items'){ %>
      <nav class="wikiItemFamilyTabs" aria-label="Item categories">
        <% itemParentFilters.forEach(([key,label])=>{ %><a class="<%=itemParent===key?'active':''%>" href="<%=itemHref(key)%>"><%=label%><span><%=fmt(result.itemCategoryCounts[key])%></span></a><% }) %>
      </nav>
      <% if(itemSubfilters.length){ %>
        <nav class="wikiItemSubTabs" aria-label="<%=itemParent%> item subcategories">
          <% itemSubfilters.forEach(([key,label])=>{ %><a class="<%=selectedItemCategory===key?'active':''%>" href="<%=itemHref(key)%>"><%=label%><span><%=fmt(result.itemCategoryCounts[key])%></span></a><% }) %>
        </nav>
      <% } %>
    <% } %>
  </div>
</section>
<div class="wrap wikiListBody">
<% if(result.rows.length){ %><div class="wikiDataTableWrap"><table class="wikiDataTable wikiDataTableClean"><thead><tr><th class="wikiArtColumn">Art</th><th>ID</th><th><%=meta.singular%></th><th>Category / description</th></tr></thead><tbody><% result.rows.forEach(entity=>{ const href=`${base}/${entity.id}`; const icon=mapleAsset(type,entity.id); %><tr><td class="wikiArtColumn" data-label="Art"><a class="wikiListAsset wikiMapleAsset" data-fallback="<%=typeFallback[type]||'EL'%>" href="<%=href%>" aria-label="Open <%=entity.name%>"><% if(icon){ %><img src="<%=icon%>" alt="" loading="lazy" decoding="async" data-wiki-art><% } %></a></td><td data-label="ID"><code><%=entity.id%></code></td><td data-label="<%=meta.singular%>"><a class="wikiEntityName wikiEntityPrimaryLink" href="<%=href%>"><strong><%=entity.name%></strong><small><%=entity.variantCount>1?`${entity.variantCount} matching server IDs consolidated`:meta.singular%></small><span>Open record →</span></a></td><td data-label="Details"><span class="wikiEntityDescription"><%=entity.description||entity.subtype||'EverLeaf server data'%></span><% if(entity.subtype){ %><small class="wikiEntitySubtype"><%=entity.subtype%><%=type==='items'&&entity.itemCategoryLabel?` · ${entity.itemCategoryLabel}`:''%></small><% } %></td></tr><% }) %></tbody></table></div>
<% if(result.pages>1){ %><nav class="wikiPagination" aria-label="Wiki catalog pages"><% if(result.page>1){ %><a href="<%=pageHref(result.page-1)%>">← Previous</a><% } %><span>Page <strong><%=result.page%></strong> of <%=result.pages%></span><% if(result.page<result.pages){ %><a href="<%=pageHref(result.page+1)%>">Next →</a><% } %></nav><% } %>
<% } else { %><div class="wikiDataEmpty"><span>?</span><h3>No <%=meta.label.toLowerCase()%> found.</h3><p><%=q?'Try another name or an exact ID.':'No player-useful records remain after filtering duplicate and internal entries.'%></p><a class="btn" href="<%=base%>">CLEAR SEARCH</a></div><% } %>
</div></main><%- include("partials/footer") %>