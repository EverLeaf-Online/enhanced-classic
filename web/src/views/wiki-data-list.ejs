<%- include("partials/header",{title:`${meta.label} Wiki`,description:`Browse EverLeaf ${meta.label.toLowerCase()} from the live server data catalog.`}) %>
<%
const fmt=n=>Number(n||0).toLocaleString();
const base=`/wiki/${type}`;
const pageHref=p=>`${base}?${q?`q=${encodeURIComponent(q)}&`:''}${p>1?`page=${p}`:''}`.replace(/\?$/,'');
%>
<main class="lightPage wikiDataPage wikiCatalogListPage">
<section class="wikiListHero"><div class="wrap"><div class="wikiBreadcrumb"><a href="/wiki">Wiki</a><span>›</span><strong><%=meta.label%></strong></div><div class="wikiListHeroGrid"><div><div class="pageEyebrow">EVERLEAF <%=meta.singular.toUpperCase()%> DATABASE</div><h1><%=meta.label%></h1><p><%=meta.description%></p></div><div class="wikiListCount"><strong><%=fmt(result.total)%></strong><span><%=q?'matching records':'indexed records'%></span><small>Live WZ catalog</small></div></div><form class="wikiDataSearch wikiListSearch" action="<%=base%>" method="get"><input type="search" name="q" value="<%=q%>" placeholder="Search <%=meta.label.toLowerCase()%> by name or ID…" aria-label="Search <%=meta.label%>"><button class="btn primary" type="submit">SEARCH</button><% if(q){ %><a class="btn" href="<%=base%>">CLEAR</a><% } %></form><nav class="wikiTypeTabs" aria-label="Wiki categories"><a href="/wiki">All</a><% Object.entries(types).forEach(([key,item])=>{ %><a class="<%=key===type?'active':''%>" href="/wiki/<%=key%>"><%=item.label%></a><% }) %></nav></div></section>
<div class="wrap wikiListBody">
<% if(result.rows.length){ %><div class="wikiDataTableWrap"><table class="wikiDataTable"><thead><tr><th>ID</th><th><%=meta.singular%></th><th>Category / description</th><th></th></tr></thead><tbody><% result.rows.forEach(entity=>{ %><tr><td><code><%=entity.id%></code></td><td><a class="wikiEntityName" href="<%=base%>/<%=entity.id%>"><strong><%=entity.name%></strong><small><%=meta.singular%></small></a></td><td><span class="wikiEntityDescription"><%=entity.description||entity.subtype||'EverLeaf server data'%></span><% if(entity.subtype){ %><small class="wikiEntitySubtype"><%=entity.subtype%></small><% } %></td><td><a class="wikiOpenEntity" href="<%=base%>/<%=entity.id%>">View →</a></td></tr><% }) %></tbody></table></div>
<% if(result.pages>1){ %><nav class="wikiPagination" aria-label="Wiki catalog pages"><% if(result.page>1){ %><a href="<%=pageHref(result.page-1)%>">← Previous</a><% } %><span>Page <strong><%=result.page%></strong> of <%=result.pages%></span><% if(result.page<result.pages){ %><a href="<%=pageHref(result.page+1)%>">Next →</a><% } %></nav><% } %>
<% } else { %><div class="wikiDataEmpty"><span>?</span><h3>No <%=meta.label.toLowerCase()%> found.</h3><p><%=q?'Try another name or an exact ID.':'This category did not produce any records from the current WZ catalog.'%></p><a class="btn" href="<%=base%>">CLEAR SEARCH</a></div><% } %>
</div></main><%- include("partials/footer") %>