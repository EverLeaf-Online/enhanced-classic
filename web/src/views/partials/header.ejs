<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <%
    const defaultDescription=(typeof siteDescription!=='undefined'&&siteDescription)?siteDescription:'EverLeaf Enhanced Classic MapleStory v83';
    const baseSiteUrl=(typeof siteUrl!=='undefined'&&siteUrl)?siteUrl:'https://everleafms.online';
    const pageTitle=title?title+' • '+brand.name:brand.name;
    const pageDescription=(typeof description!=='undefined'&&description)?description:defaultDescription;
    const canonicalPath=(typeof currentPath!=='undefined'&&currentPath)?currentPath:'/';
    const canonicalUrl=baseSiteUrl+canonicalPath;
    const isAdminPath=canonicalPath.startsWith('/admin');
    const isHome=canonicalPath==='/';
    const routeKey=isHome?'home':(canonicalPath.split('/').filter(Boolean)[0]||'page').replace(/[^a-z0-9-]/gi,'').toLowerCase();
    const isSignedIn=typeof sessionPlayer!=='undefined'&&Boolean(sessionPlayer);
    const activeFor=(path)=>canonicalPath===path||canonicalPath.startsWith(path+'/');
  %>
  <title><%=pageTitle%></title>
  <meta name="description" content="<%=pageDescription%>">
  <meta name="theme-color" content="#f5f9ff">
  <meta name="color-scheme" content="light dark">
  <meta name="application-name" content="<%=brand.name%>">
  <meta name="robots" content="<%=isAdminPath?'noindex,nofollow':'index,follow'%>">
  <link rel="canonical" href="<%=canonicalUrl%>">
  <link rel="icon" href="/assets/everleaf-remaster.svg" type="image/svg+xml">
  <% if(isHome){ %>
    <link rel="preload" as="image" href="/assets/hero-forest.webp" type="image/webp">
    <link rel="preload" as="image" href="/assets/hero-right.webp" type="image/webp">
    <link rel="preload" as="image" href="/assets/hero-left.webp" type="image/webp">
  <% } %>

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%=brand.name%>">
  <meta property="og:title" content="<%=pageTitle%>">
  <meta property="og:description" content="<%=pageDescription%>">
  <meta property="og:url" content="<%=canonicalUrl%>">
  <meta property="og:image" content="<%=baseSiteUrl%>/assets/hero-forest.webp">
  <meta property="og:image:alt" content="EverLeaf Enhanced Classic Maple World">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%=pageTitle%>">
  <meta name="twitter:description" content="<%=pageDescription%>">
  <meta name="twitter:image" content="<%=baseSiteUrl%>/assets/hero-forest.webp">

  <link rel="stylesheet" href="/css/maple-remaster.css">
  <link rel="stylesheet" href="/css/maple-remaster-pages.css">
  <link rel="stylesheet" href="/css/maple-jobs.css">
  <link rel="stylesheet" href="/css/maple-final.css">
  <link rel="stylesheet" href="/css/rankings-remaster.css">
  <link rel="stylesheet" href="/css/rankings-live.css?v=1">
  <link rel="stylesheet" href="/css/home-polish.css">
  <link rel="stylesheet" href="/css/wiki-remaster.css">
  <link rel="stylesheet" href="/css/wiki-library-v2.css">
  <link rel="stylesheet" href="/css/wiki-cms.css?v=1">
  <link rel="stylesheet" href="/css/wiki-player-2026.css?v=1">
  <link rel="stylesheet" href="/css/wiki-data.css?v=1">
  <link rel="stylesheet" href="/css/wiki-cleanup-2026.css?v=1">
  <% if(isAdminPath){ %>
    <link rel="stylesheet" href="/css/maple-remaster-admin.css">
    <link rel="stylesheet" href="/css/cms-knowledge.css">
  <% } %>
  <link rel="stylesheet" href="/css/uiux-2026.css?v=2">
  <link rel="stylesheet" href="/css/site-polish-2026.css?v=1">
  <link rel="stylesheet" href="/css/refero-everleaf-2026.css?v=3">
  <link rel="stylesheet" href="/css/unified-terminal-2026.css?v=1">
  <link rel="stylesheet" href="/css/inner-app-clean-2026.css?v=1">
  <link rel="stylesheet" href="/css/app-frame-v2-2026.css?v=1">
  <link rel="stylesheet" href="/css/wiki-app-assets-2026.css?v=1">
  <% if(routeKey==='wiki'){ %>
    <link rel="stylesheet" href="/css/wiki-art-fix-2026.css?v=1">
    <script src="/js/wiki-art.js?v=1" defer></script>
  <% } %>
  <link rel="stylesheet" href="/css/everleaf-polish-2026.css?v=1">
  <script src="/js/site.js?v=3" defer></script>
</head>
<body class="siteRoute route-<%=routeKey%><%=isAdminPath?' route-admin':''%>">
<a class="skipLink" href="#main-content">Skip to content</a>
<%
  const maintenance=(typeof settings!=='undefined'&&settings&&String(settings.maintenance_message||'').trim())||'';
  const fallbackAnnouncement=(typeof settings!=='undefined'&&settings&&String(settings.announcement||'').trim())||'';
%>
<% if(maintenance){ %>
  <div role="status" class="siteBanner maintenanceBanner"><div class="wrap"><strong>MAINTENANCE</strong><span><%=maintenance%></span></div></div>
<% } else if(typeof activeAnnouncement!=='undefined'&&activeAnnouncement){ %>
  <div role="status" class="siteBanner announcementBanner"><div class="wrap"><strong><%=activeAnnouncement.title%></strong><% if(activeAnnouncement.body){ %><span><%=activeAnnouncement.body%></span><% } %></div></div>
<% } else if(fallbackAnnouncement){ %>
  <div role="status" class="siteBanner announcementBanner"><div class="wrap"><span><%=fallbackAnnouncement%></span></div></div>
<% } %>
<% if(!isHome&&!isAdminPath){ %>
<header class="siteTopbar">
  <div class="wrap siteTopbarInner">
    <a class="siteTopbarBrand" href="/" aria-label="EverLeaf home">
      <img src="/assets/everleaf-remaster.svg" alt="" aria-hidden="true">
      <span class="siteTopbarBrandCopy"><strong>EverLeaf</strong><small>Enhanced Classic</small></span>
    </a>
    <nav class="siteTopbarLinks" aria-label="Primary navigation">
      <a class="<%=activeFor('/downloads')?'active':''%>" href="/downloads">Download</a>
      <a class="<%=activeFor('/rankings')?'active':''%>" href="/rankings">Rankings</a>
      <a class="<%=activeFor('/wiki')?'active':''%>" href="/wiki">Wiki</a>
      <a class="<%=activeFor('/news')?'active':''%>" href="/news">News</a>
      <a class="<%=activeFor('/help')?'active':''%>" href="/help">Help</a>
    </nav>
    <a class="siteTopbarAction" href="<%=isSignedIn?'/account':'/login'%>"><%=isSignedIn?'My account':'Sign in'%></a>
    <details class="siteTopbarMenu">
      <summary aria-label="Open navigation">☰</summary>
      <nav class="siteTopbarMenuPanel" aria-label="Mobile navigation">
        <a href="/">Home</a>
        <a class="<%=activeFor('/downloads')?'active':''%>" href="/downloads">Download</a>
        <a class="<%=activeFor('/rankings')?'active':''%>" href="/rankings">Rankings</a>
        <a class="<%=activeFor('/wiki')?'active':''%>" href="/wiki">Wiki</a>
        <a class="<%=activeFor('/news')?'active':''%>" href="/news">News</a>
        <a class="<%=activeFor('/help')?'active':''%>" href="/help">Help</a>
        <a href="<%=isSignedIn?'/account':'/login'%>"><%=isSignedIn?'My account':'Sign in'%></a>
      </nav>
    </details>
  </div>
</header>
<% } %>
<div id="main-content" class="siteContent" tabindex="-1">