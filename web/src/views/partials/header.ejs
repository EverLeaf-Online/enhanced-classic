<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><% const pageTitle=title?title+' • '+brand.name:brand.name; const pageDescription=(typeof description!=='undefined'&&description)?description:siteDescription; const canonicalPath=(typeof currentPath!=='undefined'&&currentPath)?currentPath:'/'; const canonicalUrl=siteUrl+canonicalPath; %><title><%=pageTitle%></title><meta name="description" content="<%=pageDescription%>"><meta name="theme-color" content="#102a1a"><link rel="canonical" href="<%=canonicalUrl%>"><meta property="og:type" content="website"><meta property="og:site_name" content="<%=brand.name%>"><meta property="og:title" content="<%=pageTitle%>"><meta property="og:description" content="<%=pageDescription%>"><meta property="og:url" content="<%=canonicalUrl%>"><meta property="og:image" content="<%=siteUrl%>/assets/everleaf-logo.webp"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="<%=pageTitle%>"><meta name="twitter:description" content="<%=pageDescription%>"><meta name="twitter:image" content="<%=siteUrl%>/assets/everleaf-logo.webp"><link rel="stylesheet" href="/css/site.css"><link rel="stylesheet" href="/css/refresh.css"><link rel="stylesheet" href="/css/design-v2.css"></head><body>
<% const navLinks=[{href:"/",label:"HOME"},{href:"/news",label:"NEWS"},{href:"/downloads",label:"DOWNLOADS"},{href:"/rankings",label:"RANKINGS"},{href:brand.discordUrl,label:"DISCORD",external:true},{href:"/donate",label:"DONATE"},{href:"/help",label:"SUPPORT"}]; %>
<nav class="nav"><div class="wrap navin"><a class="brand brandImage" href="/" aria-label="EverLeaf home"><img src="/assets/everleaf-logo.webp" alt="EverLeaf"></a><div class="links desktopLinks">
<% navLinks.forEach(({href,label,external})=>{ const isActive=!external&&(typeof currentPath!=='undefined')&&(href==="/"?currentPath==="/":currentPath.startsWith(href)); %><a class="<%=isActive?'active':''%>" href="<%=href%>"<% if(external){ %> target="_blank" rel="noopener noreferrer"<% } %>><%=label%></a><% }) %>
<% if(typeof player!=='undefined'&&player){ const accountActive=typeof currentPath!=='undefined'&&currentPath.startsWith('/account'); %><a class="btn small ghost accountNav<%=accountActive?' active':''%>" href="/account">ACCOUNT</a><% }else{ %><a class="btn small ghost" href="/login">LOGIN</a><a class="btn small primary" href="/register">REGISTER</a><% } %></div>
<details class="mobileMenu"><summary aria-label="Open navigation">MENU <span aria-hidden="true">☰</span></summary><div class="mobileMenuPanel"><% navLinks.forEach(({href,label,external})=>{ const isActive=!external&&(typeof currentPath!=='undefined')&&(href==="/"?currentPath==="/":currentPath.startsWith(href)); %><a class="<%=isActive?'active':''%>" href="<%=href%>"<% if(external){ %> target="_blank" rel="noopener noreferrer"<% } %>><%=label%></a><% }) %><div class="mobileAuth"><% if(typeof player!=='undefined'&&player){ %><a class="btn primary" href="/account">ACCOUNT</a><% }else{ %><a class="btn ghost" href="/login">LOGIN</a><a class="btn primary" href="/register">REGISTER</a><% } %></div></div></details></div></nav>
<% const maintenance=(typeof settings!=='undefined'&&settings&&String(settings.maintenance_message||'').trim())||''; const fallbackAnnouncement=(typeof settings!=='undefined'&&settings&&String(settings.announcement||'').trim())||''; %>
<% if(maintenance){ %><div role="status" class="siteBanner maintenanceBanner"><div class="wrap"><strong>Maintenance</strong><span><%=maintenance%></span></div></div><% } else if(typeof activeAnnouncement!=='undefined'&&activeAnnouncement){ %><div role="status" class="siteBanner announcementBanner"><div class="wrap"><strong><%=activeAnnouncement.title%></strong><% if(activeAnnouncement.body){ %><span><%=activeAnnouncement.body%></span><% } %></div></div><% } else if(fallbackAnnouncement){ %><div role="status" class="siteBanner announcementBanner"><div class="wrap"><span><%=fallbackAnnouncement%></span></div></div><% } %>
