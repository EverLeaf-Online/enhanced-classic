<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <%
    const defaultDescription=(typeof siteDescription!=="undefined"&&siteDescription)?siteDescription:"EverLeaf Enhanced Classic MapleStory v83";
    const baseSiteUrl=(typeof siteUrl!=="undefined"&&siteUrl)?siteUrl:"https://everleafms.online";
    const pageTitle=title?title+" • "+brand.name:brand.name;
    const pageDescription=(typeof description!=="undefined"&&description)?description:defaultDescription;
    const canonicalPath=(typeof currentPath!=="undefined"&&currentPath)?currentPath:"/";
    const canonicalUrl=baseSiteUrl+canonicalPath;
    const isAdminPath=canonicalPath.startsWith("/admin");
    const isHome=canonicalPath==="/";
    const routeKey=isHome?"home":(canonicalPath.split("/").filter(Boolean)[0]||"page").replace(/[^a-z0-9-]/gi,"").toLowerCase();
  %>
  <title><%=pageTitle%></title>
  <meta name="description" content="<%=pageDescription%>">
  <meta name="theme-color" content="#12130f">
  <meta name="color-scheme" content="dark">
  <meta name="application-name" content="<%=brand.name%>">
  <meta name="robots" content="<%=isAdminPath?'noindex,nofollow':'index,follow'%>">
  <link rel="canonical" href="<%=canonicalUrl%>">
  <link rel="icon" href="/assets/everleaf-remaster.svg" type="image/svg+xml">
  <% if(isHome){ %>
    <link rel="preload" as="image" href="/assets/hero-left.webp" type="image/webp">
    <link rel="preload" as="image" href="/assets/hero-right.webp" type="image/webp">
  <% } %>

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%=brand.name%>">
  <meta property="og:title" content="<%=pageTitle%>">
  <meta property="og:description" content="<%=pageDescription%>">
  <meta property="og:url" content="<%=canonicalUrl%>">
  <meta property="og:image" content="<%=baseSiteUrl%>/assets/hero-forest.webp">
  <meta property="og:image:alt" content="EverLeaf Enhanced Classic Maple World">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%=pageTitle%>">
  <meta name="twitter:description" content="<%=pageDescription%>">
  <meta name="twitter:image" content="<%=baseSiteUrl%>/assets/hero-forest.webp">

  <!-- Legacy functional layers remain beneath the new structural system while we preserve every existing integration. -->
  <link rel="stylesheet" href="/css/maple-remaster.css">
  <link rel="stylesheet" href="/css/maple-remaster-pages.css">
  <link rel="stylesheet" href="/css/maple-jobs.css">
  <link rel="stylesheet" href="/css/maple-final.css">
  <link rel="stylesheet" href="/css/rankings-remaster.css">
  <link rel="stylesheet" href="/css/rankings-live.css?v=1">
  <link rel="stylesheet" href="/css/home-polish.css">
  <link rel="stylesheet" href="/css/wiki-remaster.css">
  <link rel="stylesheet" href="/css/wiki-library-v2.css">
  <link rel="stylesheet" href="/css/wiki-cms.css?v=1">
  <link rel="stylesheet" href="/css/wiki-player-2026.css?v=1">
  <link rel="stylesheet" href="/css/wiki-data.css?v=1">
  <link rel="stylesheet" href="/css/wiki-cleanup-2026.css?v=1">
  <% if(isAdminPath){ %>
    <link rel="stylesheet" href="/css/maple-remaster-admin.css">
    <link rel="stylesheet" href="/css/cms-knowledge.css">
  <% } %>
  <link rel="stylesheet" href="/css/uiux-2026.css?v=2">
  <link rel="stylesheet" href="/css/site-polish-2026.css?v=1">
  <link rel="stylesheet" href="/css/visuals-2026.css?v=1">
  <link rel="stylesheet" href="/css/game-portal-2026.css?v=1">
  <link rel="stylesheet" href="/css/full-site-portal-2026.css?v=1">
  <link rel="stylesheet" href="/css/refero-everleaf-2026.css?v=1">
  <link rel="stylesheet" href="/css/terminal-everleaf-2026.css?v=1">
  <script src="/js/site.js?v=1" defer></script>
</head>
<body class="terminalMode <%=isAdminPath?'adminMode ':''%><%=isHome?'homeRoute':'innerRoute'%> route-<%=routeKey%>">
<a class="skipLink" href="#main-content">Skip to content</a>
<%
  const navLinks=[
    {href:"/",label:"HOME"},
    {href:"/news",label:"WORLD LOG"},
    {href:"/downloads",label:"CLIENT"},
    {href:"/rankings",label:"HALL"},
    {href:"/wiki",label:"DATA"},
    {href:"/help",label:"HELP"},
    {href:brand.discordUrl,label:"DISCORD",external:true}
  ];
  const shellPlayer=(typeof player!=="undefined"&&player)?player:null;
  const maintenance=(typeof settings!=="undefined"&&settings&&String(settings.maintenance_message||"").trim())||"";
  const fallbackAnnouncement=(typeof settings!=="undefined"&&settings&&String(settings.announcement||"").trim())||"";
%>

<!-- retained as a compatibility marker for older tests/scripts; intentionally not part of the visible shell -->
<div class="worldRibbon" hidden aria-hidden="true">EVERLEAF WORLD</div>

<header class="terminalHeader">
  <a class="terminalBrand brand brandImage" href="/" aria-label="EverLeaf home">
    <span class="terminalBrandMark">EVERLEAF</span>
    <span class="terminalBrandMeta"><b>ENHANCED CLASSIC</b><span>V83 // <%=isAdminPath?'STAFF TERMINAL':'WORLD TERMINAL'%></span></span>
  </a>

  <div class="terminalNav desktopLinks nav" aria-label="Primary navigation">
    <% navLinks.forEach(({href,label,external})=>{ const isActive=!external&&(href==="/"?canonicalPath==="/":canonicalPath.startsWith(href)); %>
      <a class="<%=isActive?'active':''%>" href="<%=href%>"<% if(isActive){ %> aria-current="page"<% } %><% if(external){ %> target="_blank" rel="noopener noreferrer"<% } %>><%=label%></a>
    <% }) %>
    <span class="terminalAuth navActions">
      <% if(shellPlayer){ %>
        <% if(shellPlayer.isAdmin){ %><a href="/admin">CMS</a><% } %>
        <a class="accountNav primary" href="/account">ACCOUNT</a>
      <% } else { %>
        <a href="/login">LOGIN</a>
        <a class="primary" href="/register">PLAY</a>
      <% } %>
    </span>
  </div>

  <details class="terminalMobile mobileMenu">
    <summary aria-label="Open navigation" aria-controls="mobile-navigation">MENU</summary>
    <div id="mobile-navigation" class="terminalMobilePanel mobileMenuPanel">
      <% navLinks.forEach(({href,label,external})=>{ const isActive=!external&&(href==="/"?canonicalPath==="/":canonicalPath.startsWith(href)); %>
        <a class="<%=isActive?'active':''%>" href="<%=href%>"<% if(isActive){ %> aria-current="page"<% } %><% if(external){ %> target="_blank" rel="noopener noreferrer"<% } %>><%=label%></a>
      <% }) %>
      <% if(shellPlayer){ %><a class="accountNav" href="/account">ACCOUNT</a><% }else{ %><a href="/login">LOGIN</a><a href="/register">PLAY</a><% } %>
      <% if(shellPlayer&&shellPlayer.isAdmin){ %><a href="/admin">CMS</a><% } %>
    </div>
  </details>
</header>

<div class="terminalRouteTag"><%=isAdminPath?'STAFF://':'WORLD://'%><span><%=routeKey.toUpperCase()%></span> / EVERLEAFMS.ONLINE</div>

<% if(maintenance){ %>
  <div role="status" class="siteBanner terminalNotice maintenanceBanner"><strong>MAINTENANCE</strong><span><%=maintenance%></span></div>
<% } else if(typeof activeAnnouncement!=="undefined"&&activeAnnouncement){ %>
  <div role="status" class="siteBanner terminalNotice announcementBanner"><strong><%=activeAnnouncement.title%></strong><% if(activeAnnouncement.body){ %><span><%=activeAnnouncement.body%></span><% } %></div>
<% } else if(fallbackAnnouncement){ %>
  <div role="status" class="siteBanner terminalNotice announcementBanner"><strong>WORLD NOTICE</strong><span><%=fallbackAnnouncement%></span></div>
<% } %>

<div id="main-content" class="siteContent" tabindex="-1">