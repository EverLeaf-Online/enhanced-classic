<%
  const adminPath=(typeof currentPath!=="undefined"&&currentPath)?currentPath:"/admin";
  const cmsLinks=[
    ["/admin","OVERVIEW"],["/admin/knowledge","GAME DATABASE"],["/admin/news","WORLD LOG"],["/admin/announcements","ANNOUNCEMENTS"],["/admin/downloads","CLIENT FILES"],["/admin/pages","SITE PAGES"],["/admin/recoveries","RECOVERY QUEUE"],["/admin/supporters","SUPPORTERS"],["/admin/settings-view","SETTINGS"],["/admin/audit","AUDIT LOG"]
  ];
%>
<nav class="cmsManagerNav" aria-label="CMS sections">
  <% cmsLinks.forEach(([href,label])=>{ const active=href==="/admin"?adminPath==="/admin":adminPath.startsWith(href); %><a class="<%=active?'active':''%>" href="<%=href%>"<% if(active){ %> aria-current="page"<% } %>><%=label%></a><% }) %>
  <a href="/" target="_blank" rel="noopener">VIEW PUBLIC WORLD ↗</a>
</nav>
