<%
  const footerYear=(typeof year!=='undefined'&&year)?year:new Date().getFullYear();
  const footerSettings=(typeof settings!=='undefined'&&settings)?settings:{};
%>
<footer class="siteFooter terminalFooter">
  <div class="wrap terminalFooterGrid">
    <div class="terminalFooterBrand">
      <a class="terminalFooterWord" href="/" aria-label="EverLeaf home">EVERLEAF</a>
      <p>Enhanced Classic v83. A community-first Maple world built around recognizable progression, fair systems, and a long road worth sharing.</p>
    </div>
    <div class="terminalFooterMeta">
      <span>WORLD / 083</span>
      <span>STATUS / LIVE</span>
      <span>BUILD / COMMUNITY</span>
    </div>
    <nav class="terminalFooterLinks" aria-label="Footer navigation">
      <a href="/news">JOURNAL</a>
      <a href="/downloads">DOWNLOAD</a>
      <a href="/rankings">RANKINGS</a>
      <a href="/wiki">WIKI</a>
      <a href="/help">HELP</a>
      <a href="/about">About</a>
      <a href="/rules">Rules</a>
      <a href="/terms">Terms</a>
      <a href="<%=brand.discordUrl%>" target="_blank" rel="noopener noreferrer">DISCORD ↗</a>
