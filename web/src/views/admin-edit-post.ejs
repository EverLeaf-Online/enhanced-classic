<%- include("partials/header",{title:"Edit Post"}) %><main class="adminShell">
<aside class="sidebar"><div class="sideLogo">🍃 EverLeaf CMS</div><a class="sideLink" href="/admin"><span class="sideIcon">🏠</span>Dashboard</a><a class="sideLink active" href="#"><span class="sideIcon">📰</span>News</a><a class="sideLink" href="/admin#announcements"><span class="sideIcon">📣</span>Announcements</a><a class="sideLink" href="/admin#downloads"><span class="sideIcon">⬇</span>Downloads</a><a class="sideLink" href="/admin#pages"><span class="sideIcon">📄</span>Pages</a><a class="sideLink" href="/admin#users"><span class="sideIcon">👤</span>Users</a><a class="sideLink" href="/admin#donations"><span class="sideIcon">💲</span>Donations</a><a class="sideLink" href="/admin#settings"><span class="sideIcon">⚙</span>Settings</a><a class="sideLink" href="/admin#logs"><span class="sideIcon">🗒</span>Logs</a><form method="post" action="/admin/logout"><button class="btn small sideLogout"><span class="sideIcon">↩</span>Logout</button></form></aside>
<section class="adminMain">
<div class="adminTop"><div><h1 style="margin:0">Edit News Post</h1><div class="muted"><%=post.title%></div></div></div>
<form method="post" id="editPostForm">
<div class="editTabs"><button type="button" class="editTab active" data-tab="general">General</button><button type="button" class="editTab" data-tab="content">Content</button><button type="button" class="editTab" data-tab="preview">Preview</button></div>
<div class="editPane" data-pane="general"><div class="adminCard"><label>Title</label><input name="title" id="fieldTitle" value="<%=post.title%>" required><label>Slug</label><input name="slug" value="<%=post.slug%>"><div class="editGrid2"><div><label>Category</label><select name="type" id="fieldType"><option value="news" <%=post.type==='news'?'selected':''%>>Updates</option><option value="patch" <%=post.type==='patch'?'selected':''%>>Patch Notes</option><option value="event" <%=post.type==='event'?'selected':''%>>Events</option></select></div><div><label>Status</label><select id="fieldStatus"><option value="published" <%=post.published?'selected':''%>>Published</option><option value="draft" <%=!post.published?'selected':''%>>Draft</option></select><input type="hidden" name="published" id="hiddenPublished" value="<%=post.published?1:0%>"></div></div><label>Featured Image</label><div class="featuredImageRow"><img src="/assets/news-welcome.webp" alt="" class="featuredImageThumb"><div class="muted" style="font-size:12px">Featured image uploads are coming in a future update. This preview image is used automatically on the News page.</div></div><label>Published At</label><input value="<%=String(post.created_at||'').slice(0,16).replace('T',' ')%>" disabled></div></div>
<div class="editPane" data-pane="content" style="display:none"><div class="adminCard"><label>Excerpt</label><textarea name="excerpt" id="fieldExcerpt"><%=post.excerpt%></textarea><label>Body</label><textarea name="body" id="fieldBody" style="min-height:280px"><%=post.body%></textarea></div></div>
<div class="editPane" data-pane="preview" style="display:none"><div class="adminCard"><div class="newsCard" style="max-width:420px"><div class="newsArtImage"><img src="/assets/news-welcome.webp" alt=""><span class="badge" id="previewBadge"><%=post.type.toUpperCase()%></span></div><div class="newsBody"><div class="newsTitle" id="previewTitle"><%=post.title||'Untitled Post'%></div><div class="newsExcerpt" id="previewExcerpt"><%=post.excerpt||'No excerpt yet.'%></div></div></div></div></div>
<div class="editActions"><a class="btn" href="/admin">Cancel</a><button type="submit" class="btn" id="saveDraftBtn" formnovalidate>Save as Draft</button><button type="submit" class="btn primary">Update Post</button></div>
</form></section></main>
<script>(function(){var tabs=document.querySelectorAll('.editTab');var panes=document.querySelectorAll('.editPane');tabs.forEach(function(tab){tab.addEventListener('click',function(){tabs.forEach(function(t){t.classList.remove('active')});tab.classList.add('active');var name=tab.getAttribute('data-tab');panes.forEach(function(p){p.style.display=(p.getAttribute('data-pane')===name)?'':'none';});if(name==='preview'){document.getElementById('previewTitle').textContent=document.getElementById('fieldTitle').value||'Untitled Post';document.getElementById('previewExcerpt').textContent=document.getElementById('fieldExcerpt').value||'No excerpt yet.';var typeSel=document.getElementById('fieldType');document.getElementById('previewBadge').textContent=typeSel.options[typeSel.selectedIndex].text.toUpperCase();}});});var statusSel=document.getElementById('fieldStatus');var hiddenPublished=document.getElementById('hiddenPublished');statusSel.addEventListener('change',function(){hiddenPublished.value=statusSel.value==='published'?'1':'0';});document.getElementById('saveDraftBtn').addEventListener('click',function(){hiddenPublished.value='0';});})();</script>
<%- include("partials/footer") %>
