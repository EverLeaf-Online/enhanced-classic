<%- include("partials/header",{title:"Edit Post"}) %>
<main class="lightPage">
  <section class="lightTitle"><div class="wrap"><div class="pageEyebrow">CMS://WORLD LOG EDITOR</div><h1>EDIT ENTRY.</h1><p><%=post.title%></p></div></section>
  <%- include("partials/admin-manager-nav") %>
  <div class="cmsWorkspaceSingle">
    <form method="post" id="editPostForm">
      <div class="editTabs"><button type="button" class="editTab active" data-tab="general">META</button><button type="button" class="editTab" data-tab="content">CONTENT</button><button type="button" class="editTab" data-tab="preview">PREVIEW</button></div>

      <div class="editPane" data-pane="general">
        <section class="cmsPanel"><div class="cmsManagerTitle"><h2>ENTRY METADATA</h2><p>Route, category, and publication state.</p></div>
          <label>Title</label><input name="title" id="fieldTitle" value="<%=post.title%>" required>
          <label>Slug</label><input name="slug" value="<%=post.slug%>">
          <div class="editGrid2"><div><label>Category</label><select name="type" id="fieldType"><option value="news" <%=post.type==='news'?'selected':''%>>Updates</option><option value="patch" <%=post.type==='patch'?'selected':''%>>Patch Notes</option><option value="event" <%=post.type==='event'?'selected':''%>>Events</option></select></div><div><label>Status</label><select id="fieldStatus"><option value="published" <%=post.published?'selected':''%>>Published</option><option value="draft" <%=!post.published?'selected':''%>>Draft</option></select><input type="hidden" name="published" id="hiddenPublished" value="<%=post.published?1:0%>"></div></div>
          <label>Published At</label><input value="<%=String(post.created_at||'').slice(0,16).replace('T',' ')%>" disabled>
        </section>
      </div>

      <div class="editPane" data-pane="content" style="display:none"><section class="cmsPanel"><div class="cmsManagerTitle"><h2>ENTRY CONTENT</h2><p>Summary and full public body.</p></div><label>Excerpt</label><textarea name="excerpt" id="fieldExcerpt"><%=post.excerpt%></textarea><label>Body</label><textarea name="body" id="fieldBody" style="min-height:520px"><%=post.body%></textarea></section></div>

      <div class="editPane" data-pane="preview" style="display:none"><section class="cmsPanel"><div class="cmsManagerTitle"><h2>PUBLIC PREVIEW</h2><p>Approximate World Log presentation.</p></div><div class="terminalLogRows"><div class="terminalLogRow"><span class="terminalLogDate"><%=String(post.created_at||'').slice(0,10)%></span><span class="terminalLogType" id="previewBadge"><%=post.type.toUpperCase()%></span><strong class="terminalLogTitle" id="previewTitle"><%=post.title||'Untitled Post'%></strong><span class="terminalLogExcerpt" id="previewExcerpt"><%=post.excerpt||'No excerpt yet.'%></span><span>→</span></div></div></section></div>

      <div class="editActions"><a class="btn" href="/admin/news">CANCEL</a><button type="submit" class="btn" id="saveDraftBtn" formnovalidate>SAVE DRAFT</button><button type="submit" class="btn primary">UPDATE ENTRY</button></div>
    </form>
  </div>
</main>
<script>(function(){var tabs=document.querySelectorAll('.editTab');var panes=document.querySelectorAll('.editPane');tabs.forEach(function(tab){tab.addEventListener('click',function(){tabs.forEach(function(t){t.classList.remove('active')});tab.classList.add('active');var name=tab.getAttribute('data-tab');panes.forEach(function(p){p.style.display=(p.getAttribute('data-pane')===name)?'':'none';});if(name==='preview'){document.getElementById('previewTitle').textContent=document.getElementById('fieldTitle').value||'Untitled Post';document.getElementById('previewExcerpt').textContent=document.getElementById('fieldExcerpt').value||'No excerpt yet.';var typeSel=document.getElementById('fieldType');document.getElementById('previewBadge').textContent=typeSel.options[typeSel.selectedIndex].text.toUpperCase();}});});var statusSel=document.getElementById('fieldStatus');var hiddenPublished=document.getElementById('hiddenPublished');statusSel.addEventListener('change',function(){hiddenPublished.value=statusSel.value==='published'?'1':'0';});document.getElementById('saveDraftBtn').addEventListener('click',function(){hiddenPublished.value='0';});})();</script>
<%- include("partials/footer") %>
