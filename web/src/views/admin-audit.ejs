<%- include("partials/header",{title:"CMS Audit Log"}) %><main class="lightPage"><div class="lightTitle"><div class="wrap"><h1>Admin Activity</h1><p>Review recent CMS actions and changes.</p></div></div><div class="wrap" style="max-width:1050px"><div class="paperCard"><div style="display:flex;justify-content:space-between;align-items:center"><h2 style="margin:0">Audit Log</h2><a class="btn small" href="/admin">Dashboard</a></div><p class="muted"><%=total%> recorded action<%=total===1?'':'s'%>.</p><% rows.forEach(entry=>{ %><div class="adminRow"><strong><%=entry.action%></strong><span class="muted" style="float:right"><%=entry.created_at%></span><div class="muted"><%=entry.admin_name||'system/admin'%><%=entry.details?' · '+entry.details:''%></div></div><% }) %><% if(!rows.length){ %><p class="muted">No recorded admin actions yet.</p><% } %><% if(totalPages>1){ %><div class="pagination"><% for(let p=Math.max(1,currentPage-2);p<=Math.min(totalPages,currentPage+2);p++){ %><a class="pageBtn <%=p===currentPage?'active':''%>" href="/admin/audit?page=<%=p%>"><%=p%></a><% } %></div><% } %></div></div></main><%- include("partials/footer") %>
