<%- include("partials/header",{title:"CMS Audit Log"}) %><main class="lightPage"><section class="lightTitle"><div class="wrap"><div class="pageEyebrow">CMS Workspace</div><h1>Admin Activity</h1><p>Review website management actions and recent CMS changes.</p></div></section><%- include("partials/admin-manager-nav") %><div class="cmsWorkspaceSingle"><section class="cmsPanel"><div class="cmsManagerTitle"><h2>Audit Log</h2><p><%=total%> recorded action<%=total===1?'':'s'%>.</p></div><% rows.forEach(entry=>{ %><div class="cmsItem"><div><strong><%=entry.action%></strong><div class="cmsMeta"><%=entry.admin_name||'system/admin'%><%=entry.details?' · '+entry.details:''%></div></div><span class="cmsMeta"><%=entry.created_at%></span></div><% }) %><% if(!rows.length){ %><p class="muted">No recorded admin actions yet.</p><% } %><% if(totalPages>1){ %><div class="pagination"><% for(let p=Math.max(1,currentPage-2);p<=Math.min(totalPages,currentPage+2);p++){ %><a class="pageBtn <%=p===currentPage?'active':''%>" href="/admin/audit?page=<%=p%>"><%=p%></a><% } %></div><% } %></section></div></main><%- include("partials/footer") %>
