<%- include("partials/header",{title:"Home",player:sessionPlayer}) %>
<%
const homeJobArt=(name='')=>{
  const n=String(name).toLowerCase();
  if(/aran/.test(n)) return '/assets/jobs/special/aran.png';
  if(/evan/.test(n)) return '/assets/jobs/special/evan.png';
  if(/cygnus|dawn warrior|blaze wizard|wind archer|night walker|thunder breaker|noblesse/.test(n)) return '/assets/jobs/special/cygnus-clean.png';
  if(/warrior|fighter|crusader|hero|page|white knight|paladin|spearman|dragon knight|dark knight/.test(n)) return '/assets/jobs/instructors/warrior.png';
  if(/magician|wizard|mage|cleric|priest|bishop/.test(n)) return '/assets/jobs/instructors/magician.png';
  if(/bowman|archer|hunter|ranger|bowmaster|crossbow|sniper|marksman/.test(n)) return '/assets/jobs/instructors/bowman.png';
  if(/thief|rogue|assassin|hermit|night lord|bandit|chief bandit|shadower/.test(n)) return '/assets/jobs/instructors/thief.png';
  if(/pirate|brawler|marauder|buccaneer|gunslinger|outlaw|corsair/.test(n)) return '/assets/jobs/instructors/pirate.png';
  return '/assets/jobs/beginner/beginner-clean.png';
};
const homeAvatar=(r)=>`/character-avatar/${Number(r.id)}.png?job=${Number(r.job||0)}`;
const fmt=n=>Number(n||0).toLocaleString();
const worldState=status.online?'ONLINE':'OFFLINE';
%>

<main class="terminalHome">
  <section class="terminalHero" aria-labelledby="terminal-home-title">
    <div class="terminalHeroIntro">
      <span class="terminalLabel">WORLD INSTANCE // ENHANCED CLASSIC V83</span>
      <h1 id="terminal-home-title">MAPLE<br>WORLD<br>RUNNING.</h1>
      <p>EverLeaf keeps the familiar v83 adventure intact while improving the systems around it: fair progression, launcher-managed updates, live data tools, and a world intended to last.</p>
    </div>

    <div class="terminalHeroArtifact" aria-label="EverLeaf Maple World artwork">
      <div class="artifactRing" aria-hidden="true"></div>
      <img class="artifactMark" src="/assets/everleaf-remaster.svg" alt="EverLeaf Enhanced Classic">
      <img class="artifactChar left" src="/assets/hero-left.webp" alt="" aria-hidden="true" decoding="async">
      <img class="artifactChar right" src="/assets/hero-right.webp" alt="" aria-hidden="true" decoding="async">
    </div>

    <div id="server-status" class="terminalWorldReadout" aria-live="polite">
      <span class="pageEyebrow">EVERLEAF WORLD / LIVE STATE</span>
      <strong id="live-status" class="worldState <%=status.online?'online':''%>"><%=worldState%></strong>
      <div class="terminalTelemetry">
        <div><small>PLAYERS</small><strong id="live-players"><%=players===null?'—':fmt(players)%></strong></div>
        <div><small>CHANNELS</small><strong id="live-channels"><%=status.channels%>/<%=status.totalChannels%></strong></div>
        <div><small>CLIENT</small><strong><%=brand.version%></strong></div>
        <div><small>STATUS</small><strong id="live-state-label"><%=status.online?'READY':'UNAVAILABLE'%></strong></div>
      </div>
      <span id="live-refresh" class="pageEyebrow">Live status refresh active</span>
    </div>

    <nav class="terminalHeroActions" aria-label="EverLeaf primary actions">
      <a class="primary" href="<%=sessionPlayer?'/downloads':'/register'%>"><%=sessionPlayer?'Launch EverLeaf':'Create Account'%></a>
      <a href="/downloads">Client Setup</a>
      <a href="/wiki">Query World Data</a>
      <a href="/rankings">Hall of Legends</a>
      <a href="<%=brand.discordUrl%>" target="_blank" rel="noopener noreferrer">Discord</a>
    </nav>
  </section>

  <section class="terminalSection homeJourney" aria-labelledby="start-sequence-title">
    <aside class="terminalSectionIndex"><span>01 / START</span><b>BOOT SEQUENCE</b><span>3 REQUIRED STEPS</span></aside>
    <div class="terminalSectionBody">
      <h2 id="start-sequence-title">ENTER THE WORLD.</h2>
      <div class="terminalRowList">
        <a class="terminalRow" href="<%=sessionPlayer?'/account':'/register'%>"><span class="terminalRowCode">STEP 01</span><strong class="terminalRowTitle"><%=sessionPlayer?'Account ready':'Create one account'%></strong><span class="terminalRowCopy"><%=sessionPlayer?'Review your characters and account state before launching.':'Your website login is also your EverLeaf game account.'%></span><span class="terminalRowArrow">→</span></a>
        <a class="terminalRow" href="/downloads"><span class="terminalRowCode">STEP 02</span><strong class="terminalRowTitle">Install the launcher</strong><span class="terminalRowCopy">The supported launcher installs, verifies, repairs, updates, and starts the v83 client.</span><span class="terminalRowArrow">→</span></a>
        <a class="terminalRow" href="/help"><span class="terminalRowCode">STEP 03</span><strong class="terminalRowTitle">Connect to Maple World</strong><span class="terminalRowCopy">Choose a channel and play. If Windows or the client blocks the path, use the player help terminal.</span><span class="terminalRowArrow">→</span></a>
      </div>
    </div>
  </section>

  <section class="terminalSection" aria-labelledby="world-data-title">
    <aside class="terminalSectionIndex"><span>02 / DATA</span><b>WORLD INDEX</b><span>WZ + MYSQL</span></aside>
    <div class="terminalSectionBody">
      <h2 id="world-data-title">QUERY WHAT THE SERVER KNOWS.</h2>
      <div class="terminalRowList">
        <% (featuredWiki||[]).slice(0,4).forEach((entry,i)=>{ %>
          <a class="terminalRow" href="/wiki/<%=entry.slug%>"><span class="terminalRowCode"><%=String(i+1).padStart(2,'0')%> / GUIDE</span><strong class="terminalRowTitle"><%=entry.title%></strong><span class="terminalRowCopy"><%=entry.summary%></span><span class="terminalRowArrow">→</span></a>
        <% }) %>
        <a class="terminalRow" href="/wiki"><span class="terminalRowCode">LIVE / DB</span><strong class="terminalRowTitle">Open the full data explorer</strong><span class="terminalRowCopy">Items, monsters, maps, skills, NPCs, quests, drops, shops, and world connections sourced from EverLeaf data.</span><span class="terminalRowArrow">→</span></a>
      </div>
    </div>
  </section>

  <section class="terminalSection mapleJobsPolished" aria-labelledby="job-index-title">
    <aside class="terminalSectionIndex"><span>03 / JOBS</span><b>JOB INDEX</b><span>CLASS ROUTES</span></aside>
    <div class="terminalSectionBody">
      <h2 id="job-index-title">CHOOSE YOUR PROCESS.</h2>
      <div class="terminalJobGrid">
        <a class="terminalJob" href="/wiki"><span class="terminalJobMeta">00 / STARTER</span><strong>Beginner</strong><img src="/assets/jobs/beginner/beginner-clean.png" alt="Beginner" loading="lazy"></a>
        <a class="terminalJob" href="/wiki"><span class="terminalJobMeta">01 / STR / FRONTLINE</span><strong>Warrior</strong><img src="/assets/jobs/instructors/warrior.png" alt="Warrior" loading="lazy"></a>
        <a class="terminalJob" href="/wiki"><span class="terminalJobMeta">02 / INT / MAGIC</span><strong>Magician</strong><img src="/assets/jobs/instructors/magician.png" alt="Magician" loading="lazy"></a>
        <a class="terminalJob" href="/wiki"><span class="terminalJobMeta">03 / DEX / RANGE</span><strong>Bowman</strong><img src="/assets/jobs/instructors/bowman.png" alt="Bowman" loading="lazy"></a>
        <a class="terminalJob" href="/wiki"><span class="terminalJobMeta">04 / LUK / MOBILITY</span><strong>Thief</strong><img src="/assets/jobs/instructors/thief.png" alt="Thief" loading="lazy"></a>
        <a class="terminalJob" href="/wiki"><span class="terminalJobMeta">05 / HYBRID</span><strong>Pirate</strong><img src="/assets/jobs/instructors/pirate.png" alt="Pirate" loading="lazy"></a>
        <a class="terminalJob" href="/wiki"><span class="terminalJobMeta">06 / EREVE</span><strong>Cygnus</strong><img src="/assets/jobs/special/cygnus-clean.png" alt="Cygnus Knights" loading="lazy"></a>
        <a class="terminalJob" href="/wiki"><span class="terminalJobMeta">07 / RIEN</span><strong>Aran</strong><img src="/assets/jobs/special/aran.png" alt="Aran" loading="lazy"></a>
        <a class="terminalJob" href="/wiki"><span class="terminalJobMeta">08 / DRAGON MASTER</span><strong>Evan</strong><img src="/assets/jobs/special/evan.png" alt="Evan" loading="lazy"></a>
      </div>
    </div>
  </section>

  <section class="terminalSection" aria-labelledby="world-log-title">
    <aside class="terminalSectionIndex"><span>04 / LOG</span><b>WORLD JOURNAL</b><span><%=posts.length%> ENTRIES LOADED</span></aside>
    <div class="terminalSectionBody">
      <h2 id="world-log-title">LATEST WORLD EVENTS.</h2>
      <div class="terminalRowList">
        <% posts.slice(0,5).forEach((p,i)=>{ %>
          <a class="terminalRow" href="/news/<%=p.slug%>"><span class="terminalRowCode"><%=String(p.created_at).slice(0,10)%><br><%=String(p.type||'news').toUpperCase()%></span><strong class="terminalRowTitle"><%=p.title%></strong><span class="terminalRowCopy"><%=p.excerpt%></span><span class="terminalRowArrow">→</span></a>
        <% }) %>
        <% if(!posts.length){ %><div class="terminalRow"><span class="terminalRowCode">NO DATA</span><strong class="terminalRowTitle">No journal entries yet.</strong><span class="terminalRowCopy">Published server updates will appear here.</span><span class="terminalRowArrow">—</span></div><% } %>
      </div>
    </div>
  </section>

  <section class="terminalSection" aria-labelledby="hall-preview-title">
    <aside class="terminalSectionIndex"><span>05 / HALL</span><b>LIVE RANKING</b><span>MYSQL + CHARACTER.WZ</span></aside>
    <div class="terminalSectionBody">
      <h2 id="hall-preview-title">WHO IS LEADING NOW.</h2>
      <div class="terminalRankingPreview">
        <% (topCharacters||[]).slice(0,5).forEach((r,i)=>{ %>
          <a class="terminalRank" href="/rankings">
            <small>#<%=i+1%> // <%=r.jobName||'ADVENTURER'%></small>
            <img src="<%=homeJobArt(r.jobName)%>" data-live-avatar="<%=homeAvatar(r)%>" alt="<%=r.name%>'s EverLeaf character portrait" loading="lazy">
            <span><strong><%=r.name%></strong><small>LV. <%=fmt(r.level)%> // FAME <%=fmt(r.fame)%></small></span>
          </a>
        <% }) %>
        <% if(!(topCharacters||[]).length){ %><a class="terminalRank" href="/rankings"><small>HALL // EMPTY</small><img src="/assets/jobs/beginner/beginner-clean.png" alt=""><span><strong>Open rankings</strong><small>LIVE DATA</small></span></a><% } %>
      </div>
    </div>
  </section>
</main>

<%- include("partials/footer") %>
