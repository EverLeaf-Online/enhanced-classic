<%- include("partials/header",{title:"Home",player:sessionPlayer}) %>

<section class="terminalHero" aria-labelledby="everleaf-home-title">
  <div class="terminalHeroBackdrop" aria-hidden="true"></div>
  <div class="terminalHeroNoise" aria-hidden="true"></div>

  <div class="wrap terminalHeroGrid">
    <div class="terminalHeroIdentity">
      <div class="terminalLabel"><span>WORLD 01</span><span>ENHANCED CLASSIC</span><span>REV 083</span></div>
      <h1 id="everleaf-home-title"><span>EVER</span><span>LEAF</span></h1>
      <p class="terminalHeroLead">Classic MapleStory foundations, rebuilt around fair progression, community development, launcher-managed updates, and a world meant to last.</p>
      <div class="terminalHeroActions">
        <a class="btn primary" href="<%=sessionPlayer?'/downloads':'/register'%>"><%=sessionPlayer?'ENTER EVERLEAF':'CREATE ACCOUNT'%></a>
        <a class="btn ghost" href="/downloads">DOWNLOAD LAUNCHER</a>
      </div>
    </div>

    <div class="everleafArtifact" aria-label="EverLeaf Maple World artwork">
      <div class="artifactHalo artifactHaloOne" aria-hidden="true"></div>
      <div class="artifactHalo artifactHaloTwo" aria-hidden="true"></div>
      <div class="artifactCrosshair" aria-hidden="true"><span></span><span></span></div>
      <img class="artifactCharacter artifactCharacterBack" src="/assets/hero-left.webp" alt="" decoding="async">
      <img class="artifactCharacter artifactCharacterFront" src="/assets/hero-right.webp" alt="Maple World adventurers" decoding="async">
      <div class="artifactStamp" aria-hidden="true"><span>EL</span><small>WORLD<br>083</small></div>
      <div class="artifactTelemetry" aria-hidden="true"><span>MAPLE WORLD / ONLINE</span><span>LOCAL ASSET / 02</span></div>
    </div>

    <aside id="server-status" class="heroTelemetry" aria-label="EverLeaf live server status">
      <div class="telemetryHeader">
        <span>LIVE WORLD TELEMETRY</span>
        <span class="liveState"><i id="live-dot" class="liveDot <%=status.online?'online':''%>" aria-hidden="true"></i><span id="live-state-label"><%=status.online?'OPEN':'UNAVAILABLE'%></span></span>
      </div>
      <div class="telemetryReadout">
        <div><small>SERVER</small><strong id="live-status" class="<%=status.online?'online':''%>"><%=status.online?'ONLINE':'OFFLINE'%></strong></div>
        <div><small>PLAYERS</small><strong id="live-players"><%=players===null?'—':players%></strong></div>
        <div><small>CHANNELS</small><strong id="live-channels"><%=status.channels%>/<%=status.totalChannels%></strong></div>
        <div><small>CLIENT</small><strong><%=brand.version%></strong></div>
      </div>
      <div class="telemetryFooter"><span id="live-refresh">Refreshing live status…</span><a href="/help">SYSTEM HELP ↗</a></div>
    </aside>
  </div>

  <div class="wrap heroEdgeRail">
    <div><span class="terminalLabel">CORE PRINCIPLES</span><p>NO PAY-TO-WIN / NO MANDATORY HP WASHING / COMMUNITY-FIRST</p></div>
    <div class="heroEdgeLinks"><a href="/wiki">WIKI ↗</a><a href="/rankings">RANKINGS ↗</a><a href="<%=brand.discordUrl%>" target="_blank" rel="noopener noreferrer">DISCORD ↗</a></div>
  </div>
</section>

<nav class="signalStrip" aria-label="EverLeaf primary navigation">
  <div class="wrap signalStripGrid">
    <a href="/downloads"><span>01</span><strong>DOWNLOAD</strong><small>Launcher + client</small></a>
    <a href="<%=sessionPlayer?'/account':'/login'%>"><span>02</span><strong><%=sessionPlayer?'ACCOUNT':'LOGIN'%></strong><small>Characters + security</small></a>
    <a href="/rankings"><span>03</span><strong>RANKINGS</strong><small>Live character data</small></a>
    <a href="/wiki"><span>04</span><strong>WIKI</strong><small>Systems + knowledge</small></a>
    <a href="/news"><span>05</span><strong>JOURNAL</strong><small>Updates + events</small></a>
  </div>
</nav>

<%- include("partials/footer",{player:sessionPlayer}) %>
