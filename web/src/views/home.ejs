<%- include("partials/header",{title:"Home",player:sessionPlayer}) %>
<section class="homeV2Hero"><div class="homeV2Bg" aria-hidden="true"></div><div class="homeV2Shade" aria-hidden="true"></div><div class="homeV2Characters" aria-hidden="true"><img src="/assets/hero-left.webp" alt=""><img src="/assets/hero-right.webp" alt=""></div><div class="wrap homeV2Inner"><div class="homeV2Copy"><div class="homeV2Tag">MapleStory v83 · Enhanced Classic</div><img class="homeV2Logo" src="/assets/everleaf-logo.webp" alt="EverLeaf"><h1>Classic MapleStory, built to last.</h1><p>Relive the v83 era with modern quality-of-life, long-term progression, 20 channels, community-first development, and no pay-to-win advantage.</p><div class="homeV2Actions"><a class="btn primary" href="<%=sessionPlayer?'/downloads':'/register'%>"><%=sessionPlayer?'DOWNLOAD & PLAY':'CREATE ACCOUNT'%></a><a class="btn" href="/downloads">GET THE LAUNCHER</a><a class="btn ghost" href="/about">DISCOVER EVERLEAF</a></div><div class="homeV2Facts"><span>Enhanced Classic progression</span><span>Launcher-managed updates</span><span>No mandatory HP washing</span></div></div><aside class="homeV2Status"><div class="homeV2StatusHead"><strong>EverLeaf Live</strong><span class="kicker"><%=status.online?'Online':'Offline'%></span></div><div class="homeV2StatusGrid"><div class="homeV2Metric"><small>Server</small><strong id="live-status" class="<%=status.online?'online':''%>"><%=status.online?'ONLINE':'OFFLINE'%></strong></div><div class="homeV2Metric"><small>Players</small><strong id="live-players"><%=players===null?'—':players%></strong></div><div class="homeV2Metric"><small>Channels</small><strong id="live-channels" class="gold"><%=status.channels%>/<%=status.totalChannels%></strong></div><div class="homeV2Metric"><small>Version</small><strong><%=brand.version%></strong></div></div></aside></div></section>
<section class="homeV2Body"><div class="wrap"><div class="homeV2Features homeFeatureGrid"><a class="homeV2Feature homeFeature" href="/about"><span>🍃</span><strong>Enhanced Classic</strong><small>Familiar v83 gameplay with thoughtful progression and quality-of-life improvements.</small></a><a class="homeV2Feature homeFeature" href="/downloads"><span>⚡</span><strong>One-Click Updates</strong><small>The EverLeaf launcher installs, repairs, updates, and starts your client.</small></a><a class="homeV2Feature homeFeature" href="/rules"><span>⚖️</span><strong>Fair Progression</strong><small>No pay-to-win advantage and no mandatory HP washing.</small></a><a class="homeV2Feature homeFeature" href="<%=brand.discordUrl%>" target="_blank" rel="noopener noreferrer"><span>💬</span><strong>Community Driven</strong><small>Join players and staff on Discord and help shape EverLeaf.</small></a></div>
<div class="homeV2Content"><section><div class="sectionHead"><div><div class="pageEyebrow">Latest from EverLeaf</div><h2>News & Updates</h2></div><a href="/news">VIEW ALL →</a></div><div class="homeV2News"><% const newsImages=['/assets/news-welcome.webp','/assets/news-event.webp','/assets/news-patch.webp']; %><% posts.slice(0,3).forEach((p,i)=>{ %><a class="newsStory" href="/news/<%=p.slug%>"><img src="<%=newsImages[i%newsImages.length]%>" alt=""><div class="newsStoryBody"><div class="newsStoryMeta"><span class="kicker"><%=p.type%></span><span><%=String(p.created_at).slice(0,10)%></span></div><h3><%=p.title%></h3><p><%=p.excerpt%></p><strong>Read update →</strong></div></a><% }) %><% if(!posts.length){ %><div class="newsStory"><img src="/assets/news-welcome.webp" alt=""><div class="newsStoryBody"><span class="kicker">UPDATE</span><h3>Welcome to EverLeaf</h3><p>Server news and patch notes will appear here.</p></div></div><% } %></div></section><aside><div class="homeV2Rank"><div class="homeV2RankHead"><div class="pageEyebrow">Leaderboard</div><h2>Top Characters</h2></div><% (topCharacters||[]).slice(0,6).forEach((r,i)=>{ %><div class="homeV2RankRow"><span class="homeV2RankNo"><%=i+1%></span><span><strong><%=r.name%></strong><% if(r.jobName){ %><small><%=r.jobName%></small><% } %></span><strong class="rankLv"><%=r.level%></strong></div><% }) %><% if(!(topCharacters||[]).length){ %><div class="homeV2RankRow"><span class="homeV2RankNo">1</span><span>Rankings coming soon</span><strong>—</strong></div><% } %><div style="padding:16px"><a class="btn" href="/rankings" style="width:100%">FULL RANKINGS</a></div></div></aside></div>
<div class="homeV2BottomCta homeCta"><div><span class="kicker">READY TO BEGIN?</span><h2>Your MapleStory adventure is waiting.</h2><p>Create an account, download the launcher, and enter EverLeaf.</p></div><div class="homeV2BottomActions homeCtaActions"><a class="btn primary" href="<%=sessionPlayer?'/downloads':'/register'%>"><%=sessionPlayer?'DOWNLOAD LAUNCHER':'CREATE ACCOUNT'%></a><a class="btn" href="/help">NEED HELP?</a></div></div></div></section>
<script src="/js/home-status.js" defer></script><%- include("partials/footer") %>
