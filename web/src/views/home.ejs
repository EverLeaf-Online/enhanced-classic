<%- include("partials/header",{title:"Home",player:sessionPlayer}) %>
<section class="mapleHero homeV2Hero"><div class="mapleHeroBg" aria-hidden="true"></div><div class="mapleHeroShade" aria-hidden="true"></div><div class="mapleHeroCharacters" aria-hidden="true"><img class="left" src="/assets/hero-left.webp" alt=""><img class="right" src="/assets/hero-right.webp" alt=""></div><div class="wrap mapleHeroInner"><div class="mapleHeroCopy"><div class="mapleHeroTag">WELCOME BACK TO MAPLE WORLD</div><img class="heroBrand" src="/assets/everleaf-remaster.svg" alt="EverLeaf Enhanced Classic"><h1>Classic Maple,<em>grown with care.</em></h1><p>EverLeaf keeps the familiar v83 adventure at its core, then improves the road around it: thoughtful quality-of-life, fair progression, launcher-managed updates, community development, and a world designed to last.</p><div class="mapleHeroActions"><a class="btn primary" href="<%=sessionPlayer?'/downloads':'/register'%>"><%=sessionPlayer?'PLAY EVERLEAF':'START YOUR JOURNEY'%></a><a class="btn" href="/downloads">GET THE LAUNCHER</a><a class="btn ghost" href="/wiki">OPEN WIKI</a></div><div class="mapleHeroFacts"><span>Enhanced Classic v83</span><span>No mandatory HP washing</span><span>No pay-to-win advantage</span><span>20 channels</span></div></div><aside class="mapleLive homeV2Status"><div class="mapleLiveHead"><strong>EverLeaf World</strong><span><%=status.online?'Open for adventure':'Currently unavailable'%></span></div><div class="mapleLiveGrid"><div class="mapleLiveMetric"><small>Server</small><strong id="live-status" class="<%=status.online?'online':''%>"><%=status.online?'ONLINE':'OFFLINE'%></strong></div><div class="mapleLiveMetric"><small>Players</small><strong id="live-players"><%=players===null?'—':players%></strong></div><div class="mapleLiveMetric"><small>Channels</small><strong id="live-channels" class="gold"><%=status.channels%>/<%=status.totalChannels%></strong></div><div class="mapleLiveMetric"><small>Client</small><strong><%=brand.version%></strong></div></div><div class="mapleLiveFoot">Live