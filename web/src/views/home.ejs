<%- include("partials/header",{title:"Home",player:sessionPlayer}) %>

<section class="terminalHero" aria-labelledby="everleaf-home-title">
  <div class="terminalHeroBackdrop" aria-hidden="true"></div>
  <div class="terminalHeroNoise" aria-hidden="true"></div>

  <div class="wrap terminalHeroGrid">
    <div class="terminalHeroIdentity">
      <div class="terminalLabel"><span>WORLD 01</span><span>ENHANCED CLASSIC</span><span>REV 083</span></div>
      <h1 id="everleaf-home-title"><span>EVER</span><span>LEAF</span></h1>
      <p class="terminalHeroLead">Classic MapleStory foundations, rebuilt around fair progression, community development, launcher-managed updates, and a world meant to last.</p>
      <div class="terminalHeroActions">
        <a class="btn primary" href="<%=sessionPlayer?'/downloads':'/register'%>"><%=sessionPlayer?'ENTER EVERLEAF':'CREATE ACCOUNT'%></a>
        <a class="btn ghost" href="/downloads">DOWNLOAD LAUNCHER</a>
      </div>
    </div>

    <div class="everleafArtifact" aria-label="EverLeaf Maple World artwork">
      <div class="artifactHalo artifactHaloOne" aria-hidden="true"></div>
      <div class="artifactHalo artifactHaloTwo" aria-hidden="true"></div>
      <div class="artifactCrosshair" aria-hidden="true"><span></span><span></span></div>
      <img class="artifactCharacter artifactCharacterBack" src="/assets/hero-left.webp" alt="" decoding="async">
      <img class="artifactCharacter artifactCharacterFront" src="/assets/hero-right.webp" alt="Maple World adventurers" decoding="async">
      <div class="artifactStamp" aria-hidden="true"><span>EL</span><small>WORLD<br>083</small></div>
      <div class="artifactTelemetry" aria-hidden="true"><span>MAPLE WORLD / ONLINE</span><span>LOCAL ASSET / 02</span></div>
    </div>

    <aside id="server-status" class="heroTelemetry" aria-label="EverLeaf live server status">
      <div class="telemetryHeader">
        <span>LIVE WORLD TELEMETRY</span>
        <span class="liveState"><i id="live-dot" class="liveDot <%=status.online?'online':''%>" aria-hidden="true"></i><span id="live-state-label"><%=status.online?'OPEN':'UNAVAILABLE'%></span></span>
      </div>
      <div class="telemetryReadout">
        <div><small>SERVER</small><strong id="live-status" class="<%=status.online?'online':''%>"><%=status.online?'ONLINE':'OFFLINE'%></strong></div>
        <div><small>PLAYERS</small><strong id="live-players"><%=players===null?'—':players%></strong></div>
        <div><small>CHANNELS</small><strong id="live-channels"><%=status.channels%>/<%=status.totalChannels%></strong></div>
        <div><small>CLIENT</small><strong><%=brand.version%></strong></div>
      </div>
      <div class="telemetryFooter"><span id="live-refresh">Refreshing live status…</span><a href="/help">SYSTEM HELP ↗</a></div>
    </aside>
  </div>

  <div class="wrap heroEdgeRail">
    <div><span class="terminalLabel">CORE PRINCIPLES</span><p>NO PAY-TO-WIN / NO MANDATORY HP WASHING / COMMUNITY-FIRST</p></div>
    <div class="heroEdgeLinks"><a href="/wiki">WIKI ↗</a><a href="/rankings">RANKINGS ↗</a><a href="<%=brand.discordUrl%>" target="_blank" rel="noopener noreferrer">DISCORD ↗</a></div>
  </div>
</section>

<nav class="signalStrip" aria-label="EverLeaf quick links">
  <div class="wrap signalStripGrid">
    <a href="/downloads"><span>01</span><strong>DOWNLOAD</strong><small>Launcher + client</small></a>
    <a href="<%=sessionPlayer?'/account':'/login'%>"><span>02</span><strong><%=sessionPlayer?'ACCOUNT':'LOGIN'%></strong><small>Characters + security</small></a>
    <a href="/rankings"><span>03</span><strong>RANKINGS</strong><small>Live character data</small></a>
    <a href="/wiki"><span>04</span><strong>WIKI</strong><small>Systems + knowledge</small></a>
    <a href="/news"><span>05</span><strong>JOURNAL</strong><small>Updates + events</small></a>
  </div>
</nav>

<main class="terminalHome">
  <section class="wrap dossierSection" aria-labelledby="world-dossier-title">
    <div class="sectionIndex"><span>SECTION / 01</span><span>WORLD DOSSIER</span></div>
    <div class="dossierGrid">
      <div class="dossierStatement">
        <p class="terminalLabel">WHY EVERLEAF EXISTS</p>
        <h2 id="world-dossier-title">THE GAME YOU REMEMBER.<br><span>THE ROAD AHEAD, REBUILT.</span></h2>
      </div>
      <div class="dossierCopy">
        <p>EverLeaf keeps v83 recognizable at its core and puts the work into the systems around it: progression that respects your time, transparent changes, launcher-managed updates, useful account tools, live rankings, and a growing knowledge base.</p>
        <a class="terminalInlineLink" href="/wiki">READ THE EVERLEAF HANDBOOK ↗</a>
      </div>
    </div>
    <div class="dossierMetrics">
      <article><span>01</span><strong>CLASSIC-FIRST</strong><p>v83 remains the foundation. Changes remove friction instead of replacing the game.</p></article>
      <article><span>02</span><strong>FAIR SYSTEMS</strong><p>No mandatory competitive purchases. Progression and community stay at the center.</p></article>
      <article><span>03</span><strong>MANAGED CLIENT</strong><p>The EverLeaf launcher handles supported installs, repairs, patches, and future updates.</p></article>
      <article><span>04</span><strong>LIVING PORTAL</strong><p>Rankings, Wiki, news, account tools, and support remain useful after your first download.</p></article>
    </div>
  </section>

  <section class="entrySection" aria-labelledby="entry-title">
    <div class="wrap">
      <div class="sectionIndex"><span>SECTION / 02</span><span>ENTRY SEQUENCE</span></div>
      <div class="entryHeader">
        <h2 id="entry-title">ZERO TO MAPLE WORLD<br>IN THREE MOVES.</h2>
        <p>The website, launcher, and game account are one connected path. Start here and the rest stays simple.</p>
      </div>
      <div class="entrySequence">
        <a href="<%=sessionPlayer?'/account':'/register'%>" class="entryStep"><span class="entryNo">01</span><div><small>IDENTITY</small><strong><%=sessionPlayer?'REVIEW YOUR ACCOUNT':'CREATE YOUR ACCOUNT'%></strong><p><%=sessionPlayer?'Check your characters, security, and linked services.':'Create one EverLeaf account for the website and game client.'%></p></div><b>→</b></a>
        <a href="/downloads" class="entryStep"><span class="entryNo">02</span><div><small>CLIENT</small><strong>INSTALL THE LAUNCHER</strong><p>Use the supported launcher to install, verify, repair, and update EverLeaf.</p></div><b>→</b></a>
        <a href="/help" class="entryStep"><span class="entryNo">03</span><div><small>WORLD</small><strong>ENTER MAPLE WORLD</strong><p>Launch the client, choose a channel, and use Player Help when Windows needs attention.</p></div><b>→</b></a>
      </div>
    </div>
  </section>

  <section class="wrap classSection" aria-labelledby="class-title">
    <div class="sectionIndex"><span>SECTION / 03</span><span>ADVENTURER MATRIX</span></div>
    <div class="classHeader">
      <div><p class="terminalLabel">FIVE CLASSIC FAMILIES + BEGINNER</p><h2 id="class-title">CHOOSE YOUR SIGNAL.</h2></div>
      <p>Meet the familiar instructors behind EverLeaf's Adventurer paths. Each family keeps its classic identity while the wider server systems are tuned for long-term play.</p>
    </div>
    <div class="classMatrix">
      <article class="classNode"><div class="classNodeArt"><img src="/assets/jobs/beginner/beginner-clean.png" alt="Beginner adventurer" loading="lazy"></div><div class="classNodeMeta"><span>00 / START</span><strong>BEGINNER</strong><small>EXPLORER / MAPLE ISLAND</small></div></article>
      <article class="classNode"><div class="classNodeArt"><img src="/assets/jobs/instructors/warrior.png" alt="Warrior instructor" loading="lazy"></div><div class="classNodeMeta"><span>01 / STR</span><strong>WARRIOR</strong><small>PERION / FRONTLINE</small></div></article>
      <article class="classNode"><div class="classNodeArt"><img src="/assets/jobs/instructors/magician.png" alt="Magician instructor" loading="lazy"></div><div class="classNodeMeta"><span>02 / INT</span><strong>MAGICIAN</strong><small>ELLINIA / SPELLCASTER</small></div></article>
      <article class="classNode"><div class="classNodeArt"><img src="/assets/jobs/instructors/bowman.png" alt="Bowman instructor" loading="lazy"></div><div class="classNodeMeta"><span>03 / DEX</span><strong>BOWMAN</strong><small>HENESYS / RANGED</small></div></article>
      <article class="classNode"><div class="classNodeArt"><img src="/assets/jobs/instructors/thief.png" alt="Thief instructor" loading="lazy"></div><div class="classNodeMeta"><span>04 / LUK</span><strong>THIEF</strong><small>KERNING / MOBILITY</small></div></article>
      <article class="classNode"><div class="classNodeArt"><img src="/assets/jobs/instructors/pirate.png" alt="Pirate instructor" loading="lazy"></div><div class="classNodeMeta"><span>05 / STR+DEX</span><strong>PIRATE</strong><small>NAUTILUS / HYBRID</small></div></article>
    </div>
    <div class="specialClassRail">
      <div><span>EXPANDED PATHS</span><strong>CYGNUS KNIGHTS / ARAN / EVAN</strong></div>
      <a href="/wiki">EXPLORE CLASSES ↗</a>
    </div>
  </section>

  <section class="dataSection" aria-labelledby="data-title">
    <div class="wrap">
      <div class="sectionIndex"><span>SECTION / 04</span><span>LIVE WORLD DATA</span></div>
      <div class="dataHeader"><h2 id="data-title">THE WORLD IS NOT STATIC.</h2><p>Live character data and first-party updates sit beside the game instead of behind it.</p></div>
      <div class="dataSplit">
        <section class="journalFeed" aria-labelledby="journal-title">
          <div class="moduleHeader"><span id="journal-title">WORLD JOURNAL</span><a href="/news">ALL ENTRIES ↗</a></div>
          <% if(posts&&posts.length){ posts.slice(0,3).forEach((p,i)=>{ %>
            <a class="journalRow" href="/news/<%=p.slug%>"><span class="journalNo">0<%=i+1%></span><div><small><%=String(p.type||'news').toUpperCase()%> / <%=String(p.created_at).slice(0,10)%></small><strong><%=p.title%></strong><p><%=p.excerpt%></p></div><b>↗</b></a>
          <% }) } else { %>
            <div class="emptySignal"><span>NO ENTRIES YET</span><p>The World Journal is ready for the next EverLeaf update.</p></div>
          <% } %>
        </section>
        <section class="rankingFeed" aria-labelledby="ranking-title">
          <div class="moduleHeader"><span id="ranking-title">TOP ADVENTURERS</span><a href="/rankings">FULL RANKINGS ↗</a></div>
          <% if(topCharacters&&topCharacters.length){ topCharacters.forEach((character,i)=>{ %>
            <a class="rankingRow" href="/rankings"><span class="rankNo"><%=String(i+1).padStart(2,'0')%></span><div><strong><%=character.name%></strong><small><%=character.jobName||'Adventurer'%></small></div><b>LV. <%=character.level%></b></a>
          <% }) } else { %>
            <div class="emptySignal"><span>RANKING SIGNAL PENDING</span><p>Live character rankings will populate when game data is available.</p></div>
          <% } %>
        </section>
      </div>
    </div>
  </section>

  <section class="wrap wikiSignalSection" aria-labelledby="wiki-signal-title">
    <div class="sectionIndex"><span>SECTION / 05</span><span>KNOWLEDGE SIGNAL</span></div>
    <div class="wikiSignalHeader"><div><p class="terminalLabel">EVERLEAF HANDBOOK</p><h2 id="wiki-signal-title">KNOW THE WORLD<br>BEFORE IT KNOWS YOU.</h2></div><a class="btn ghost" href="/wiki">OPEN WIKI</a></div>
    <div class="wikiSignalRows">
      <% (featuredWiki||[]).forEach((entry,i)=>{ %>
        <a href="/wiki/<%=entry.slug%>" class="wikiSignalRow" data-source="<%=entry.sourceDoc||''%>"><span><%=String(i+1).padStart(2,'0')%></span><div><small><%=entry.status||'REFERENCE'%></small><strong><%=entry.title%></strong><p><%=entry.summary%></p></div><b>↗</b></a>
      <% }) %>
    </div>
  </section>

  <section class="finalTransmission">
    <div class="wrap finalTransmissionGrid">
      <div><span class="terminalLabel">TRANSMISSION / READY</span><h2>ENTER<br>EVERLEAF.</h2></div>
      <div class="finalTransmissionCopy"><p>Your account, launcher, rankings, Wiki, community, and support are already connected around the same world. The next move is yours.</p><div><a class="btn primary" href="<%=sessionPlayer?'/downloads':'/register'%>"><%=sessionPlayer?'DOWNLOAD & PLAY':'START YOUR JOURNEY'%></a><a class="btn ghost" href="<%=brand.discordUrl%>" target="_blank" rel="noopener noreferrer">JOIN DISCORD ↗</a></div></div>
    </div>
  </section>
</main>

<%- include("partials/footer",{player:sessionPlayer}) %>
