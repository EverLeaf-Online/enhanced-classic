<%- include("partials/header",{title:"Account Recovery"}) %>
<main class="authWrap"><div class="authGrid" style="grid-template-columns:1fr;max-width:620px">
<div class="authCard"><h2>Account Recovery</h2><p class="muted">Submit the username or email connected to your EverLeaf account. Staff will review the request and verify ownership before any account change is made.</p>
<% if(error){ %><div class="error"><%=error%></div><% } %>
<% if(submitted){ %><div class="notice">If the information matches an EverLeaf account, a recovery request is now in the staff queue. For faster identity verification, contact staff through Discord and mention that you submitted a website recovery request.</div><a class="btn primary" href="<%=brand.discordUrl%>" target="_blank" rel="noopener noreferrer">CONTACT STAFF ON DISCORD</a><a class="btn" href="/login" style="margin-left:8px">BACK TO LOGIN</a><% } else { %>
<form method="post" action="/recover"><label>Username (if known)</label><input name="username" minlength="3" maxlength="20" autocomplete="username"><label>Account Email (if known)</label><input type="email" name="email" maxlength="254" autocomplete="email"><p class="muted">You only need to provide one. Do not enter your password here.</p><button class="btn primary">SUBMIT RECOVERY REQUEST</button></form>
<% } %>
</div></div></main><%- include("partials/footer") %>
