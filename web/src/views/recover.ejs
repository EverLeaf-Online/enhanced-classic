<%- include("partials/header",{title:"Account Recovery"}) %>
<main class="authWrap"><div class="authGrid" style="grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);max-width:960px"><section class="authIntro"><img src="/assets/everleaf-remaster.svg" alt="EverLeaf Enhanced Classic"><div class="pageEyebrow">Account Help</div><h1>Find your way back.</h1><p>Submit one piece of identifying account information. EverLeaf staff reviews recovery requests privately before any account change is made.</p></section><div class="authCard"><div class="pageEyebrow">Recovery Desk</div><h2>Account Recovery</h2><p class="muted">Provide your username or the email connected to your EverLeaf account. You only need one.</p><% if(error){ %><div class="error"><%=error%></div><% } %><% if(submitted){ %><div class="notice">Your request has been added to the staff recovery queue if the information matches an account.</div><p class="muted">For faster verification, contact staff through Discord and mention that you submitted a website recovery request.</p><div style="display:flex;gap:9px;flex-wrap:wrap"><a class="btn primary" href="<%=brand.discordUrl%>" target="_blank" rel="noopener noreferrer">CONTACT STAFF</a><a class="btn" href="/login">BACK TO LOGIN</a></div><% } else { %><form method="post" action="/recover"><label>Username (if known)</label><input name="username" minlength="3" maxlength="20" autocomplete="username"><label>Account Email (if known)</label><input type="email" name="email" maxlength="254" autocomplete="email"><p class="muted">Never enter your password into a recovery request.</p><button class="btn primary">SUBMIT RECOVERY REQUEST</button></form><% } %></div></div></main><%- include("partials/footer") %>
