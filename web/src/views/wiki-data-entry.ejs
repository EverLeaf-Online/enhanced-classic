<%- include("partials/header",{title:`${entry.name} - Wiki`,description:entry.description||`${meta.singular} ${entry.id} in the EverLeaf server-data Wiki.`}) %>
<%
const fmt=n=>Number(n||0).toLocaleString();
const text=v=>v==null?'—':String(v);
const labels={
  reqLevel:'Required level',reqJob:'Required job',reqSTR:'Required STR',reqDEX:'Required DEX',reqINT:'Required INT',reqLUK:'Required LUK',
  incSTR:'STR',incDEX:'DEX',incINT:'INT',incLUK:'LUK',incMHP:'Max HP',incMMP:'Max MP',incPAD:'Weapon attack',incMAD:'Magic attack',
  incPDD:'Weapon defense',incMDD:'Magic defense',incACC:'Accuracy',incEVA:'Avoidability',incSpeed:'Speed',incJump:'Jump',tuc:'Upgrade slots',
  level:'Level',maxHP:'Max HP',maxMP:'Max MP',exp:'EXP',PADamage:'Weapon attack',MADamage:'Magic attack',PDDamage:'Weapon defense',MDDamage:'Magic defense',
  acc:'Accuracy',eva:'Avoidability',speed:'Speed',boss:'Boss',undead:'Undead',elemAttr:'Element attributes',price:'Price',cash:'Cash item',tradeBlock:'Untradeable',notSale:'Cannot sell'
};
const importantKeys=new Set(Object.keys(labels));
const entriesOf=obj=>Object.entries(obj||{}).filter(([k,v])=>v!==''&&v!=null&&importantKeys.has(k));
const rawEntries=obj=>Object.entries(obj||{}).filter(([k,v])=>v!==''&&v!=null&&!importantKeys.has(k)).slice(0,32);
const entityHref=e=>e&&e.type?`/wiki/${e.type}/${e.id}`:'#';
const statValue=(key,value)=>['boss','undead','cash','tradeBlock','notSale'].includes(key)?(Number(value)?'Yes':'No'):text(value);
const quantity=(row)=>Number(row.minimum_quantity)===Number(row.maximum_quantity)?fmt(row.minimum_quantity):`${fmt(row.minimum_quantity)}–${fmt(row.maximum_quantity)}`;
const chanceValue=row=>row.chance==null?'—':fmt(row.chance);
const mapleAsset=(type,id)=>Number(id||0)>0?`/wiki/art/${encodeURIComponent(type)}/${Number(id)}`:'';
const typeFallback={items:'IT',monsters:'MB',maps:'MP',skills:'SK',npcs:'NP',quests:'QU'};
const entryAsset=mapleAsset(entry.type,entry.id);
const renderSummary=(summary,title)=>{ if(!summary)return; %>
<section class="wikiRawSection"><h2><%=title%></h2><% if(Object.keys(summary.values||{}).length){ %><div class="wikiRawGrid"><% Object.entries(summary.values||{}).forEach(([key,value])=>{ %><div><small><%=key%></small><strong><%=text(value)%></strong></div><% }) %></div><% } %><% (summary.groups||[]).slice(0,24).forEach(group=>{ %><details class="wikiRawGroup"><summary><%=group.name||'Data group'%></summary><div class="wikiRawGrid"><% Object.entries(group.values||{}).forEach(([key,value])=>{ %><div><small><%=key%></small><strong><%=text(value)%></strong></div><% }) %></div><% (group.groups||[]).slice(0,12).forEach(child=>{ %><div class="wikiRawNested"><b><%=child.name%></b><% Object.entries(child.values||{}).forEach(([key,value])=>{ %><span><small><%=key%></small> <%=text(value)%></span><% }) %></div><% }) %></details><% }) %></section><% };
%>
<main class="lightPage wikiDataPage wikiEntityPage wikiAppPage">
<div class="wrap wikiBreadcrumb"><a href="/wiki">Wiki</a><span>›</span><a href="/wiki/<%=entry.type%>"><%=meta.label%></a><span>›</span><strong><%=entry.name%></strong></div>
<section class="wrap wikiEntityHero"><div class="wikiEntityIdentity"><span class="wikiEntityGlyph wikiMapleAsset" data-fallback="<%=typeFallback[entry.type]||'EL'%>"><% if(entryAsset){ %><img src="<%=entryAsset%>" alt="<%=entry.name%>" decoding="async" data-wiki-art><% } %></span><div class="wikiEntityCopy"><div class="pageEyebrow"><%=meta.singular.toUpperCase()%> · ID <%=entry.id%></div><h1><%=entry.name%></h1><p><%=entry.description||`This ${meta.singular.toLowerCase()} is indexed directly from EverLeaf's live game data.`%></p><div class="wikiEntityBadges"><span>EverLeaf v83</span><span>Server data</span><% if(entry.subtype){ %><span><%=entry.subtype%></span><% } %></div></div></div><aside><small>DATA SOURCE</small><strong>EverLeaf Live Server</strong><span>WZ game files + MySQL relationships</span><a href="/wiki/<%=entry.type%>">Browse all <%=meta.label.toLowerCase()%> →</a></aside></section>

<div class="wrap wikiEntityLayout"><article class="wikiEntityContent">
<% const stats=entry.sections.stats||entry.sections.raw||{}; const statRows=entriesOf(stats); if(statRows.length){ %><section class="wikiEntitySection"><div class="wikiEntitySectionHead"><div><div class="pageEyebrow">SERVER STATS</div><h2><%=meta.singular%> data</h2></div><span>From WZ</span></div><div class="wikiStatGrid"><% statRows.forEach(([key,value])=>{ %><div><small><%=labels[key]||key%></small><strong><%=statValue(key,value)%></strong></div><% }) %></div><% const extras=rawEntries(stats); if(extras.length){ %><details class="wikiTechnicalData"><summary>Show additional WZ fields</summary><div class="wikiRawGrid"><% extras.forEach(([key,value])=>{ %><div><small><%=key%></small><strong><%=text(value)%></strong></div><% }) %></div></details><% } %></section><% } %>

<% if(entry.type==='items'){ const sources=entry.sections.sources||{drops:[],shops:[]}; %>
<section class="wikiEntitySection"><div class="wikiEntitySectionHead"><div><div class="pageEyebrow">HOW TO OBTAIN</div><h2>Drop sources</h2></div><span><%=sources.drops.length%> source<%=sources.drops.length===1?'':'s'%></span></div><% if(sources.drops.length){ %><div class="wikiRelationTable"><div class="wikiRelationHeader"><span>Monster</span><span>Quantity</span><span>Server chance</span></div><% sources.drops.forEach(row=>{ %><a href="<%=entityHref(row.monster)%>"><span><strong><%=row.monster.name%></strong><small>ID <%=row.dropperid%><%=Number(row.questid)>0?` · Quest ${row.questid}`:''%></small></span><span><%=quantity(row)%></span><span><%=chanceValue(row)%></span></a><% }) %></div><% }else{ %><p class="wikiNone">No direct monster drop is recorded in the live <code>drop_data</code> table.</p><% } %></section>
<section class="wikiEntitySection"><div class="wikiEntitySectionHead"><div><div class="pageEyebrow">SHOPS</div><h2>Sold by NPCs</h2></div><span><%=sources.shops.length%> shop<%=sources.shops.length===1?'':'s'%></span></div><% if(sources.shops.length){ %><div class="wikiRelationCards"><% sources.shops.forEach(row=>{ %><a href="<%=entityHref(row.npc)%>"><strong><%=row.npc.name%></strong><small>NPC <%=row.npcid%></small><span><%=Number(row.price)>0?`${fmt(row.price)} mesos`:`Pitch ${fmt(row.pitch)}`%></span></a><% }) %></div><% }else{ %><p class="wikiNone">This item is not listed as a directly purchasable shop item.</p><% } %></section><% } %>

<% if(entry.type==='monsters'){ const drops=entry.sections.drops||[]; const maps=entry.sections.maps||[]; %>
<section class="wikiEntitySection"><div class="wikiEntitySectionHead"><div><div class="pageEyebrow">DROP TABLE</div><h2>Expected drops</h2></div><span><%=drops.length%> record<%=drops.length===1?'':'s'%></span></div><% if(drops.length){ %><div class="wikiRelationTable"><div class="wikiRelationHeader"><span>Item</span><span>Quantity</span><span>Server chance</span></div><% drops.forEach(row=>{ %><a href="<%=entityHref(row.item)%>"><span><strong><%=row.item.name%></strong><small>ID <%=row.itemid%><%=Number(row.questid)>0?` · Quest ${row.questid}`:''%></small></span><span><%=quantity(row)%></span><span><%=chanceValue(row)%></span></a><% }) %></div><% }else{ %><p class="wikiNone">No item drops are recorded for this monster.</p><% } %></section>
<section class="wikiEntitySection"><div class="wikiEntitySectionHead"><div><div class="pageEyebrow">WORLD LOCATIONS</div><h2>Found on maps</h2></div><span><%=maps.length%> map<%=maps.length===1?'':'s'%></span></div><div class="wikiRelationCards"><% maps.forEach(map=>{ %><a href="<%=entityHref(map)%>"><strong><%=map.name%></strong><small>Map <%=map.id%></small><span><%=map.description||map.subtype||'EverLeaf world'%></span></a><% }) %></div><% if(!maps.length){ %><p class="wikiNone">No regular map spawn was found in the current Map.wz data.</p><% } %></section><% } %>

<% if(entry.type==='maps'){ const mobs=entry.sections.mobs||[]; const npcs=entry.sections.npcs||[]; const portals=entry.sections.portals||[]; %>
<section class="wikiEntitySection"><div class="wikiEntitySectionHead"><div><div class="pageEyebrow">MONSTERS</div><h2>Monster spawns</h2></div><span><%=mobs.length%></span></div><div class="wikiRelationCards"><% mobs.forEach(row=>{ %><a href="<%=entityHref(row.entity)%>"><strong><%=row.entity.name%></strong><small>Mob <%=row.id%></small><span>x <%=row.x%> · y <%=row.y%></span></a><% }) %></div><% if(!mobs.length){ %><p class="wikiNone">No regular monster spawns are listed on this map.</p><% } %></section>
<section class="wikiEntitySection"><div class="wikiEntitySectionHead"><div><div class="pageEyebrow">NPCs</div><h2>NPCs on this map</h2></div><span><%=npcs.length%></span></div><div class="wikiRelationCards"><% npcs.forEach(row=>{ %><a href="<%=entityHref(row.entity)%>"><strong><%=row.entity.name%></strong><small>NPC <%=row.id%></small><span>x <%=row.x%> · y <%=row.y%></span></a><% }) %></div><% if(!npcs.length){ %><p class="wikiNone">No NPCs are listed on this map.</p><% } %></section>
<section class="wikiEntitySection"><div class="wikiEntitySectionHead"><div><div class="pageEyebrow">PORTALS</div><h2>Connected maps</h2></div><span><%=portals.length%></span></div><% if(portals.length){ %><div class="wikiPortalList"><% portals.forEach(portal=>{ %><div><span><strong><%=portal.name||'Portal'%></strong><small><%=portal.targetName||'target'%></small></span><% if(portal.target&&portal.targetMap>=0){ %><a href="<%=entityHref(portal.target)%>"><%=portal.target.name%> <small>(<%=portal.targetMap%>)</small></a><% }else{ %><span>Scripted / local portal</span><% } %></div><% }) %></div><% }else{ %><p class="wikiNone">No portal entries were parsed for this map.</p><% } %></section><% } %>

<% if(entry.type==='npcs'){ const maps=entry.sections.maps||[]; const shop=entry.sections.shop||[]; %>
<section class="wikiEntitySection"><div class="wikiEntitySectionHead"><div><div class="pageEyebrow">LOCATIONS</div><h2>Where to find this NPC</h2></div><span><%=maps.length%></span></div><div class="wikiRelationCards"><% maps.forEach(map=>{ %><a href="<%=entityHref(map)%>"><strong><%=map.name%></strong><small>Map <%=map.id%></small><span><%=map.description||map.subtype||'EverLeaf world'%></span></a><% }) %></div><% if(!maps.length){ %><p class="wikiNone">No normal Map.wz placement was found. This NPC may be scripted or event-only.</p><% } %></section>
<section class="wikiEntitySection"><div class="wikiEntitySectionHead"><div><div class="pageEyebrow">SHOP INVENTORY</div><h2>Items sold</h2></div><span><%=shop.length%></span></div><% if(shop.length){ %><div class="wikiRelationTable"><div class="wikiRelationHeader"><span>Item</span><span>Price</span><span>ID</span></div><% shop.forEach(row=>{ %><a href="<%=entityHref(row.item)%>"><span><strong><%=row.item.name%></strong><small><%=row.item.subtype||'Item'%></small></span><span><%=Number(row.price)>0?`${fmt(row.price)} mesos`:`Pitch ${fmt(row.pitch)}`%></span><span><%=row.itemid%></span></a><% }) %></div><% }else{ %><p class="wikiNone">This NPC has no data-driven shop inventory.</p><% } %></section><% } %>

<% if(entry.type==='skills'){ const common=entry.sections.common||{}; const levels=entry.sections.levels||[]; %>
<% if(Object.keys(common).length){ %><section class="wikiEntitySection"><div class="wikiEntitySectionHead"><div><div class="pageEyebrow">COMMON DATA</div><h2>Skill formula fields</h2></div><span>Skill.wz</span></div><div class="wikiRawGrid"><% Object.entries(common).forEach(([key,value])=>{ %><div><small><%=key%></small><strong><%=text(value)%></strong></div><% }) %></div></section><% } %>
<section class="wikiEntitySection"><div class="wikiEntitySectionHead"><div><div class="pageEyebrow">SKILL LEVELS</div><h2>Per-level data</h2></div><span><%=levels.length%> level<%=levels.length===1?'':'s'%></span></div><% if(levels.length){ %><div class="wikiSkillLevels"><% levels.forEach(row=>{ %><details><summary>Level <%=row.level%></summary><div class="wikiRawGrid"><% Object.entries(row.values||{}).forEach(([key,value])=>{ %><div><small><%=key%></small><strong><%=text(value)%></strong></div><% }) %></div></details><% }) %></div><% }else{ %><p class="wikiNone">This skill does not expose a classic per-level block in the current Skill.wz file.</p><% } %></section><% } %>

<% if(entry.type==='quests'){ renderSummary(entry.sections.info,'Quest information'); renderSummary(entry.sections.check,'Requirements and prerequisites'); renderSummary(entry.sections.act,'Rewards and completion actions'); } %>
</article>
<aside class="wikiEntitySidebar"><div class="wikiEntitySideBox"><span class="pageEyebrow">LOOKUP</span><strong><%=entry.name%></strong><dl><div><dt>Type</dt><dd><%=meta.singular%></dd></div><div><dt>ID</dt><dd><code><%=entry.id%></code></dd></div><% if(entry.subtype){ %><div><dt>Category</dt><dd><%=entry.subtype%></dd></div><% } %></dl></div><form class="wikiSideSearch" action="/wiki" method="get"><strong>Search the Wiki</strong><input type="search" name="q" placeholder="Name or ID…"><button class="btn primary" type="submit">SEARCH</button></form><div class="wikiEntitySideBox"><span class="pageEyebrow">DATA AUTHORITY</span><p>Static names and stats come from EverLeaf's current WZ tree. Drops and shop relationships are queried from the server database. MapleStory.io supplies display artwork through EverLeaf's image proxy.</p><a href="/wiki/guides">Staff-written guides →</a></div></aside></div>
</main><%- include("partials/footer") %>