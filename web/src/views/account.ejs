<%- include("partials/header",{title:"Account",player:account}) %>
<main class="lightPage"><div class="lightTitle"><div class="wrap"><h1>Welcome, <%=account.name%></h1><p>Your EverLeaf account portal.</p></div></div><div class="wrap"><% if(error){%><div class="error"><%=error%></div><%}%><% if(success){%><div class="notice"><%=success%></div><%}%>
<div style="display:grid;grid-template-columns:minmax(0,1.3fr) minmax(300px,.7fr);gap:18px;align-items:start">
<div><div class="paperCard"><h2>Your Characters</h2><% if(characters.length){ %><table><thead><tr><th>Character</th><th>Job</th><th>Level</th><th>Fame</th></tr></thead><tbody><% characters.forEach(c=>{ %><tr><td><strong><%=c.name%></strong></td><td><%=c.jobName%></td><td><strong><%=c.level%></strong></td><td><%=c.fame%></td></tr><% }) %></tbody></table><% } else { %><p class="muted">No characters found on this account yet.</p><a class="btn primary" href="/downloads">Download EverLeaf</a><% } %></div></div>
<div><div class="paperCard"><h2>Security</h2><p class="muted">Changing your password here changes the password used by both the website and game client.</p><form method="post" action="/account/password"><label>Current Password</label><input type="password" name="currentPassword" autocomplete="current-password" required><label>New Password</label><input type="password" name="newPassword" minlength="8" maxlength="64" autocomplete="new-password" required><label>Confirm New Password</label><input type="password" name="confirmPassword" minlength="8" maxlength="64" autocomplete="new-password" required><button class="btn primary">CHANGE PASSWORD</button></form><hr style="border:0;border-top:1px solid #e1ddd2;margin:18px 0"><form method="post" action="/logout"><button class="btn" style="background:#26352b">LOG OUT</button></form></div></div>
</div></div></main><%- include("partials/footer") %>
