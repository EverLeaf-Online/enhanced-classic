<%- include("partials/header",{title:"Account",player:account}) %>
<% const jobIcon=(name='')=>{const n=String(name).toLowerCase();if(/aran/.test(n))return'/assets/jobs/aran.svg';if(/evan/.test(n))return'/assets/jobs/evan.svg';if(/dawn warrior|blaze wizard|wind archer|night walker|thunder breaker|cygnus/.test(n))return'/assets/jobs/cygnus.svg';if(/warrior|fighter|crusader|hero|page|white knight|paladin|spearman|dragon knight|dark knight/.test(n))return'/assets/jobs/warrior.svg';if(/magician|wizard|mage|cleric|priest|bishop/.test(n))return'/assets/jobs/magician.svg';if(/bowman|archer|hunter|ranger|bowmaster|crossbow|sniper|marksman/.test(n))return'/assets/jobs/bowman.svg';if(/thief|rogue|assassin|hermit|night lord|bandit|chief bandit|shadower/.test(n))return'/assets/jobs/thief.svg';if(/pirate|brawler|marauder|buccaneer|gunslinger|outlaw|corsair/.test(n))return'/assets/jobs/pirate.svg';return'/assets/everleaf-remaster.svg'}; %>
<main class="lightPage"><section class="lightTitle accountTitle"><div class="wrap pageHeroGrid"><div><div class="pageEyebrow">Adventurer Portal</div><h1><%=account.name%>'s Account</h1><p>Your characters, vote rewards, community connection, and account security in one place.</p></div><div class="pageHeroAside"><strong>One EverLeaf account</strong><span>Your website credentials and game credentials are the same account. Password changes here affect the game client too.</span></div></div></section><div class="wrap accountPage"><% if(error){%><div class="error" style="margin-top:24px"><%=error%></div><%}%><% if(success){%><div class="notice" style="margin-top:24px"><%=success%></div><%}%>
<% const voteRewards=(typeof rewards!=="undefined"&&rewards)?rewards:{nxCredit:0,pendingVoteNx:0}; const linkedDiscord=typeof discordProfile!=="undefined"&&discordProfile&&discordProfile.discord_user_id; const canLinkDiscord=typeof discordReady!=="undefined"&&discordReady; %>
<div class="accountQuick"><a class="btn primary" href="/downloads">PLAY / DOWNLOAD</a><a class="btn" href="/vote" target="_blank" rel="noopener">VOTE FOR NX</a><a class="btn" href="/help">SUPPORT</a><% if(brand.discordUrl){%><a class="btn" href="<%=brand.discordUrl%>" target="_blank" rel="noopener">DISCORD</a><%}%></div>
<div class="stats accountStats"><div class="stat"><div class="statNum"><%=characters.length%></div><div>Characters</div></div><div class="stat"><div class="statNum"><%=voteRewards.nxCredit.toLocaleString()%></div><div>NX Credit</div></div><div class="stat"><div class="statNum"><%=voteRewards.pendingVoteNx.toLocaleString()%></div><div>Pending Vote NX</div></div><div class="stat"><div class="statNum"><%=linkedDiscord?'Linked':'—'%></div><div>Discord</div></div></div>
<div class="accountShell"><div class="contentStack"><section class="featurePanel characterRoster"><div class="rosterHead"><div><div class="pageEyebrow">Character Roster</div><h2>Your Adventurers</h2></div><a class="btn small" href="/rankings">HALL OF LEGENDS</a></div><% if(characters.length){ %><div class="characterCards"><% characters.forEach(c=>{ %><article class="characterCard"><img src="<%=jobIcon(c.jobName)%>" alt="" class="characterJobIcon"><div class="characterCardMain"><strong><%=c.name%></strong><span><%=c.jobName%></span></div><div class="characterLevel">Lv. <%=c.level%></div><div class="characterFame">Fame <strong><%=c.fame%></strong></div></article><% }) %></div><% } else { %><div class="emptyAdventure"><img src="/assets/jobs/warrior.svg" alt=""><div><h3>No adventurers yet</h3><p class="muted">Create your first character in Maple World and it will appear here.</p><a class="btn primary" href="/downloads">GET EVERLEAF</a></div></div><% } %></section></div>
<aside class="accountSidebar"><section class="paperCard rewardCard"><div class="pageEyebrow">Reward Ledger</div><h2>NX Rewards</h2><p>NX Credit <strong style="float:right"><%=voteRewards.nxCredit.toLocaleString()%></strong></p><p>Pending Vote NX <strong style="float:right"><%=voteRewards.pendingVoteNx.toLocaleString()%></strong></p><p class="muted">A verified GTop100 vote queues <%=Number(brand&&brand.voteRewardNx||1500).toLocaleString()%> account-wide NX. One verified reward per account per UTC day.</p><a class="btn primary" href="/vote" target="_blank" rel="noopener">VOTE FOR EVERLEAF</a></section>
<section class="paperCard"><div class="pageEyebrow">Community Link</div><h2>Discord</h2><% if(linkedDiscord){%><p>Your Discord account is linked.</p><p class="muted">Supporter role status: <strong><%=discordProfile.discord_role_status%></strong></p><%}else if(canLinkDiscord){%><p class="muted">Link Discord securely to receive eligible community/supporter recognition.</p><a class="btn primary" href="/account/discord/connect">LINK DISCORD</a><%}else{%><p class="muted">Discord account linking is being configured.</p><%}%></section>
<section class="paperCard securityCard"><div class="pageEyebrow">Account Security</div><h2>Change Password</h2><p class="muted">The password changed here is also used by the v83 game client.</p><form method="post" action="/account/password"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>"><label>Current Password</label><input type="password" name="currentPassword" autocomplete="current-password" required><label>New Password</label><input type="password" name="newPassword" minlength="8" maxlength="12" autocomplete="new-password" aria-describedby="change-password-help" required><p id="change-password-help" class="muted">Use 8-12 characters for v83 compatibility.</p><label>Confirm New Password</label><input type="password" name="confirmPassword" minlength="8" maxlength="12" autocomplete="new-password" required><button class="btn primary">CHANGE PASSWORD</button></form><form method="post" action="/logout" style="margin-top:12px"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>"><button class="btn">LOG OUT</button></form></section></aside></div></div></main><%- include("partials/footer") %>
