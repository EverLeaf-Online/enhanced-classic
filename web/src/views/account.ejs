<%- include("partials/header",{title:"Account",player:account}) %>
<%
const jobIcon=(name='')=>{const n=String(name).toLowerCase();if(/aran/.test(n))return'/assets/jobs/aran.svg';if(/evan/.test(n))return'/assets/jobs/evan.svg';if(/dawn warrior|blaze wizard|wind archer|night walker|thunder breaker|cygnus/.test(n))return'/assets/jobs/cygnus.svg';if(/warrior|fighter|crusader|hero|page|white knight|paladin|spearman|dragon knight|dark knight/.test(n))return'/assets/jobs/warrior.svg';if(/magician|wizard|mage|cleric|priest|bishop/.test(n))return'/assets/jobs/magician.svg';if(/bowman|archer|hunter|ranger|bowmaster|crossbow|sniper|marksman/.test(n))return'/assets/jobs/bowman.svg';if(/thief|rogue|assassin|hermit|night lord|bandit|chief bandit|shadower/.test(n))return'/assets/jobs/thief.svg';if(/pirate|brawler|marauder|buccaneer|gunslinger|outlaw|corsair/.test(n))return'/assets/jobs/pirate.svg';return'/assets/everleaf-remaster.svg'};
const voteRewards=(typeof rewards!=="undefined"&&rewards)?rewards:{nxCredit:0,pendingVoteNx:0};
const linkedDiscord=typeof discordProfile!=="undefined"&&discordProfile&&discordProfile.discord_user_id;
const canLinkDiscord=typeof discordReady!=="undefined"&&discordReady;
%>
<main class="terminalAccountPage accountPage">
  <header class="terminalAccountHeader">
    <div><div class="pageEyebrow">ACCOUNT://PLAYER CONTROL</div><h1><%=account.name%><br>SESSION.</h1><p class="muted">Website credentials and game credentials are the same EverLeaf account. Character state, NX rewards, Discord linking, and password security live here.</p></div>
    <div class="terminalAccountTelemetry">
      <div><small>CHARACTERS</small><strong><%=characters.length%></strong></div>
      <div><small>NX CREDIT</small><strong><%=voteRewards.nxCredit.toLocaleString()%></strong></div>
      <div><small>PENDING NX</small><strong><%=voteRewards.pendingVoteNx.toLocaleString()%></strong></div>
      <div><small>DISCORD</small><strong><%=linkedDiscord?'LINKED':'—'%></strong></div>
    </div>
  </header>

  <% if(error){ %><div class="error" style="margin-top:16px"><%=error%></div><% } %>
  <% if(success){ %><div class="notice" style="margin-top:16px"><%=success%></div><% } %>

  <nav class="terminalAccountActions" aria-label="Account quick actions"><a class="btn primary" href="/downloads">PLAY / DOWNLOAD</a><a class="btn" href="/vote" target="_blank" rel="noopener">VOTE FOR NX</a><a class="btn" href="/help">SUPPORT</a><% if(brand.discordUrl){ %><a class="btn" href="<%=brand.discordUrl%>" target="_blank" rel="noopener">DISCORD</a><% } %></nav>

  <div class="terminalAccountGrid accountShell">
    <section class="terminalRoster characterRoster">
      <div class="pageEyebrow">ROSTER://CHARACTERS</div><h2>YOUR ADVENTURERS.</h2>
      <% if(characters.length){ %>
        <div class="terminalCharacterRows characterCards">
          <% characters.forEach(c=>{ %><article class="terminalCharacterRow characterCard"><img src="<%=jobIcon(c.jobName)%>" alt="" class="characterJobIcon"><div><strong><%=c.name%></strong><span><%=c.jobName%></span></div><div><small>LEVEL</small><strong>LV. <%=c.level%></strong></div><div><small>FAME</small><strong><%=c.fame%></strong></div></article><% }) %>
        </div>
      <% } else { %>
        <div class="terminalAccountPane emptyAdventure"><h3>NO CHARACTERS.</h3><p>Create your first character in Maple World and it will appear here.</p><a class="btn primary" href="/downloads">GET EVERLEAF</a></div>
      <% } %>
    </section>

    <aside class="terminalAccountRail accountSidebar">
      <section class="terminalAccountPane rewardCard"><div class="pageEyebrow">REWARD://LEDGER</div><h2>NX REWARDS.</h2><p>NX Credit <strong style="float:right"><%=voteRewards.nxCredit.toLocaleString()%></strong></p><p>Pending Vote NX <strong style="float:right"><%=voteRewards.pendingVoteNx.toLocaleString()%></strong></p><p>A verified GTop100 vote queues <%=Number(brand&&brand.voteRewardNx||1500).toLocaleString()%> account-wide NX. One verified reward per account per UTC day.</p><a class="btn primary" href="/vote" target="_blank" rel="noopener">VOTE FOR EVERLEAF</a></section>

      <section class="terminalAccountPane"><div class="pageEyebrow">COMMUNITY://DISCORD</div><h2>DISCORD LINK.</h2><% if(linkedDiscord){ %><p>Your Discord account is linked.</p><p>Supporter role state: <strong><%=discordProfile.discord_role_status%></strong></p><% } else if(canLinkDiscord){ %><p>Link Discord securely to receive eligible community/supporter recognition.</p><a class="btn primary" href="/account/discord/connect">LINK DISCORD</a><% } else { %><p>Discord account linking is being configured.</p><% } %></section>

      <section class="terminalAccountPane securityCard"><div class="pageEyebrow">SECURITY://PASSWORD</div><h2>CHANGE PASSWORD.</h2><p>The password changed here is also used by the v83 game client.</p><form method="post" action="/account/password"><label>Current Password</label><input type="password" name="currentPassword" autocomplete="current-password" required><label>New Password</label><input type="password" name="newPassword" minlength="8" maxlength="12" autocomplete="new-password" aria-describedby="change-password-help" required><p id="change-password-help" class="muted">Use 8–12 characters for v83 compatibility.</p><label>Confirm New Password</label><input type="password" name="confirmPassword" minlength="8" maxlength="12" autocomplete="new-password" required><button class="btn primary">UPDATE PASSWORD</button></form><form method="post" action="/logout" style="margin-top:8px"><button class="btn">END SESSION</button></form></section>
    </aside>
  </div>
</main>
<%- include("partials/footer") %>
