<%- include("partials/header",{title:"Account",player:account}) %>
<main class="lightPage"><section class="lightTitle"><div class="wrap pageHeroGrid"><div><div class="pageEyebrow">Adventurer Portal</div><h1><%=account.name%>'s Account</h1><p>Your characters, vote rewards, community connection, and account security in one place.</p></div><div class="pageHeroAside"><strong>One EverLeaf account</strong><span>Your website credentials and game credentials are the same account. Password changes here affect the game client too.</span></div></div></section><div class="wrap"><% if(error){%><div class="error" style="margin-top:24px"><%=error%></div><%}%><% if(success){%><div class="notice" style="margin-top:24px"><%=success%></div><%}%>
<% const voteRewards=(typeof rewards!=="undefined"&&rewards)?rewards:{nxCredit:0,pendingVoteNx:0}; const linkedDiscord=typeof discordProfile!=="undefined"&&discordProfile&&discordProfile.discord_user_id; const canLinkDiscord=typeof discordReady!=="undefined"&&discordReady; %>
<div class="accountQuick"><a class="btn primary" href="/downloads">PLAY / DOWNLOAD</a><a class="btn" href="/vote" target="_blank" rel="noopener">VOTE FOR NX</a><a class="btn" href="/help">SUPPORT</a><% if(brand.discordUrl){%><a class="btn" href="<%=brand.discordUrl%>" target="_blank" rel="noopener">DISCORD</a><%}%></div>
<div class="stats accountStats"><div class="stat"><div class="statNum"><%=characters.length%></div><div>Characters</div></div><div class="stat"><div class="statNum"><%=voteRewards.nxCredit.toLocaleString()%></div><div>NX Credit</div></div><div class="stat"><div class="statNum"><%=voteRewards.pendingVoteNx.toLocaleString()%></div><div>Pending Vote NX</div></div><div class="stat"><div class="statNum"><%=linkedDiscord?'Linked':'—'%></div><div>Discord</div></div></div>
<div class="accountShell"><div class="contentStack"><section class="featurePanel"><div style="display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap"><div><div class="pageEyebrow">Character Roster</div><h2 style="margin:0">Your Adventurers</h2></div><a class="btn small" href="/rankings">HALL OF LEGENDS</a></div><% if(characters.length){ %><div class="tableWrap" style="margin-top:18px"><table><thead><tr><th>Character</th><th>Job</th><th>Level</th><th>Fame</th></tr></thead><tbody><% characters.forEach(c=>{ %><tr><td><strong><%=c.name%></strong></td><td><%=c.jobName%></td><td><strong class="rankLvCell"><%=c.level%></strong></td><td><%=c.fame%></td></tr><% }) %></tbody></table></div><% } else { %><p class="muted">No characters have entered Maple World on this account yet.</p><a class="btn primary" href="/downloads">GET EVERLEAF</a><% } %></section></div>
<aside class="accountSidebar"><section class="paperCard"><div class="pageEyebrow">Reward Ledger</div><h2>NX Rewards</h2><p>NX Credit <strong style="float:right"><%=voteRewards.nxCredit.toLocaleString()%></strong></p><p>Pending Vote NX <strong style="float:right"><%=voteRewards.pendingVoteNx.toLocaleString()%></strong></p><p class="muted">A verified GTop100 vote queues <%=Number(brand&&brand.voteRewardNx||1500).toLocaleString()%> account-wide NX. One verified reward per account per UTC day.</p><a class="btn primary" href="/vote" target="_blank" rel="noopener">VOTE FOR EVERLEAF</a></section>
<section class="paperCard"><div class="pageEyebrow">Community Link</div><h2>Discord</h2><% if(linkedDiscord){%><p>Your Discord account is linked.</p><p class="muted">Supporter role status: <strong><%=discordProfile.discord_role_status%></strong></p><%}else if(canLinkDiscord){%><p class="muted">Link Discord securely to receive eligible community/supporter recognition.</p><a class="btn primary" href="/account/discord/connect">LINK DISCORD</a><%}else{%><p class="muted">Discord account linking is being configured.</p><%}%></section>
<section class="paperCard"><div class="pageEyebrow">Account Security</div><h2>Change Password</h2><p class="muted">The password changed here is also used by the v83 game client.</p><form method="post" action="/account/password"><label>Current Password</label><input type="password" name="currentPassword" autocomplete="current-password" required><label>New Password</label><input type="password" name="newPassword" minlength="8" maxlength="12" autocomplete="new-password" aria-describedby="change-password-help" required><p id="change-password-help" class="muted">Use 8-12 characters for v83 compatibility.</p><label>Confirm New Password</label><input type="password" name="confirmPassword" minlength="8" maxlength="12" autocomplete="new-password" required><button class="btn primary">CHANGE PASSWORD</button></form><form method="post" action="/logout" style="margin-top:12px"><button class="btn">LOG OUT</button></form></section></aside></div></div></main><%- include("partials/footer") %>
