<%- include("partials/header",{title:"Account",player:account}) %>
<main class="lightPage"><div class="lightTitle"><div class="wrap"><h1>Welcome, <%=account.name%></h1><p>Your EverLeaf account portal.</p></div></div><div class="wrap"><% if(error){%><div class="error"><%=error%></div><%}%><% if(success){%><div class="notice"><%=success%></div><%}%>
<% const voteRewards=(typeof rewards!=="undefined"&&rewards)?rewards:{nxCredit:0,pendingVoteNx:0}; %>
<div style="display:grid;grid-template-columns:minmax(0,1.3fr) minmax(300px,.7fr);gap:18px;align-items:start">
<div><div class="paperCard"><h2>Your Characters</h2><% if(characters.length){ %><table><thead><tr><th>Character</th><th>Job</th><th>Level</th><th>Fame</th></tr></thead><tbody><% characters.forEach(c=>{ %><tr><td><strong><%=c.name%></strong></td><td><%=c.jobName%></td><td><strong><%=c.level%></strong></td><td><%=c.fame%></td></tr><% }) %></tbody></table><% } else { %><p class="muted">No characters found on this account yet.</p><a class="btn primary" href="/downloads">Download EverLeaf</a><% } %></div></div>
<div>
<div class="paperCard"><h2>NX Rewards</h2><p>NX Credit: <strong><%=voteRewards.nxCredit.toLocaleString()%></strong></p><p>Pending verified vote NX: <strong><%=voteRewards.pendingVoteNx.toLocaleString()%></strong></p><p class="muted">A verified GTop100 vote queues <%=Number(brand&&brand.voteRewardNx||1500).toLocaleString()%> account-wide NX. Vote rewards are limited to one verified reward per account per UTC day.</p><a class="btn primary" href="/vote" target="_blank" rel="noopener">VOTE FOR EVERLEAF</a></div>
<div class="paperCard" style="margin-top:18px"><h2>Discord</h2><% const linkedDiscord=typeof discordProfile!=="undefined"&&discordProfile&&discordProfile.discord_user_id; const canLinkDiscord=typeof discordReady!=="undefined"&&discordReady; %><% if(linkedDiscord){%><p>Your Discord account is linked.</p><p class="muted">Supporter role status: <strong><%=discordProfile.discord_role_status%></strong></p><%}else if(canLinkDiscord){%><p>Link Discord securely to receive supporter recognition after a confirmed contribution.</p><a class="btn primary" href="/account/discord/connect">LINK DISCORD</a><%}else{%><p class="muted">Discord account linking is being configured.</p><%}%></div><div class="paperCard" style="margin-top:18px"><h2>Security</h2><p class="muted">Changing your password here changes the password used by both the website and game client. If your existing password is longer than 12 characters, you can still log in here and replace it.</p><form method="post" action="/account/password"><label>Current Password</label><input type="password" name="currentPassword" autocomplete="current-password" required><label>New Password</label><input type="password" name="newPassword" minlength="8" maxlength="12" autocomplete="new-password" aria-describedby="change-password-help" required><p id="change-password-help" class="muted">Use 8-12 characters for v83 game-client compatibility.</p><label>Confirm New Password</label><input type="password" name="confirmPassword" minlength="8" maxlength="12" autocomplete="new-password" required><button class="btn primary">CHANGE PASSWORD</button></form><hr style="border:0;border-top:1px solid #e1ddd2;margin:18px 0"><form method="post" action="/logout"><button class="btn" style="background:#26352b">LOG OUT</button></form></div></div>
</div></div></main><%- include("partials/footer") %>
