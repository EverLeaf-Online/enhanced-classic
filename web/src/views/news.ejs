<%- include("partials/header",{title:"News"}) %>
<main class="lightPage"><section class="lightTitle"><div class="wrap pageHeroGrid"><div><div class="pageEyebrow">EverLeaf Journal</div><h1>News & Updates</h1><p>Patch notes, events, maintenance notices, and community updates in one place.</p></div><div class="pageHeroAside"><strong>Stay current</strong><span>Major gameplay, launcher, website, and event changes are published here first.</span></div></div></section><div class="wrap">
<% const imgs=['/assets/news-welcome.webp','/assets/news-event.webp','/assets/news-patch.webp']; %>
<div class="newsList"><% posts.forEach((p,i)=>{ %><a class="newsStory" href="/news/<%=p.slug%>"><img src="<%=imgs[i%imgs.length]%>" alt=""><div class="newsStoryBody"><div class="newsStoryMeta"><span class="kicker"><%=p.type%></span><span><%=String(p.created_at).slice(0,10)%></span></div><h3><%=p.title%></h3><p><%=p.excerpt%></p><strong>Read update →</strong></div></a><% }) %></div>
<% if(!posts.length){ %><section class="featurePanel"><div class="pageEyebrow">Coming Soon</div><h2>EverLeaf news will appear here.</h2><p class="muted">Server announcements, events, maintenance notices, and patch notes will be published as they happen.</p></section><% } %>
</div></main><%- include("partials/footer") %>
