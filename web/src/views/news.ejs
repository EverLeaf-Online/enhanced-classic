<%- include("partials/header",{title:"World Log"}) %>
<main class="terminalLogPage">
  <header class="terminalPageLead">
    <div>
      <div class="pageEyebrow">EVERLEAF // PUBLIC JOURNAL</div>
      <h1>WORLD<br>LOG.</h1>
    </div>
    <aside class="terminalPageLeadAside">
      <span>STREAM / OFFICIAL</span>
      <b><%=posts.length%> ENTRIES LOADED</b>
      <span>Patch notes · events · maintenance · development</span>
      <span>Canonical source: everleafms.online/news</span>
    </aside>
  </header>

  <section aria-label="EverLeaf news entries" class="terminalLogRows newsList">
    <% posts.forEach((p,i)=>{ %>
      <a class="terminalLogRow" href="/news/<%=p.slug%>">
        <span class="terminalLogDate"><%=String(p.created_at).slice(0,10)%></span>
        <span class="terminalLogType"><%=String(p.type||'news').toUpperCase()%></span>
        <strong class="terminalLogTitle"><%=p.title%></strong>
        <span class="terminalLogExcerpt"><%=p.excerpt%></span>
        <span aria-hidden="true">→</span>
      </a>
    <% }) %>
    <% if(!posts.length){ %>
      <div class="terminalLogRow"><span class="terminalLogDate">NO DATA</span><span class="terminalLogType">IDLE</span><strong class="terminalLogTitle">No world entries yet.</strong><span class="terminalLogExcerpt">Patch notes, events, maintenance notices, and server announcements will appear here when published.</span><span>—</span></div>
    <% } %>
  </section>
</main>
<%- include("partials/footer") %>
