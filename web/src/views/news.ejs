<%- include("partials/header",{title:"News"}) %>
<main class="lightPage"><section class="lightTitle"><div class="wrap pageHeroGrid"><div><div class="pageEyebrow">World Journal</div><h1>EverLeaf News</h1><p>Patch notes, events, maintenance notices, development updates, and community announcements from Maple World.</p></div><div class="pageHeroAside"><strong>Official updates</strong><span>Launcher, gameplay, event, and maintenance changes are published here so adventurers have one reliable source.</span></div></div></section><div class="wrap">
<% const imgs=['/assets/news-welcome.webp','/assets/news-event.webp','/assets/news-patch.webp']; %>
<div class="newsList"><% posts.forEach((p,i)=>{ %><a class="newsStory" href="/news/<%=p.slug%>"><img src="<%=imgs[i%imgs.length]%>" alt=""><div class="newsStoryBody"><div class="newsStoryMeta"><span class="kicker"><%=String(p.type||'news').toUpperCase()%></span><span><%=String(p.created_at).slice(0,10)%></span></div><h3><%=p.title%></h3><p><%=p.excerpt%></p><strong>Open journal entry →</strong></div></a><% }) %></div>
<% if(!posts.length){ %><section class="featurePanel" style="margin:36px 0 65px"><div class="pageEyebrow">Quiet Day in Maple World</div><h2>No journal entries yet.</h2><p class="muted">Patch notes, events, maintenance notices, and server announcements will appear here when published by the EverLeaf team.</p></section><% } %>
</div></main><%- include("partials/footer") %>
