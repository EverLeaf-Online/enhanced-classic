<%- include("partials/header",{title:post.title}) %>
<main class="lightPage terminalArticlePage">
  <header class="terminalPageLead"><div><div class="pageEyebrow"><%=String(post.type||'news').toUpperCase()%> // WORLD LOG ENTRY</div><h1><%=post.title%>.</h1><p class="muted"><%=post.excerpt%></p></div><aside class="terminalPageLeadAside"><span>OFFICIAL EVERLEAF UPDATE</span><b><%=String(post.created_at||'').slice(0,10)%></b><span>Published through the EverLeaf CMS.</span></aside></header>
  <article class="article terminalArticle"><div style="white-space:pre-wrap"><%=post.body%></div><div class="terminalArticleBack"><a class="btn" href="/news">← WORLD LOG</a></div></article>
</main>
<%- include("partials/footer") %>
