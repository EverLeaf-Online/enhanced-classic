<%- include("partials/header",{title:"CMS Announcements"}) %>
<main class="lightPage">
  <div class="lightTitle"><div class="wrap"><h1>Announcements</h1><p>Control the message shown across the public website.</p></div></div>
  <div class="wrap" style="max-width:1000px;display:grid;grid-template-columns:minmax(0,1.4fr) minmax(300px,.8fr);gap:18px;align-items:start">
    <div class="paperCard">
      <div style="display:flex;justify-content:space-between;gap:12px;align-items:center"><h2 style="margin:0">Announcement History</h2><a class="btn small" href="/admin">Back to Dashboard</a></div>
      <% announcements.forEach(item=>{ %>
        <div class="adminRow" style="display:flex;justify-content:space-between;gap:12px;align-items:center">
          <div><strong><%=item.title%></strong><div class="muted"><%=item.body||'No additional message'%></div><div class="muted"><%=item.active?'Active':'Inactive'%> · <%=item.created_at%></div></div>
          <div style="display:flex;gap:8px;flex-wrap:wrap"><form method="post" action="/admin/announcements/<%=item.id%>/toggle"><button class="btn small"><%=item.active?'Deactivate':'Activate'%></button></form><form method="post" action="/admin/announcements/<%=item.id%>/delete" onsubmit="return confirm('Delete this announcement?')"><button class="btn small">Delete</button></form></div>
        </div>
      <% }) %>
      <% if(!announcements.length){ %><p class="muted">No announcements yet.</p><% } %>
    </div>
    <div class="paperCard">
      <h2>New Announcement</h2>
      <form method="post" action="/admin/announcements">
        <label>Title</label><input name="title" required>
        <label>Message</label><textarea name="body"></textarea>
        <label style="display:flex;gap:8px;align-items:center"><input style="width:auto" type="checkbox" name="active" checked> Active immediately</label>
        <button class="btn primary">Create Announcement</button>
      </form>
      <p class="muted">The newest active announcement is displayed site-wide. A maintenance message takes priority while maintenance text is set in Site Settings.</p>
    </div>
  </div>
</main>
<%- include("partials/footer") %>
