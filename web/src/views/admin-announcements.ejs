<%- include("partials/header",{title:"CMS Announcements"}) %>
<main class="lightPage">
  <section class="lightTitle"><div class="wrap"><div class="pageEyebrow">CMS://BROADCAST</div><h1>ANNOUNCEMENTS.</h1><p>Control the site-wide message stream seen across the public EverLeaf terminal.</p></div></section>
  <%- include("partials/admin-manager-nav") %>
  <div class="cmsWorkspace">
    <section class="cmsPanel">
      <div class="cmsManagerTitle"><h2>BROADCAST HISTORY</h2><p><%=announcements.length%> record<%=announcements.length===1?'':'s'%>.</p></div>
      <% announcements.forEach(item=>{ %><div class="cmsItem"><div><span class="pageEyebrow"><%=item.active?'ACTIVE':'INACTIVE'%> // <%=item.created_at%></span><strong><%=item.title%></strong><div class="cmsMeta"><%=item.body||'No additional message'%></div></div><div class="cmsItemActions"><form method="post" action="/admin/announcements/<%=item.id%>/toggle"><button class="btn small"><%=item.active?'DEACTIVATE':'ACTIVATE'%></button></form><form method="post" action="/admin/announcements/<%=item.id%>/delete" onsubmit="return confirm('Delete this announcement?')"><button class="btn small">DELETE</button></form></div></div><% }) %>
      <% if(!announcements.length){ %><p class="muted">NO BROADCAST RECORDS.</p><% } %>
    </section>
    <aside class="cmsPanel"><div class="cmsManagerTitle"><h2>NEW BROADCAST</h2><p>The newest active announcement appears site-wide unless maintenance takes priority.</p></div><form class="cmsFormSection" method="post" action="/admin/announcements"><label>Title</label><input name="title" required><label>Message</label><textarea name="body" style="min-height:220px"></textarea><label><input style="width:auto;min-height:auto;margin-right:8px" type="checkbox" name="active" checked> Activate immediately</label><button class="btn primary">CREATE BROADCAST</button></form></aside>
  </div>
</main>
<%- include("partials/footer") %>
