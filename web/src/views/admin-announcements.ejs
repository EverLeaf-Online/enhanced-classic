<%- include("partials/header",{title:"CMS Announcements"}) %><main class="lightPage"><section class="lightTitle"><div class="wrap"><div class="pageEyebrow">CMS Workspace</div><h1>Announcements</h1><p>Control the site-wide message seen by players across the public website.</p></div></section><%- include("partials/admin-manager-nav") %><div class="cmsWorkspace"><section class="cmsPanel"><div class="cmsManagerTitle"><h2>Announcement History</h2><p><%=announcements.length%> announcement<%=announcements.length===1?'':'s'%>.</p></div><% announcements.forEach(item=>{ %><div class="cmsItem"><div><strong><%=item.title%></strong><div class="cmsMeta"><%=item.body||'No additional message'%></div><div class="cmsMeta"><span class="cmsStatusPill"><%=item.active?'Active':'Inactive'%></span> · <%=item.created_at%></div></div><div class="cmsItemActions"><form method="post" action="/admin/announcements/<%=item.id%>/toggle"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>"><button class="btn small"><%=item.active?'Deactivate':'Activate'%></button></form><form method="post" action="/admin/announcements/<%=item.id%>/delete" onsubmit="return confirm('Delete this announcement?')"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>"><button class="btn small">Delete</button></form></div></div><% }) %><% if(!announcements.length){ %><p class="muted">No announcements yet.</p><% } %></section><aside class="cmsPanel"><div class="cmsManagerTitle"><h2>New Announcement</h2><p>The newest active announcement appears site-wide unless a maintenance message is set.</p></div><form class="cmsFormSection" method="post" action="/admin/announcements"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>"><label>Title</label><input name="title" required><label>Message</label><textarea name="body" style="min-height:180px"></textarea><label style="display:flex;gap:8px;align-items:center"><input style="width:auto" type="checkbox" name="active" checked> Active immediately</label><button class="btn primary">CREATE ANNOUNCEMENT</button></form></aside></div></main><%- include("partials/footer") %>
