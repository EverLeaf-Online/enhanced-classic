<%- include("partials/header",{title:"CMS Downloads"}) %><main class="lightPage"><section class="lightTitle"><div class="wrap"><div class="pageEyebrow">CMS Workspace</div><h1>Downloads & Launcher</h1><p>Manage player-facing launcher, patch, client, and tool downloads.</p></div></section><%- include("partials/admin-manager-nav") %><div class="cmsWorkspace"><section class="cmsPanel"><div class="cmsManagerTitle"><h2>Download Library</h2><p><%=downloads.length%> managed entr<%=downloads.length===1?'y':'ies'%>.</p></div><% downloads.forEach(item=>{ %><div class="cmsItem"><div><strong><%=item.name%></strong><div class="cmsMeta"><%=item.kind%><%=item.version?` · v${item.version}`:''%> · <%=item.published?'Published':'Draft'%></div><div class="cmsMeta"><%=item.url%></div></div><div class="cmsItemActions"><a class="btn small" href="/admin/downloads/<%=item.id%>/edit">Edit</a><form method="post" action="/admin/downloads/<%=item.id%>/delete" onsubmit="return confirm('Delete this download entry?')"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>"><button class="btn small">Delete</button></form></div></div><% }) %><% if(!downloads.length){ %><p class="muted">No download entries exist yet.</p><% } %></section><aside class="cmsPanel"><div class="cmsManagerTitle"><h2>Add Download</h2><p>Publish a new launcher build, patch, client, or utility.</p></div><form class="cmsFormSection" method="post" action="/admin/downloads"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>"><label>Name</label><input name="name" required><label>Description</label><textarea name="description"></textarea><label>Download URL</label><input name="url" required><label>Kind</label><select name="kind"><option>launcher</option><option>client</option><option>patch</option><option>tool</option></select><label>Version</label><input name="version"><label style="display:flex;gap:8px;align-items:center"><input style="width:auto" type="checkbox" name="published" checked> Published</label><button class="btn primary">ADD DOWNLOAD</button></form></aside></div></main><%- include("partials/footer") %>
