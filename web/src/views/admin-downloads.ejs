<%- include("partials/header",{title:"CMS Downloads"}) %>
<main class="lightPage">
  <section class="lightTitle"><div class="wrap"><div class="pageEyebrow">CMS://CLIENT MANIFEST</div><h1>CLIENT FILES.</h1><p>Manage player-facing launcher, patch, client, and utility records.</p></div></section>
  <%- include("partials/admin-manager-nav") %>
  <div class="cmsWorkspace">
    <section class="cmsPanel">
      <div class="cmsManagerTitle"><h2>MANIFEST LEDGER</h2><p><%=downloads.length%> managed entr<%=downloads.length===1?'y':'ies'%>.</p></div>
      <% downloads.forEach(item=>{ %><div class="cmsItem"><div><span class="pageEyebrow"><%=String(item.kind||'file').toUpperCase()%> // <%=item.published?'PUBLISHED':'DRAFT'%></span><strong><%=item.name%></strong><div class="cmsMeta"><%=item.version?`VERSION ${item.version} // `:''%><%=item.url%></div></div><div class="cmsItemActions"><a class="btn small" href="/admin/downloads/<%=item.id%>/edit">EDIT</a><form method="post" action="/admin/downloads/<%=item.id%>/delete" onsubmit="return confirm('Delete this download entry?')"><button class="btn small">DELETE</button></form></div></div><% }) %>
      <% if(!downloads.length){ %><p class="muted">NO MANAGED FILE ENTRIES.</p><% } %>
    </section>
    <aside class="cmsPanel"><div class="cmsManagerTitle"><h2>ADD MANIFEST ENTRY</h2><p>Publish a new launcher build, patch, client, or utility.</p></div><form class="cmsFormSection" method="post" action="/admin/downloads"><label>Name</label><input name="name" required><label>Description</label><textarea name="description"></textarea><label>Download URL</label><input name="url" required><label>Kind</label><select name="kind"><option>launcher</option><option>client</option><option>patch</option><option>tool</option></select><label>Version</label><input name="version"><label><input style="width:auto;min-height:auto;margin-right:8px" type="checkbox" name="published" checked> Published</label><button class="btn primary">ADD ENTRY</button></form></aside>
  </div>
</main>
<%- include("partials/footer") %>
