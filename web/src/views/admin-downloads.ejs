<%- include("partials/header",{title:"CMS Downloads"}) %>
<main class="lightPage">
  <div class="lightTitle"><div class="wrap"><h1>Downloads & Launcher</h1><p>Manage public download entries without editing the database directly.</p></div></div>
  <div class="wrap" style="max-width:1050px;display:grid;grid-template-columns:minmax(0,1.4fr) minmax(300px,.8fr);gap:18px;align-items:start">
    <div class="paperCard">
      <div style="display:flex;justify-content:space-between;gap:12px;align-items:center"><h2 style="margin:0">Published Entries</h2><a class="btn small" href="/admin">Back to Dashboard</a></div>
      <% downloads.forEach(item=>{ %>
        <div class="adminRow" style="display:flex;justify-content:space-between;gap:12px;align-items:center">
          <div><strong><%=item.name%></strong><div class="muted"><%=item.kind%><%=item.version?` · v${item.version}`:''%> · <%=item.published?'Published':'Draft'%></div><div class="muted"><%=item.url%></div></div>
          <div style="display:flex;gap:8px;flex-wrap:wrap"><a class="btn small" href="/admin/downloads/<%=item.id%>/edit">Edit</a><form method="post" action="/admin/downloads/<%=item.id%>/delete" onsubmit="return confirm('Delete this download entry?')"><button class="btn small">Delete</button></form></div>
        </div>
      <% }) %>
      <% if(!downloads.length){ %><p class="muted">No download entries exist yet.</p><% } %>
    </div>
    <div class="paperCard">
      <h2>Add Download</h2>
      <form method="post" action="/admin/downloads">
        <label>Name</label><input name="name" required>
        <label>Description</label><textarea name="description"></textarea>
        <label>Download URL</label><input name="url" required>
        <label>Kind</label><select name="kind"><option>launcher</option><option>client</option><option>patch</option><option>tool</option></select>
        <label>Version</label><input name="version">
        <label style="display:flex;gap:8px;align-items:center"><input style="width:auto" type="checkbox" name="published" checked> Published</label>
        <button class="btn primary">Add Download</button>
      </form>
    </div>
  </div>
</main>
<%- include("partials/footer") %>
