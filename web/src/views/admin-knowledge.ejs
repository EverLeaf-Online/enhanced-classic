<%- include("partials/header",{title:"CMS Game Database"}) %>
<main class="lightPage adminKnowledgePage">
<section class="lightTitle"><div class="wrap"><div class="pageEyebrow">CMS Workspace</div><h1>Game Database & Knowledge</h1><p>Manage the real public EverLeaf Wiki. Articles are stored in the CMS database, searchable by players, and editable here without a code deployment.</p></div></section>
<%- include("partials/admin-manager-nav") %>
<div class="cmsWorkspace knowledgeWorkspace">
<section class="cmsPanel knowledgeMain">
  <div class="cmsManagerTitle"><div><h2>Knowledge Library</h2><p><%=results.length%> of <%=entries.length%> articles shown · <%=stats.published%> published · <%=stats.drafts%> draft<%=stats.drafts===1?'':'s'%>.</p></div><div class="knowledgeActions"><a class="btn small" href="/wiki" target="_blank" rel="noopener">Open Public Wiki ↗</a><a class="btn small primary" href="/admin/knowledge/new">+ NEW ARTICLE</a></div></div>
  <% if(saved){ %><div class="success knowledgeSaved">Wiki article saved successfully.</div><% } %>
  <div class="knowledgeSummary"><div><small>Total articles</small><strong><%=stats.total%></strong></div><div><small>Published</small><strong><%=stats.published%></strong></div><div><small>Drafts</small><strong><%=stats.drafts%></strong></div><div><small>Verification coverage</small><strong><%=entries.length?Math.round((verifiedCount/entries.length)*100):0%>%</strong></div></div>
  <form class="knowledgeFilters" method="get" action="/admin/knowledge"><input type="search" name="q" value="<%=q%>" placeholder="Search systems, jobs, NX, launcher…"><select name="category"><option value="all">All categories</option><% categories.forEach(cat=>{ %><option value="<%=cat.key%>" <%=category===cat.key?'selected':''%>><%=cat.label%></option><% }) %></select><button class="btn primary">FILTER</button><% if(q||category!=='all'){ %><a class="btn" href="/admin/knowledge">CLEAR</a><% } %></form>
  <div class="knowledgeTableWrap"><table class="knowledgeTable"><thead><tr><th>Article</th><th>Category</th><th>Publication</th><th>Source / verification</th><th></th></tr></thead><tbody><% results.forEach(entry=>{ %><tr><td><strong><%=entry.title%></strong><small><%=entry.summary%></small><small class="knowledgeUpdated">Updated <%=entry.updatedAt?new Date(entry.updatedAt+'Z').toLocaleString():''%></small></td><td><%=categories.find(c=>c.key===entry.category)?.label||entry.category%></td><td><span class="knowledgeStatus <%=entry.published?'published':'draft'%>"><%=entry.published?'Published':'Draft'%></span><small><%=entry.status%></small></td><td><small class="knowledgeSource"><b><%=entry.sourceDoc||entry.source%></b><span><%=entry.verification||'Unverified'%></span></small></td><td><div class="knowledgeRowActions"><a class="btn small primary" href="/admin/knowledge/<%=entry.id%>/edit">Edit</a><% if(entry.published){ %><a class="btn small" href="/wiki/<%=entry.slug%>" target="_blank" rel="noopener">View</a><% } %></div></td></tr><% }) %></tbody></table><% if(!results.length){ %><div class="knowledgeEmpty">No entries match these filters.</div><% } %></div>
</section>
<aside class="cmsPanel knowledgeCoverage">
  <div class="cmsManagerTitle"><h2>Coverage</h2><p>Current CMS-backed Wiki coverage.</p></div>
  <div class="coverageList"><% coverage.forEach(cat=>{ %><a href="/admin/knowledge?category=<%=cat.key%>"><span><strong><%=cat.label%></strong><small><%=cat.description%></small></span><b><%=cat.count%></b></a><% }) %></div>
  <div class="knowledgeSourceCoverage"><div class="pageEyebrow">SOURCE COVERAGE</div><h3>EverLeaf sources</h3><% sources.slice(0,12).forEach(source=>{ %><div><span><%=source.doc%></span><b><%=source.count%></b></div><% }) %></div>
  <div class="knowledgeRoadmap"><div class="pageEyebrow">WIKI WORKFLOW</div><h3>Publish without code changes</h3><ul><li>Create or edit an article in this CMS</li><li>Keep it as a draft while staff verifies it</li><li>Publish when the information is player-ready</li><li>Search and category pages update immediately</li></ul><p>The initial research catalog is only a seed. After import, the CMS database is the public Wiki's source of truth.</p></div>
</aside>
</div>
</main>
<%- include("partials/footer") %>