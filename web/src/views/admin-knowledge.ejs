<%- include("partials/header",{title:"CMS Game Database"}) %>
<main class="lightPage adminKnowledgePage">
  <section class="lightTitle"><div class="wrap"><div class="pageEyebrow">CMS://GAME DATABASE</div><h1>KNOWLEDGE<br>INDEX.</h1><p>Manage the public EverLeaf Wiki and supplemental staff-authored guides without a code deployment.</p></div></section>
  <%- include("partials/admin-manager-nav") %>

  <div class="cmsWorkspace knowledgeWorkspace">
    <section class="cmsPanel knowledgeMain">
      <div class="cmsManagerTitle"><div><h2>ARTICLE LEDGER</h2><p><%=results.length%>/<%=entries.length%> shown // <%=stats.published%> published // <%=stats.drafts%> draft<%=stats.drafts===1?'':'s'%>.</p></div><div class="knowledgeActions"><a class="btn small" href="/wiki" target="_blank" rel="noopener">PUBLIC DATA ↗</a><a class="btn small primary" href="/admin/knowledge/new">NEW ARTICLE</a></div></div>
      <% if(saved){ %><div class="notice knowledgeSaved">ARTICLE SAVED.</div><% } %>

      <div class="stats knowledgeSummary">
        <div class="stat"><div class="statNum"><%=stats.total%></div><div>TOTAL ARTICLES</div></div>
        <div class="stat"><div class="statNum"><%=stats.published%></div><div>PUBLISHED</div></div>
        <div class="stat"><div class="statNum"><%=stats.drafts%></div><div>DRAFTS</div></div>
        <div class="stat"><div class="statNum"><%=entries.length?Math.round((verifiedCount/entries.length)*100):0%>%</div><div>VERIFIED</div></div>
      </div>

      <form class="knowledgeFilters rankingSearch" method="get" action="/admin/knowledge">
        <input type="search" name="q" value="<%=q%>" placeholder="Search systems, jobs, NX, launcher…">
        <select name="category"><option value="all">ALL CATEGORIES</option><% categories.forEach(cat=>{ %><option value="<%=cat.key%>" <%=category===cat.key?'selected':''%>><%=cat.label%></option><% }) %></select>
        <button class="btn primary">FILTER</button><% if(q||category!=='all'){ %><a class="btn" href="/admin/knowledge">CLEAR</a><% } %>
      </form>

      <div class="knowledgeTableWrap tableWrap"><table class="knowledgeTable"><thead><tr><th>ARTICLE</th><th>CATEGORY</th><th>STATE</th><th>SOURCE / VERIFICATION</th><th>ACTION</th></tr></thead><tbody>
        <% results.forEach(entry=>{ %><tr><td><strong><%=entry.title%></strong><small><%=entry.summary%></small><small class="knowledgeUpdated">UPDATED <%=entry.updatedAt?new Date(entry.updatedAt+'Z').toLocaleString():''%></small></td><td><%=categories.find(c=>c.key===entry.category)?.label||entry.category%></td><td><span class="knowledgeStatus <%=entry.published?'published':'draft'%>"><%=entry.published?'PUBLISHED':'DRAFT'%></span><small><%=entry.status%></small></td><td><small class="knowledgeSource"><b><%=entry.sourceDoc||entry.source%></b><span><%=entry.verification||'Unverified'%></span></small></td><td><div class="knowledgeRowActions"><a class="btn small primary" href="/admin/knowledge/<%=entry.id%>/edit">EDIT</a><% if(entry.published){ %><a class="btn small" href="/wiki/<%=entry.slug%>" target="_blank" rel="noopener">VIEW</a><% } %></div></td></tr><% }) %>
      </tbody></table><% if(!results.length){ %><div class="knowledgeEmpty">NO ENTRIES MATCH THIS QUERY.</div><% } %></div>
    </section>

    <aside class="cmsPanel knowledgeCoverage">
      <div class="cmsManagerTitle"><h2>COVERAGE</h2><p>Current CMS-backed guide coverage.</p></div>
      <div class="coverageList"><% coverage.forEach(cat=>{ %><a href="/admin/knowledge?category=<%=cat.key%>"><span><strong><%=cat.label%></strong><small><%=cat.description%></small></span><b><%=cat.count%></b></a><% }) %></div>
      <div class="knowledgeSourceCoverage"><div class="pageEyebrow">SOURCE://COVERAGE</div><h3>EVERLEAF SOURCES</h3><% sources.slice(0,12).forEach(source=>{ %><div><span><%=source.doc%></span><b><%=source.count%></b></div><% }) %></div>
      <div class="knowledgeRoadmap"><div class="pageEyebrow">WORKFLOW://PUBLISH</div><h3>NO DEPLOY REQUIRED.</h3><ol><li>Create or edit an article.</li><li>Keep it draft during staff verification.</li><li>Publish when player-ready.</li><li>Search/category pages update immediately.</li></ol><p>The preserved CMS database remains the source of truth for supplemental guides.</p></div>
    </aside>
  </div>
</main>
<%- include("partials/footer") %>
