<%- include("partials/header",{title:"Edit Download"}) %>
<main class="lightPage">
  <section class="lightTitle"><div class="wrap"><div class="pageEyebrow">CMS://MANIFEST EDITOR</div><h1>EDIT FILE.</h1><p><%=item.name%></p></div></section>
  <%- include("partials/admin-manager-nav") %>
  <div class="cmsWorkspaceSingle">
    <section class="cmsPanel" style="max-width:1000px">
      <div class="cmsManagerTitle"><h2>FILE METADATA</h2><p>Update player-facing manifest information and publication state.</p></div>
      <form method="post" action="/admin/downloads/<%=item.id%>/edit">
        <div class="editGrid2"><div><label>Name</label><input name="name" value="<%=item.name%>" required></div><div><label>Version</label><input name="version" value="<%=item.version%>"></div></div>
        <label>Description</label><textarea name="description"><%=item.description%></textarea>
        <label>Download URL</label><input name="url" value="<%=item.url%>" required>
        <label>Kind</label><select name="kind"><% ['launcher','client','patch','tool'].forEach(kind=>{ %><option value="<%=kind%>" <%=item.kind===kind?'selected':''%>><%=kind%></option><% }) %></select>
        <label><input style="width:auto;min-height:auto;margin-right:8px" type="checkbox" name="published" value="1" <%=item.published?'checked':''%>> Published</label>
        <div class="editActions"><a class="btn" href="/admin/downloads">CANCEL</a><button class="btn primary">SAVE FILE</button></div>
      </form>
    </section>
  </div>
</main>
<%- include("partials/footer") %>
