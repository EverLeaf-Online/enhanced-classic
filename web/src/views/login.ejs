<%- include("partials/header",{title:"Login"}) %><main class="authWrap"><div class="authGrid"><section class="authIntro"><img src="/assets/everleaf-logo.webp" alt="EverLeaf"><h1>Welcome back.</h1><p>Your EverLeaf website account is your game account. Sign in to manage your characters, vote rewards, Discord link, and account security.</p><div class="miniGrid" style="margin-top:18px"><div class="miniCard"><strong>20</strong><span>Live channels</span></div><div class="miniCard"><strong>v83</strong><span>Enhanced Classic</span></div><div class="miniCard"><strong>No P2W</strong><span>Community focused</span></div></div></section><div class="authCard"><div class="pageEyebrow">Account Portal</div><h2>Sign in to EverLeaf</h2><p class="muted">Use the same credentials you use in game.</p><% if(error){%><div class="error"><%=error%></div><%}%><form method="post"><label>Username</label><input name="username" autocomplete="username" required><label>Password</label><input type="password" name="password" autocomplete="current-password" required><button class="btn primary">SIGN IN</button></form><p class="muted" style="margin-top:14px"><a href="/recover" style="color:#2f9b43;font-weight:800">Forgot your username or password?</a></p><hr style="border:0;border-top:1px solid #ddd8ca;margin:24px 0"><h3>New to EverLeaf?</h3><form method="post" action="/register"><label>Username</label><input name="username" minlength="4" maxlength="13" pattern="[A-Za-z0-9_]+" autocomplete="username" required><label>Email</label><input type="email" name="email" autocomplete="email" required><label>Password</label><input type="password" name="password" minlength="8" maxlength="12" autocomplete="new-password" aria-describedby="login-register-password-help" required><p id="login-register-password-help" class="muted">Use 8-12 characters for v83 game-client compatibility.</p><label>Confirm Password</label><input type="password" name="confirmPassword" minlength="8" maxlength="12" autocomplete="new-password" required><label style="display:flex;gap:8px;align-items:flex-start;font-size:12px"><input type="checkbox" name="agree" value="yes" style="width:auto;margin-top:2px" required><span>I agree to the <a href="/terms" style="color:#2f9b43;font-weight:800">Terms of Service</a>.</span></label><button class="btn primary">CREATE ACCOUNT</button></form></div></div></main><%- include("partials/footer") %>
