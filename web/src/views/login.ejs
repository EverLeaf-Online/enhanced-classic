<%- include("partials/header",{title:"Login",description:"Sign in to your EverLeaf Enhanced Classic account."}) %>
<main class="authWrap">
  <div class="authGrid loginFocusGrid">
    <div class="authCard">
      <div class="loginBrandMark"><img src="/assets/everleaf-remaster.svg" alt="EverLeaf"></div>
      <div class="loginHeading">
        <h1>WELCOME <span>BACK</span></h1>
        <p>Sign in to your EverLeaf account.</p>
      </div>

      <% if(error){ %><div class="error"><%=error%></div><% } %>

      <form method="post"><input type="hidden" name="_csrf" value="<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>">
        <label for="login-username">Username</label>
        <input id="login-username" name="username" autocomplete="username" placeholder="Enter your username" required autofocus>

        <label for="login-password">Password</label>
        <div class="passwordField">
          <input id="login-password" type="password" name="password" autocomplete="current-password" placeholder="Enter your password" required>
          <button class="passwordToggle" type="button" data-password-toggle="login-password" aria-label="Show password" aria-pressed="false">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/></svg>
          </button>
        </div>

        <div class="loginUtilityRow"><a href="/recover">Forgot password?</a></div>
        <button class="btn primary" type="submit">SIGN IN</button>
      </form>

      <p class="loginCreateRow">Don't have an account? <a href="/register">Create one</a></p>
      <div class="loginBackHome"><a href="/">← Back to Home</a></div>
    </div>
  </div>
</main>
<%- include("partials/footer") %>
