<%- include("partials/header",{title:"Login"}) %>
<main class="terminalAuthPage authWrap">
  <section class="terminalAuthIdentity authIntro">
    <div><div class="pageEyebrow">SESSION://AUTHENTICATION</div><h1>WELCOME<br>BACK.</h1><p>Your EverLeaf website account is your game account. Sign in to manage characters, vote rewards, Discord linking, and account security.</p></div>
    <div class="terminalAuthTelemetry miniGrid"><div><small>CHANNELS</small><strong>20</strong></div><div><small>CLIENT</small><strong>V83</strong></div><div><small>MODEL</small><strong>FAIR</strong></div></div>
  </section>

  <section class="terminalAuthForm authCard">
    <div class="pageEyebrow">ACCOUNT://LOGIN</div>
    <h2>Sign in to EverLeaf</h2>
    <p class="muted">Use the same credentials you use in game.</p>
    <% if(error){ %><div class="error"><%=error%></div><% } %>
    <form method="post">
      <label>Username</label><input name="username" autocomplete="username" required>
      <label>Password</label><input type="password" name="password" autocomplete="current-password" required>
      <button class="btn primary">START SESSION</button>
    </form>
    <p class="muted"><a href="/recover">Forgot your username or password?</a></p>

    <div class="terminalAuthDivider">
      <div class="pageEyebrow">NEW SESSION / ACCOUNT CREATE</div>
      <h3>Create EverLeaf account</h3>
      <form method="post" action="/register">
        <label>Username</label><input name="username" minlength="4" maxlength="13" pattern="[A-Za-z0-9_]+" autocomplete="username" required>
        <label>Email</label><input type="email" name="email" autocomplete="email" required>
        <label>Password</label><input type="password" name="password" minlength="8" maxlength="12" autocomplete="new-password" aria-describedby="login-register-password-help" required><p id="login-register-password-help" class="muted">8–12 characters for v83 client compatibility.</p>
        <label>Confirm Password</label><input type="password" name="confirmPassword" minlength="8" maxlength="12" autocomplete="new-password" required>
        <label><input type="checkbox" name="agree" value="yes" style="width:auto;min-height:auto;margin-right:8px" required> I agree to the <a href="/terms">Terms of Service</a>.</label>
        <button class="btn">CREATE ACCOUNT</button>
      </form>
    </div>
  </section>
</main>
<%- include("partials/footer") %>
