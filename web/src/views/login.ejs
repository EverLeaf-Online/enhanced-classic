<%- include("partials/header",{title:"Login",description:"Sign in to your EverLeaf game and website account."}) %>
<main class="authWrap">
  <div class="authStandalone">
    <section class="authCard authCardLogin" aria-labelledby="login-title">
      <a class="authBrandMark" href="/" aria-label="EverLeaf home">
        <img src="/assets/everleaf-remaster.svg" alt="" aria-hidden="true">
        <span>EverLeaf Enhanced Classic</span>
      </a>

      <h1 id="login-title">Welcome <span>Back</span></h1>
      <p class="authLead">Sign in to your EverLeaf account.</p>

      <% if(error){ %><div class="error" role="alert"><%=error%></div><% } %>

      <form method="post" action="/login">
        <label for="login-username">Username</label>
        <input id="login-username" name="username" autocomplete="username" placeholder="Enter your username" required autofocus>

        <label for="login-password">Password</label>
        <div class="passwordField">
          <input id="login-password" type="password" name="password" autocomplete="current-password" placeholder="Enter your password" required>
          <button class="passwordToggle" type="button" data-password-toggle="login-password" aria-label="Show password" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.8 12s3.3-5.2 9.2-5.2S21.2 12 21.2 12 17.9 17.2 12 17.2 2.8 12 2.8 12Z"/><circle cx="12" cy="12" r="2.6"/></svg>
          </button>
        </div>

        <div class="authForgot"><a href="/recover">Forgot username or password?</a></div>
        <button class="btn primary authSubmit" type="submit">Sign In</button>
      </form>

      <p class="authSecondary">Don't have an account? <a href="/register">Create one</a></p>
      <div class="authTrust"><span>One account</span><span>Website + game</span><span>v83 compatible</span></div>
    </section>
    <div class="authBack"><a href="/">← <span>Back to Home</span></a></div>
  </div>
</main>
<%- include("partials/footer") %>
