[Unit]
Description=Back up EverLeaf production databases and configuration
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
WorkingDirectory=/opt/everleaf/web
ExecStart=/usr/bin/bash /opt/everleaf/web/scripts/backup-production.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

