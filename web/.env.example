NODE_ENV=production
PORT=3000
BASE_URL=https://everleafms.online
PUBLIC_BASE_URL=https://everleafms.online
SESSION_SECRET=replace-with-a-long-random-secret
TRUST_PROXY=1
COOKIE_SECURE=true
DISCORD_REDIRECT_URI=https://everleafms.online/account/discord/callback

SERVER_NAME=EverLeaf
SERVER_TAGLINE=Enhanced Classic MapleStory
SERVER_VERSION=v83
DISCORD_URL=https://discord.gg/w9ED8vtxa7
DONATION_URL=
LAUNCHER_DOWNLOAD_URL=
FULL_CLIENT_DOWNLOAD_URL=

GAME_HOST=127.0.0.1
LOGIN_PORT=8484
CHANNEL_PORTS=7575,7576,7577,7578,7579,7580,7581,7582,7583,7584,7585,7586,7587,7588,7589,7590,7591,7592,7593,7594

GAME_DB_HOST=127.0.0.1
GAME_DB_PORT=3306
GAME_DB_USER=everleaf_web
GAME_DB_PASSWORD=replace-me
GAME_DB_NAME=cosmic

GAME_ACCOUNTS_TABLE=accounts
GAME_CHARACTERS_TABLE=characters
GAME_ACCOUNT_ID_COLUMN=id
GAME_ACCOUNT_NAME_COLUMN=name
GAME_ACCOUNT_PASSWORD_COLUMN=password
GAME_ACCOUNT_EMAIL_COLUMN=email
GAME_ACCOUNT_BANNED_COLUMN=banned
GAME_ACCOUNT_LOGGEDIN_COLUMN=loggedin
GAME_CHARACTER_ACCOUNT_ID_COLUMN=accountid
GAME_CHARACTER_NAME_COLUMN=name
GAME_CHARACTER_LEVEL_COLUMN=level
GAME_CHARACTER_JOB_COLUMN=job
GAME_CHARACTER_FAME_COLUMN=fame
GAME_CHARACTER_GM_COLUMN=gm
GAME_CHARACTER_EXP_COLUMN=exp

# Verified GTOP100 votes queue account-wide NX once per account per UTC day.
GTOP100_VOTE_URL=https://gtop100.com/MapleStory/server-106444?vote=1
GTOP100_PINGBACK_KEY=replace-with-the-key-from-gtop100
VOTE_NX_REWARD=1500

# EverLeaf web registration is compatible with the current enhanced-classic accounts schema.
GAME_REGISTRATION_ENABLED=true
GAME_PASSWORD_MODE=bcrypt

CMS_DB_PATH=./data/everleaf-cms.sqlite

# Payments fail closed unless explicitly enabled and all provider secrets exist.
PAYMENT_CURRENCY=usd
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_ENABLED=false
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
