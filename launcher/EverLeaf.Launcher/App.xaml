<Application x:Class="EverLeaf.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="EverLeafGreen" Color="#72E29B"/>
    <SolidColorBrush x:Key="EverLeafDark" Color="#111A18"/>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="18,10"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Background" Value="#182421"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#334B44"/>
      <Setter Property="CaretBrush" Value="White"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Background" Value="#182421"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#334B44"/>
      <Setter Property="CaretBrush" Value="White"/>
    </Style>
  </Application.Resources>
</Application>
