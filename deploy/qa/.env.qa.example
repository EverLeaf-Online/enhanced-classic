# Copy to deploy/qa/.env.qa on the staging host. Never commit the real file.
EVERLEAF_QA_DB_ROOT_PASSWORD=replace-with-a-long-random-value
EVERLEAF_QA_LOGIN_PORT=18484
EVERLEAF_QA_CHANNEL_START=17575
EVERLEAF_QA_DB_PORT=13307

# Runtime tester safety gates.
EVERLEAF_QA_ACCOUNT_PREFIX=qa_
# Do NOT store the arming token here permanently. Export it only for an authorized run:
# EVERLEAF_QA_RUNTIME=I_UNDERSTAND_STAGING_ONLY
